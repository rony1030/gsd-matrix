<%- include('partials/header', { title: 'Propiedades — GSD Inmobiliaria', page: page }) %>
<div style="padding-top: 76px;"></div>
<section style="background: var(--gris-100); padding: 5rem 2rem 4rem; border-bottom: 1px solid var(--gris-200);">
  <div style="max-width: 1280px; margin: 0 auto;">
    <span class="eyebrow reveal">GSD Inmobiliaria</span>
    <h1 style="font-size: clamp(2.5rem, 5vw, 3.5rem); margin-top: 0.75rem; color: var(--azul);" class="reveal delay-1">Propiedades Disponibles</h1>
    <p style="color: var(--gris-500); font-size: 1.05rem; margin-top: 1rem;" class="reveal delay-2">Encuentra tu próxima inversión en República Dominicana.</p>
  </div>
</section>
<section style="padding: 5rem 2rem; background: var(--blanco);">
  <div style="max-width: 1280px; margin: 0 auto;">
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:2rem;">
      <% propiedades.forEach((p, i) => { %>
        <% let imgs = []; try { imgs = JSON.parse(p.imagenes || '[]'); } catch(e) {} %>
      <article style="background:var(--blanco);border:1px solid var(--gris-200);border-radius:16px;overflow:hidden;box-shadow:var(--sombra);transition:var(--transicion);" class="reveal"
               onmouseover="this.style.boxShadow='var(--sombra-hover)';this.style.transform='translateY(-4px)'"
               onmouseout="this.style.boxShadow='var(--sombra)';this.style.transform=''">
        <div style="aspect-ratio:4/3;overflow:hidden;background:var(--gris-200);position:relative;">
          <% if (imgs.length > 0) { %>
          <img src="<%= imgs[0] %>" alt="<%= p.titulo %>" style="width:100%;height:100%;object-fit:cover;">
          <% } else { %>
          <div style="display:flex;align-items:center;justify-content:center;height:100%;font-size:3rem;">🏠</div>
          <% } %>
          <% if (p.destacada) { %>
          <span style="position:absolute;top:1rem;left:1rem;background:var(--verde);color:white;font-size:0.7rem;font-weight:700;padding:0.3rem 0.7rem;border-radius:50px;">⭐ Destacada</span>
          <% } %>
        </div>
        <div style="padding:1.5rem;">
          <span style="font-size:0.75rem;color:var(--gris-500);text-transform:uppercase;font-weight:600;"><%= p.tipo || '' %><% if(p.ubicacion){ %> · <%= p.ubicacion %><% } %></span>
          <h3 style="font-size:1.1rem;margin:0.5rem 0 0.75rem;color:var(--azul);font-family:'Playfair Display',serif;"><%= p.titulo %></h3>
          <% if(p.precio) { %>
          <p style="font-size:1.5rem;font-weight:700;color:var(--azul);margin-bottom:0.75rem;">
            <%= p.moneda === 'USD' ? '$' : 'RD$' %><%= Number(p.precio).toLocaleString() %>
          </p>
          <% } %>
          <p style="color:var(--gris-500);font-size:0.875rem;line-height:1.6;margin-bottom:1rem;"><%= p.descripcion?.substring(0,120) %>...</p>
          <a href="/#contacto" class="btn-primary" style="display:inline-flex;align-items:center;gap:0.4rem;font-size:0.875rem;padding:0.65rem 1.25rem;">
            Consultar →
          </a>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
