<%- include('partials/header', { title: 'Nosotros — GSD Geosolutions Source Dominicana', page: page }) %>

<div style="padding-top: 76px;"></div>

<!-- Page Hero -->
<section style="background: var(--gris-100); padding: 5rem 2rem 4rem; border-bottom: 1px solid var(--gris-200);">
  <div style="max-width: 1280px; margin: 0 auto;">
    <span class="eyebrow reveal">Nuestra Historia</span>
    <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); margin-top: 0.75rem; color: var(--azul); max-width: 700px;" class="reveal delay-1">
      Más de 15 años al servicio de República Dominicana
    </h1>
    <p style="color: var(--gris-500); font-size: 1.1rem; max-width: 600px; margin-top: 1.25rem;" class="reveal delay-2">
      Somos un grupo empresarial multidisciplinario comprometido con la excelencia en asesoría legal, inmobiliaria y técnica.
    </p>
  </div>
</section>

<!-- Historia -->
<section style="padding: 6rem 2rem; background: var(--blanco);">
  <div style="max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center;">
    <div class="reveal-left">
      <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=800&q=80"
           alt="Oficinas GSD" style="width:100%; border-radius: 16px; object-fit: cover; aspect-ratio: 4/3;">
    </div>
    <div>
      <span class="eyebrow reveal">Quiénes somos</span>
      <h2 style="font-size: 2rem; margin: 0.75rem 0 1.5rem;" class="reveal delay-1">Un equipo unido por la excelencia</h2>
      <p style="color: var(--gris-500); line-height: 1.8; margin-bottom: 1rem;" class="reveal delay-2">
        GSD — Geosolutions Source Dominicana nació de la visión de crear un grupo empresarial capaz de brindar servicios integrales a quienes desean invertir o desarrollar proyectos en República Dominicana.
      </p>
      <p style="color: var(--gris-500); line-height: 1.8;" class="reveal delay-3">
        Hoy contamos con tres empresas especializadas que trabajan en perfecta sinergia: GSD Legal, GSD Inmobiliaria y GSD Agrimensura, todas bajo la coordinación estratégica de la Matriz.
      </p>
    </div>
  </div>
</section>

<!-- Misión / Visión -->
<section style="padding: 5rem 2rem; background: var(--gris-100);">
  <div style="max-width: 1280px; margin: 0 auto;">
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem;">
      <div style="background: var(--blanco); border-radius: 16px; padding: 2.5rem; border: 1px solid var(--gris-200); box-shadow: var(--sombra);" class="reveal delay-1">
        <div style="width:48px; height:48px; background: rgba(91,158,63,0.1); border-radius: 12px; display:flex; align-items:center; justify-content:center; margin-bottom:1.25rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5B9E3F" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
        </div>
        <h3 style="font-size:1.2rem; margin-bottom:0.75rem;">Misión</h3>
        <p style="color: var(--gris-500); font-size: 0.9rem; line-height: 1.7;">Brindar soluciones jurídicas, inmobiliarias y técnicas de excelencia, garantizando la seguridad jurídica y el éxito de cada proyecto de nuestros clientes.</p>
      </div>
      <div style="background: var(--blanco); border-radius: 16px; padding: 2.5rem; border: 1px solid var(--gris-200); box-shadow: var(--sombra);" class="reveal delay-2">
        <div style="width:48px; height:48px; background: rgba(27,58,107,0.1); border-radius: 12px; display:flex; align-items:center; justify-content:center; margin-bottom:1.25rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1B3A6B" stroke-width="2"><path d="M1 6l11-4 11 4-11 4-11-4zM1 18l11 4 11-4M1 12l11 4 11-4"/></svg>
        </div>
        <h3 style="font-size:1.2rem; margin-bottom:0.75rem;">Visión</h3>
        <p style="color: var(--gris-500); font-size: 0.9rem; line-height: 1.7;">Ser el grupo empresarial de referencia en la República Dominicana para la gestión integral de proyectos inmobiliarios y de inversión extranjera.</p>
      </div>
      <div style="background: var(--blanco); border-radius: 16px; padding: 2.5rem; border: 1px solid var(--gris-200); box-shadow: var(--sombra);" class="reveal delay-3">
        <div style="width:48px; height:48px; background: rgba(255,152,0,0.1); border-radius: 12px; display:flex; align-items:center; justify-content:center; margin-bottom:1.25rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#e65100" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <h3 style="font-size:1.2rem; margin-bottom:0.75rem;">Valores</h3>
        <p style="color: var(--gris-500); font-size: 0.9rem; line-height: 1.7;">Transparencia, excelencia, integridad y compromiso total con cada cliente. Cada caso importa, cada proyecto es único.</p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
