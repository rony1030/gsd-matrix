        <div style="position: relative; z-index: 1;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
            <span style="font-weight:800; font-size:1.15rem; color:#b58a36;">03</span>
            <span style="font-size:0.75rem; font-weight:700; text-transform:uppercase; background:rgba(214,168,69,0.15); color:#997220; padding:4px 10px; border-radius:99px;">Títulos</span>
