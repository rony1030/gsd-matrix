           alt="Sede Geosolutions Source Dominicana" style="width:100%; border-radius: 16px; object-fit: cover; aspect-ratio: 4/3; box-shadow: 0 10px 30px rgba(0,0,0,0.06);">
    </div>
    <div>
      <span class="eyebrow reveal">INTEGRACIÓN TOTAL</span>
      <h2 style="font-size: 2rem; margin: 0.75rem 0 1.25rem; color: var(--azul);" class="reveal delay-1">
        Un solo interlocutor, un solo expediente, una sola firma que responde por el resultado.
      </h2>
      <p style="color: var(--gris-500); line-height: 1.8; margin-bottom: 1.25rem;" class="reveal delay-2">
