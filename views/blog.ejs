<%- include('partials/header', { title: 'Blog — GSD Geosolutions Source Dominicana', page: page }) %>
<div style="padding-top: 76px;"></div>
<section style="background: var(--gris-100); padding: 5rem 2rem 4rem; border-bottom: 1px solid var(--gris-200);">
  <div style="max-width: 1280px; margin: 0 auto;">
    <span class="eyebrow reveal">Blog GSD</span>
    <h1 style="font-size: clamp(2.5rem, 5vw, 3.5rem); margin-top: 0.75rem; color: var(--azul);" class="reveal delay-1">Noticias y Artículos</h1>
    <p style="color: var(--gris-500); font-size: 1.05rem; margin-top: 1rem;" class="reveal delay-2">Información útil sobre el mercado inmobiliario, legal y técnico dominicano.</p>
  </div>
</section>
<section style="padding: 5rem 2rem; background: var(--blanco);">
  <div style="max-width: 1280px; margin: 0 auto;">
    <% if (posts.length === 0) { %>
      <div style="text-align:center;padding:4rem;color:var(--gris-500);">
        <p style="font-size:1.1rem;">No hay artículos publicados todavía.</p>
      </div>
    <% } else { %>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:2rem;">
      <% posts.forEach((post, i) => { %>
      <article style="background:var(--blanco);border:1px solid var(--gris-200);border-radius:16px;overflow:hidden;box-shadow:var(--sombra);transition:var(--transicion);" class="reveal" style="transition-delay: <%= i*0.1 %>s"
               onmouseover="this.style.boxShadow='var(--sombra-hover)';this.style.transform='translateY(-4px)'"
               onmouseout="this.style.boxShadow='var(--sombra)';this.style.transform=''">
        <% if (post.imagen_portada) { %>
        <div style="aspect-ratio:16/9;overflow:hidden;">
          <img src="<%= post.imagen_portada %>" alt="<%= post.titulo %>" style="width:100%;height:100%;object-fit:cover;">
        </div>
        <% } %>
        <div style="padding:1.5rem;">
          <span style="font-size:0.72rem;color:var(--verde);font-weight:700;letter-spacing:0.1em;text-transform:uppercase;">
            <%= post.fecha_publicacion?.substring(0,10) || post.created_at?.substring(0,10) %>
          </span>
          <h2 style="font-size:1.2rem;margin:0.5rem 0 0.75rem;"><a href="/blog/<%= post.slug %>" style="color:var(--azul);"><%= post.titulo %></a></h2>
          <p style="color:var(--gris-500);font-size:0.875rem;line-height:1.6;"><%= post.meta_description || '' %></p>
          <a href="/blog/<%= post.slug %>" style="display:inline-flex;align-items:center;gap:0.4rem;color:var(--verde);font-weight:600;font-size:0.875rem;margin-top:1rem;">
            Leer más <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </article>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
