<%- include('partials/header', { title: 'GSD — Geosolutions Source Dominicana', page: page }) %>

<!-- ═══ HERO ═══ -->
<section class="hero" id="inicio">
  <div class="hero-bg" id="hero-bg"></div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <span class="hero-label">República Dominicana</span>
    <h1 class="hero-h1">
      <span class="static">Soluciones</span>
      <span class="rotating-wrap">
        <span class="rotating-word">Legales</span>
        <span class="rotating-word">Inmobiliarias</span>
        <span class="rotating-word">Técnicas</span>
      </span>
      <span class="static" style="animation: fadeUp 0.8s 0.6s both">con precisión experta</span>
    </h1>
    <p class="hero-subtitle">
      Grupo empresarial especializado en derecho inmobiliario, bienes raíces y agrimensura para inversiones nacionales e internacionales.
    </p>
    <div class="hero-btns">
      <a href="#contacto" class="btn-primary">Contáctanos</a>
      <a href="#servicios" class="btn-outline-white">Nuestros Servicios</a>
    </div>
  </div>
  <div class="scroll-indicator" onclick="document.getElementById('servicios').scrollIntoView({behavior:'smooth'})">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    <span>Scroll</span>
  </div>
</section>

<!-- ═══ SERVICIOS ═══ -->
<section class="section-intro" id="servicios">
  <div class="section-intro-inner">
    <div class="section-header reveal">
      <span class="eyebrow">Nuestras Empresas</span>
      <h2>Soluciones integrales bajo un solo grupo</h2>
      <p>Tres empresas especializadas que trabajan en sinergia para darte resultados completos en cada proyecto.</p>
    </div>

    <div class="services-grid">
      <!-- Legal -->
      <div class="service-card reveal delay-1">
        <div class="service-card-bg" style="background-image: url('https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=800&q=80')"></div>
        <div class="service-card-overlay"></div>
        <div class="service-card-content">
          <div class="service-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3>Legal</h3>
          <p>Asesoría jurídica especializada en derecho inmobiliario, societario y de inversión extranjera.</p>
          <a href="#" class="service-link">
            Conoce más
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Inmobiliaria -->
      <div class="service-card reveal delay-2">
        <div class="service-card-bg" style="background-image: url('https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=800&q=80')"></div>
        <div class="service-card-overlay"></div>
        <div class="service-card-content">
          <div class="service-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3>Inmobiliaria</h3>
          <p>Gestión integral de proyectos, compraventas y regularización de propiedades en toda la República.</p>
          <a href="https://gsd-bienes-raices.vercel.app" class="service-link">
            Conoce más
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Agrimensura -->
      <div class="service-card reveal delay-3">
        <div class="service-card-bg" style="background-image: url('https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=800&q=80')"></div>
        <div class="service-card-overlay"></div>
        <div class="service-card-content">
          <div class="service-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"><path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"/><path d="m13 13 6 6"/></svg>
          </div>
          <h3>Agrimensura</h3>
          <p>Levantamientos, deslindes y soluciones técnicas con la más alta precisión instrumental.</p>
          <a href="#" class="service-link">
            Conoce más
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ ABOUT ═══ -->
<section class="section-about" id="nosotros">
  <div class="about-inner">
    <div class="about-text">
      <span class="eyebrow reveal">Quiénes Somos</span>
      <h2 class="reveal delay-1">Más de 15 años construyendo soluciones en República Dominicana</h2>
      <p class="reveal delay-2">Somos un grupo empresarial multidisciplinario con sede en Santo Domingo, comprometido con brindar asesoría de excelencia a nacionales y extranjeros que desean invertir, adquirir o regularizar propiedades en el país.</p>
      <p class="reveal delay-2">Nuestro enfoque integrado une el rigor legal, la experiencia inmobiliaria y la precisión técnica en un solo equipo.</p>

      <div class="about-values">
        <div class="about-value-item reveal delay-3">
          <div class="about-value-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div class="about-value-text">
            <strong>Transparencia total</strong>
            <span>Informes claros en cada etapa del proceso</span>
          </div>
        </div>
        <div class="about-value-item reveal delay-4">
          <div class="about-value-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="about-value-text">
            <strong>Atención ágil</strong>
            <span>Respuesta en menos de 24 horas</span>
          </div>
        </div>
        <div class="about-value-item reveal delay-5">
          <div class="about-value-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="about-value-text">
            <strong>Equipo experto</strong>
            <span>Abogados, agentes e ingenieros certificados</span>
          </div>
        </div>
      </div>
    </div>

    <div class="about-image-wrap reveal-right">
      <img src="https://images.unsplash.com/photo-1560520653-9e0e4c89eb11?auto=format&fit=crop&w=800&q=80" alt="Equipo GSD" loading="lazy">
      <div class="about-badge">
        <div class="about-badge-num">+15</div>
        <div class="about-badge-label">Años de experiencia</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ STATS ═══ -->
<section class="section-stats">
  <div class="stats-inner">
    <div class="stats-header">
      <span class="eyebrow reveal">Experiencia que genera confianza</span>
      <h2 class="reveal delay-1">Resultados que hablan por nosotros</h2>
    </div>
    <div class="stats-grid">
      <div class="stat-item reveal delay-1">
        <div class="stat-number">
          <span class="stat-prefix">+</span>
          <span class="counter-num" data-target="15">0</span>
        </div>
        <p class="stat-label">Años de experiencia en el sector</p>
      </div>
      <div class="stat-item reveal delay-2">
        <div class="stat-number">
          <span class="stat-prefix">+</span>
          <span class="counter-num" data-target="250">0</span>
        </div>
        <p class="stat-label">Casos gestionados en derecho inmobiliario</p>
      </div>
      <div class="stat-item reveal delay-3">
        <div class="stat-number">
          <span class="stat-prefix">+</span>
          <span class="counter-num" data-target="100">0</span>
        </div>
        <p class="stat-label">Proyectos inmobiliarios asesorados</p>
      </div>
      <div class="stat-item reveal delay-4">
        <div class="stat-number">
          <span class="stat-prefix">+</span>
          <span class="counter-num" data-target="50">0</span>
          <span class="stat-suffix"> ha</span>
        </div>
        <p class="stat-label">Hectáreas mensuradas y delimitadas</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ CONTACTO ═══ -->
<section class="section-contact" id="contacto">
  <div class="contact-inner">
    <div class="contact-info">
      <span class="eyebrow reveal">Hablemos</span>
      <h2 class="reveal delay-1">¿Listo para dar el siguiente paso?</h2>
      <p class="reveal delay-2">Cuéntanos tu proyecto y uno de nuestros especialistas te contactará en menos de 24 horas.</p>

      <div class="contact-details reveal delay-3">
        <div class="contact-detail">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Av. Winston Churchill, Torre Empresarial Suite 302, Santo Domingo, R.D.</span>
        </div>
        <div class="contact-detail">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.18 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 6 6l.93-.93a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>+1 (809) 555-0123</span>
        </div>
        <div class="contact-detail">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span>info@gsd.com.do</span>
        </div>
      </div>
    </div>

    <div class="contact-form-card reveal-right">
      <h3>Envíanos un mensaje</h3>
      <form id="contact-form" novalidate>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="nombre">Nombre *</label>
            <input type="text" id="nombre" name="nombre" class="form-input" placeholder="Tu nombre" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="email">Email *</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="tu@email.com" required>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="telefono">Teléfono</label>
            <input type="tel" id="telefono" name="telefono" class="form-input" placeholder="809-000-0000">
          </div>
          <div class="form-group">
            <label class="form-label" for="servicio">Servicio</label>
            <select id="servicio" name="servicio" class="form-select">
              <option value="">Seleccionar...</option>
              <option value="Legal">Legal</option>
              <option value="Inmobiliaria">Inmobiliaria</option>
              <option value="Agrimensura">Agrimensura</option>
              <option value="Otro">Otro</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="mensaje">Mensaje</label>
          <textarea id="mensaje" name="mensaje" class="form-textarea" placeholder="Cuéntanos sobre tu proyecto..."></textarea>
        </div>
        <button type="submit" class="btn-submit">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          Enviar mensaje
        </button>
      </form>
      <div class="form-success">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <h4 style="margin-top:1rem;color:var(--azul)">¡Mensaje enviado!</h4>
        <p style="color:var(--gris-500);font-size:0.9rem;margin-top:0.5rem">Te contactaremos en menos de 24 horas.</p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
