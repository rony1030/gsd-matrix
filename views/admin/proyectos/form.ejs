<%- include('../partials/layout-start', { pageTitle: isEdit ? 'Editar Proyecto' : 'Nuevo Proyecto', page: 'proyectos' }) %>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

<style>
  .builder-tabs {
    display: flex;
    gap: 4px;
    border-bottom: 2px solid var(--line);
    margin-bottom: 20px;
  }
  .builder-tab {
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 600;
    color: var(--gray);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all .15s;
  }
  .builder-tab:hover { color: var(--navy); }
  .builder-tab.active {
    color: var(--green);
    border-bottom-color: var(--green);
  }
  .tab-pane { display: none; }
  .tab-pane.active { display: block; }

  /* Flexbox Container Card */
  .fb-container {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 12px;
    margin-bottom: 16px;
    box-shadow: 0 2px 6px rgba(26,58,82,0.04);
    transition: border-color .15s, box-shadow .15s, transform .15s;
    overflow: hidden;
  }
  .fb-container.sortable-ghost {
    opacity: 0.4;
    background: #E8F4EF;
    border: 2px dashed var(--green);
  }
  .fb-container.sortable-chosen {
    box-shadow: 0 10px 25px rgba(26,58,82,0.15);
  }
  .fb-header {
    background: #F8FAFC;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    user-select: none;
  }
  .fb-drag-handle {
    cursor: grab;
    color: var(--gray);
    display: flex;
    align-items: center;
    padding: 4px;
    border-radius: 4px;
    margin-right: 4px;
  }
  .fb-drag-handle:hover {
    color: var(--navy);
    background: #E2E8F0;
  }
  .fb-title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .fb-icon-badge {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--navy);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }
  .fb-title {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--navy);
  }
  .fb-badge {
    font-size: 10.5px;
    padding: 2px 8px;
    border-radius: 10px;
    background: #E2E8F0;
    color: #475569;
    font-weight: 600;
    text-transform: uppercase;
  }
  .fb-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .fb-btn {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--navy);
    cursor: pointer;
    transition: all .15s;
  }
  .fb-btn:hover {
    background: #F1F5F9;
    border-color: #94A3B8;
  }
  .fb-btn.delete:hover {
    background: var(--red-l);
    color: var(--red);
    border-color: var(--red);
  }
  .fb-body {
    padding: 18px 20px;
  }
  
  /* Flex controls bar */
  .fb-controls-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    background: #F1F5F9;
    border-radius: 8px;
    margin-bottom: 14px;
    font-size: 12px;
    color: var(--navy);
  }

  /* Unit typology item */
  .unit-card {
    background: #FAFAFA;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 12px;
    position: relative;
  }

  /* Amenity chips selector */
  .amenity-chip-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }
  .amenity-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fff;
    border: 1px solid var(--line);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    transition: all .15s;
    user-select: none;
  }
  .amenity-chip:hover {
    border-color: var(--green);
    background: #F0FDF4;
  }
  .amenity-chip.active {
    background: var(--green-l);
    border-color: var(--green);
    color: #2F6B4A;
    font-weight: 600;
  }

  /* Live Preview Box */
  .preview-viewport {
    background: #F9FAFB;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  }
  .preview-topbar {
    background: var(--navy);
    color: #fff;
    padding: 8px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
  }
  .preview-content {
    max-height: 700px;
    overflow-y: auto;
    background: #fff;
  }

  /* Icon Modal Grid */
  .icon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
    gap: 8px;
    max-height: 320px;
    overflow-y: auto;
    padding: 10px 0;
  }
  .icon-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 4px;
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
    transition: all .15s;
    background: #fff;
  }
  .icon-option:hover {
    border-color: var(--green);
    background: var(--green-l);
    transform: scale(1.05);
  }
  .icon-option span {
    font-size: 10px;
    color: var(--gray);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 60px;
  }
</style>

<div style="margin-bottom:16px;display:flex;justify-content:space-between;align-items:center">
  <a href="/admin/proyectos" class="link" style="display:inline-flex;align-items:center;gap:6px;font-size:13px">
    <i data-lucide="arrow-left"></i> Volver al catálogo de proyectos
  </a>
  <% if (isEdit && proyecto && proyecto.slug) { %>
    <a href="http://localhost:3001/proyectos/<%= proyecto.slug %>" target="_blank" class="btn sm" style="text-decoration:none;display:inline-flex;align-items:center;gap:6px">
      <i data-lucide="external-link"></i> Ver página pública en vivo
    </a>
  <% } %>
</div>

<form id="projectForm" method="POST" action="<%= isEdit ? '/admin/proyectos/' + proyecto.id + '/editar' : '/admin/proyectos/nuevo' %>">
  
  <input type="hidden" name="bloques" id="bloquesJson">

  <!-- TOP BAR & PROJECT MAIN TITLE -->
  <div class="card" style="margin-bottom:16px;padding:18px 24px">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
      <div style="flex:1;min-width:280px">
        <label style="font-size:11px;text-transform:uppercase;color:var(--gray);font-weight:600">Nombre del Proyecto</label>
        <input type="text" name="nombre" id="pNombre" value="<%= proyecto?.nombre || '' %>" placeholder="Ej: Stellar Residences" style="font-size:18px;font-weight:700;color:var(--navy);padding:6px 10px" required>
      </div>
      <div style="width:240px">
        <label style="font-size:11px;text-transform:uppercase;color:var(--gray);font-weight:600">Slug URL</label>
        <input type="text" name="slug" id="pSlug" value="<%= proyecto?.slug || '' %>" placeholder="ej: stellar-punta-cana" style="font-size:12.5px" required>
      </div>
      <div style="display:flex;gap:10px;align-items:flex-end">
        <button type="submit" class="btn p" style="height:40px;padding:0 20px;font-weight:600">
          <i data-lucide="save"></i> <%= isEdit ? 'Actualizar Proyecto' : 'Publicar Proyecto' %>
        </button>
      </div>
    </div>
  </div>

  <!-- BUILDER TABS -->
  <div class="builder-tabs">
    <button type="button" class="builder-tab active" onclick="switchTab('builder')">
      <i data-lucide="layout"></i> Constructor Visual Flexbox
    </button>
    <button type="button" class="builder-tab" onclick="switchTab('general')">
      <i data-lucide="sliders"></i> Parámetros Básicos & Portada
    </button>
    <button type="button" class="builder-tab" onclick="switchTab('preview'); renderLivePreview();">
      <i data-lucide="eye"></i> Vista Previa en Tiempo Real
    </button>
  </div>

  <!-- TAB 1: BUILDER VISUAL FLEXBOX -->
  <div id="tab-builder" class="tab-pane active">
    
    <!-- BLOCK ADDER TOOLBAR -->
    <div class="card" style="background:#F8FAFC;border:1px dashed #94A3B8;margin-bottom:20px;padding:16px 20px">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
        <div>
          <b style="font-size:14px;color:var(--navy);display:flex;align-items:center;gap:6px">
            <i data-lucide="layers" style="color:var(--green)"></i> Añadir Bloque / Contenedor Flexbox
          </b>
          <span style="font-size:11.5px;color:var(--gray)">Arrastra los bloques con <b>⠿ Mover</b> para reordenar la página.</span>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button type="button" class="btn sm" onclick="addBlock('metricas')"><i data-lucide="bar-chart-2"></i> + Métricas Clave</button>
          <button type="button" class="btn sm" onclick="addBlock('tipologias')"><i data-lucide="building-2"></i> + Tipologías & Planos</button>
          <button type="button" class="btn sm" onclick="addBlock('amenidades')"><i data-lucide="sparkles"></i> + Amenidades Resort</button>
          <button type="button" class="btn sm" onclick="addBlock('plan_pago')"><i data-lucide="credit-card"></i> + Plan de Pago</button>
          <button type="button" class="btn sm" onclick="addBlock('distancias')"><i data-lucide="map-pin"></i> + Ubicación & Entorno</button>
          <button type="button" class="btn sm" onclick="addBlock('galeria')"><i data-lucide="image"></i> + Galería Masonry</button>
          <button type="button" class="btn sm" onclick="addBlock('editorial')"><i data-lucide="file-text"></i> + Texto Editorial</button>
        </div>
      </div>
    </div>

    <!-- CONTAINERS LIST (SORTABLE) -->
    <div id="containersList"></div>

  </div>

  <!-- TAB 2: GENERAL SETTINGS -->
  <div id="tab-general" class="tab-pane">
    <div class="card" style="padding:24px">
      <h3 style="font-size:16px;color:var(--navy);margin-bottom:16px">Configuración General del Proyecto</h3>
      
      <div class="g3">
        <div class="f">
          <label>Promotor / Desarrollador</label>
          <input type="text" name="promotor" id="pPromotor" value="<%= proyecto?.promotor || 'GSD Real Estate' %>" placeholder="Ej: Blue Coast Realty">
        </div>
        <div class="f">
          <label>Ubicación / Sector *</label>
          <input type="text" name="ubicacion" id="pUbicacion" value="<%= proyecto?.ubicacion || '' %>" placeholder="Ej: Bávaro, Punta Cana" required>
        </div>
        <div class="f">
          <label>Tipologías resumidas (Badge)</label>
          <input type="text" name="tipologias" id="pTipologias" value="<%= proyecto?.tipologias || 'Apartamentos 1-3 Hab, Penthouses' %>" placeholder="Ej: Villas, Estudios">
        </div>
      </div>

      <div class="g3">
        <div class="f">
          <label>Precio Desde *</label>
          <input type="number" step="any" min="0" name="precio_desde" id="pPrecio" value="<%= proyecto?.precio_desde || '' %>" placeholder="180000" required>
        </div>
        <div class="f">
          <label>Moneda</label>
          <select name="moneda" id="pMoneda">
            <option value="USD" <%= (proyecto?.moneda === 'USD' || !proyecto) ? 'selected' : '' %>>USD (US$ Dólares)</option>
            <option value="DOP" <%= proyecto?.moneda === 'DOP' ? 'selected' : '' %>>DOP (RD$ Pesos)</option>
          </select>
        </div>
        <div class="f">
          <label>Estado del desarrollo</label>
          <select name="estado" id="pEstado">
            <option value="En construcción" <%= (proyecto?.estado === 'En construcción' || !proyecto) ? 'selected' : '' %>>En construcción</option>
            <option value="Entrega inmediata" <%= proyecto?.estado === 'Entrega inmediata' ? 'selected' : '' %>>Entrega inmediata</option>
            <option value="En planos / Pre-venta" <%= proyecto?.estado === 'En planos / Pre-venta' ? 'selected' : '' %>>En planos / Pre-venta</option>
          </select>
        </div>
      </div>

      <div class="g2">
        <div class="f">
          <label>Año estimado de entrega</label>
          <input type="text" name="entrega" id="pEntrega" value="<%= proyecto?.entrega || '2027' %>" placeholder="Ej: 2027 o Inmediata">
        </div>
        <div class="f" style="display:flex;align-items:center;padding-top:22px">
          <label style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:var(--navy);cursor:pointer">
            <input type="checkbox" name="featured" id="pFeatured" style="width:auto" <%= (proyecto?.featured) ? 'checked' : '' %>>
            Destacar en portada del catálogo de Bienes Raíces
          </label>
        </div>
      </div>

      <div class="f">
        <label>Descripción / Introducción Principal</label>
        <textarea name="descripcion" id="pDescripcion" style="min-height:100px;line-height:1.6" placeholder="Describe la visión, entorno y amenidades..."><%= proyecto?.descripcion || '' %></textarea>
      </div>

      <div class="f">
        <label>Imagen de Portada Principal (Hero Cover HTTPS)</label>
        <input type="url" name="cover_image" id="pCover" value="<%= proyecto?.cover_image || '' %>" placeholder="https://images.unsplash.com/..." required>
      </div>

      <div class="f">
        <label>Galería de fotos rápida (URLs separadas por comas o saltos de línea)</label>
        <textarea name="galeria" id="pGaleria" style="min-height:80px" placeholder="https://..., https://..."><%= Array.isArray(proyecto?.galeria) ? proyecto.galeria.join('\n') : (proyecto?.galeria_str || '') %></textarea>
      </div>

      <div class="f">
        <label>Amenidades rápidas (separadas por comas)</label>
        <input type="text" name="amenidades" id="pAmenidades" value="<%= Array.isArray(proyecto?.amenidades) ? proyecto.amenidades.join(', ') : (proyecto?.amenidades_str || '') %>" placeholder="Piscina infinita, Gym & Spa, Playa privada, Seguridad 24/7">
      </div>
    </div>
  </div>

  <!-- TAB 3: LIVE PREVIEW -->
  <div id="tab-preview" class="tab-pane">
    <div class="preview-viewport">
      <div class="preview-topbar">
        <span><b>GSD REAL ESTATE</b> · Vista Previa de Ficha Editorial</span>
        <span style="font-size:11px;opacity:0.8">http://localhost:3001/proyectos/<span id="prevSlug">stellar-punta-cana</span></span>
      </div>
      <div class="preview-content" id="livePreviewContainer">
        <!-- Rendered via JS -->
      </div>
    </div>
  </div>

</form>

<!-- ICON PICKER MODAL -->
<div class="modal" id="mIconPicker" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.6);backdrop-filter:blur(4px);z-index:999;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:14px;width:480px;max-width:92vw;padding:22px;box-shadow:0 20px 35px rgba(0,0,0,0.2)">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
      <h3 style="font-size:15px;color:var(--navy);margin:0;display:flex;align-items:center;gap:6px">
        <i data-lucide="sparkles" style="color:var(--green)"></i> Seleccionar Icono de Lujo
      </h3>
      <button type="button" onclick="closeIconModal()" style="border:none;background:none;font-size:16px;cursor:pointer;color:var(--gray)"><i data-lucide="x"></i></button>
    </div>
    <div class="icon-grid" id="iconPickerGrid"></div>
    <div style="display:flex;justify-content:flex-end;margin-top:14px">
      <button type="button" class="btn sm" onclick="closeIconModal()">Cerrar</button>
    </div>
  </div>
</div>

