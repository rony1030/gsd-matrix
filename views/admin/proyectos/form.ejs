<%- include('../partials/layout-start', { pageTitle: isEdit ? 'Editar Proyecto' : 'Nuevo Proyecto', page: 'proyectos' }) %>

<div style="margin-bottom:16px">
  <a href="/admin/proyectos" class="link" style="display:inline-flex;align-items:center;gap:6px;font-size:13px">
    <i data-lucide="arrow-left"></i> Volver al catálogo de proyectos
  </a>
</div>

<div class="card" style="max-width:920px;margin:0 auto 30px;padding:26px">
  <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:20px">
    <div>
      <h2 style="font-size:20px;color:var(--navy);margin:0"><%= isEdit ? 'Editar Proyecto Inmobiliario' : 'Crear Nuevo Proyecto Inmobiliario' %></h2>
      <p style="font-size:12px;color:var(--gray);margin-top:4px">La información se sincronizará con la página web editorial de GSD.</p>
    </div>
    <% if (isEdit && proyecto && proyecto.slug) { %>
      <a href="http://localhost:3001/proyectos/<%= proyecto.slug %>" target="_blank" class="btn sm" style="text-decoration:none">
        <i data-lucide="external-link"></i> Ver página pública
      </a>
    <% } %>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div style="background:var(--red-l);color:var(--red);padding:12px 16px;border-radius:8px;margin-bottom:18px;font-size:12.5px;border:1px solid rgba(192,57,43,0.2)">
      <%= error %>
    </div>
  <% } %>

  <form method="POST" action="<%= isEdit ? '/admin/proyectos/' + proyecto.id + '/editar' : '/admin/proyectos/nuevo' %>">
    <div class="g2">
      <div class="f">
        <label>Nombre comercial del proyecto *</label>
        <input type="text" name="nombre" id="pNombre" value="<%= proyecto?.nombre || '' %>" placeholder="Ej: Stellar Residences" required>
      </div>
      <div class="f">
        <label>Slug URL (automático o personalizado)</label>
        <input type="text" name="slug" id="pSlug" value="<%= proyecto?.slug || '' %>" placeholder="ej: stellar-punta-cana">
      </div>
    </div>

    <div class="g3">
      <div class="f">
        <label>Promotor / Desarrollador</label>
        <input type="text" name="promotor" value="<%= proyecto?.promotor || 'GSD Real Estate' %>" placeholder="Ej: Blue Coast Realty">
      </div>
      <div class="f">
        <label>Ubicación / Sector *</label>
        <input type="text" name="ubicacion" value="<%= proyecto?.ubicacion || '' %>" placeholder="Ej: Bávaro, Punta Cana" required>
      </div>
      <div class="f">
        <label>Tipologías disponibles</label>
        <input type="text" name="tipologias" value="<%= proyecto?.tipologias || 'Apartamentos 1-3 Hab, Penthouses' %>" placeholder="Ej: Villas, Estudios">
      </div>
    </div>

    <div class="g3">
      <div class="f">
        <label>Precio Desde *</label>
        <input type="number" step="any" min="0" name="precio_desde" value="<%= proyecto?.precio_desde || '' %>" placeholder="180000" required>
      </div>
      <div class="f">
        <label>Moneda</label>
        <select name="moneda">
          <option value="USD" <%= (proyecto?.moneda === 'USD' || !proyecto) ? 'selected' : '' %>>USD (US$ Dólares)</option>
          <option value="DOP" <%= proyecto?.moneda === 'DOP' ? 'selected' : '' %>>DOP (RD$ Pesos)</option>
        </select>
      </div>
      <div class="f">
        <label>Estado del desarrollo</label>
        <select name="estado">
          <option value="En construcción" <%= (proyecto?.estado === 'En construcción' || !proyecto) ? 'selected' : '' %>>En construcción</option>
          <option value="Entrega inmediata" <%= proyecto?.estado === 'Entrega inmediata' ? 'selected' : '' %>>Entrega inmediata</option>
          <option value="En planos / Pre-venta" <%= proyecto?.estado === 'En planos / Pre-venta' ? 'selected' : '' %>>En planos / Pre-venta</option>
        </select>
      </div>
    </div>

    <div class="g2">
      <div class="f">
        <label>Año estimado de entrega</label>
        <input type="text" name="entrega" value="<%= proyecto?.entrega || '2026' %>" placeholder="Ej: 2026 o Inmediata">
      </div>
      <div class="f" style="display:flex;align-items:center;padding-top:22px">
        <label style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:var(--navy);cursor:pointer">
          <input type="checkbox" name="featured" style="width:auto" <%= (proyecto?.featured) ? 'checked' : '' %>>
          ★ Destacar en portada del catálogo
        </label>
      </div>
    </div>

    <div class="f">
      <label>Descripción editorial del proyecto (formato revista / blog)</label>
      <textarea name="descripcion" style="min-height:120px;line-height:1.6" placeholder="Describe los atractivos principales, concepto arquitectónico, entorno y propuesta de valor para el inversionista..."><%= proyecto?.descripcion || '' %></textarea>
    </div>

    <div class="f">
      <label>Imagen de portada principal (URL HTTPS)</label>
      <input type="url" name="cover_image" value="<%= proyecto?.cover_image || '' %>" placeholder="https://images.unsplash.com/..." required>
    </div>

    <div class="f">
      <label>Galería de fotos (URLs separadas por comas o saltos de línea)</label>
      <textarea name="galeria" style="min-height:80px" placeholder="https://..., https://..."><%= Array.isArray(proyecto?.galeria) ? proyecto.galeria.join('\n') : (proyecto?.galeria_str || '') %></textarea>
    </div>

    <div class="f">
      <label>Amenidades y servicios (separadas por comas)</label>
      <input type="text" name="amenidades" value="<%= Array.isArray(proyecto?.amenidades) ? proyecto.amenidades.join(', ') : (proyecto?.amenidades_str || '') %>" placeholder="Piscina infinita, Gym & Spa, Playa privada, Seguridad 24/7">
    </div>

    <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:24px;padding-top:16px;border-top:1px solid var(--line)">
      <a href="/admin/proyectos" class="btn">Cancelar</a>
      <button type="submit" class="btn p">
        <i data-lucide="save"></i> <%= isEdit ? 'Actualizar Proyecto' : 'Publicar Proyecto' %>
      </button>
    </div>
  </form>
</div>

<script>
  const nombreInput = document.getElementById('pNombre');
  const slugInput = document.getElementById('pSlug');
  if (nombreInput && slugInput && !slugInput.value) {
    nombreInput.addEventListener('input', () => {
      slugInput.value = nombreInput.value
        .toLowerCase()
        .trim()
        .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/\s+/g, "-")
        .replace(/[^\w-]+/g, "")
        .replace(/--+/g, "-");
    });
  }
</script>

<%- include('../partials/layout-end') %>
