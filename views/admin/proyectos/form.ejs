      </div>
      <div style="padding:28px;max-width:960px;margin:0 auto">
        <p style="font-size:14px;line-height:1.7;color:#475569;border-left:3px solid #4A9B6F;padding-left:14px">${desc || 'Descripción editorial del proyecto...'}</p>
        ${blocksHtml}
      </div>
    `;
  }

  // Auto slug generator
  const nombreInput = document.getElementById('pNombre');
  const slugInput = document.getElementById('pSlug');
  if (nombreInput && slugInput && !slugInput.value) {
    nombreInput.addEventListener('input', () => {
      slugInput.value = nombreInput.value
        .toLowerCase()
        .trim()
        .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/\s+/g, "-")
        .replace(/[^\w-]+/g, "")
        .replace(/--+/g, "-");
    });
  }

  // Form submit handler to guarantee serialization
  document.getElementById('projectForm').addEventListener('submit', () => {
    syncHiddenJson();
  });

  // Init
  document.addEventListener('DOMContentLoaded', () => {
    renderContainers();
  });
</script>

<%- include('../partials/layout-end') %>
