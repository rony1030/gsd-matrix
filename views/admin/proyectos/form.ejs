                <button type="button" onclick="removeSubItem(${idx}, 'items', ${itIdx})" style="position:absolute;top:6px;right:6px;border:none;background:none;color:var(--red);cursor:pointer" title="Eliminar">×</button>
                <div class="f" style="margin-bottom:6px"><label style="font-size:11px">Etiqueta</label><input type="text" value="${it.label||''}" oninput="bItemsInput(${idx}, ${itIdx}, 'label', this.value)"></div>
                <div class="f" style="margin-bottom:6px"><label style="font-size:11px">Valor Destacado</label><input type="text" value="${it.value||''}" oninput="bItemsInput(${idx}, ${itIdx}, 'value', this.value)" style="font-weight:600;color:var(--navy)"></div>
                <div class="f" style="margin-bottom:0"><label style="font-size:11px">Detalle / Subtexto</label><input type="text" value="${it.sub||''}" oninput="bItemsInput(${idx}, ${itIdx}, 'sub', this.value)"></div>
              </div>
            `).join('')}
          </div>
        `;
      } else if (b.type === 'tipologias') {
        bodyHtml = `
          <div class="fb-controls-bar">
            <span>Modelos y planos de apartamentos configurables:</span>
            <button type="button" class="btn sm p" onclick="addUnitItem(${idx})" style="margin-left:auto">+ Añadir Tipología</button>
          </div>
          <div>
            ${(b.units||[]).map((u, uIdx) => `
              <div class="unit-card">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                  <b style="color:var(--navy);font-size:13px">Modelo #${uIdx+1}: ${u.name||'Sin título'}</b>
                  <button type="button" class="btn sm" onclick="removeSubItem(${idx}, 'units', ${uIdx})" style="color:var(--red);border-color:var(--red-l)">Eliminar</button>
                </div>
                <div class="g3">
                  <div class="f"><label>Nombre</label><input type="text" value="${u.name||''}" oninput="bUnitInput(${idx}, ${uIdx}, 'name', this.value)"></div>
                  <div class="f"><label>Metraje / Área</label><input type="text" value="${u.area||''}" oninput="bUnitInput(${idx}, ${uIdx}, 'area', this.value)"></div>
                  <div class="f"><label>Distribución (Habs / Baños)</label><input type="text" value="${u.habs||''}" oninput="bUnitInput(${idx}, ${uIdx}, 'habs', this.value)"></div>
                </div>
                <div class="g2">
                  <div class="f"><label>Precio Desde</label><input type="text" value="${u.precio||''}" oninput="bUnitInput(${idx}, ${uIdx}, 'precio', this.value)" style="font-weight:700;color:var(--green)"></div>
                  <div class="f"><label>Foto del Plano / Render (URL)</label><input type="url" value="${u.plano_url||''}" oninput="bUnitInput(${idx}, ${uIdx}, 'plano_url', this.value)"></div>
                </div>
                <div class="f" style="margin-bottom:0"><label>Detalles / Descripción</label><input type="text" value="${u.desc||''}" oninput="bUnitInput(${idx}, ${uIdx}, 'desc', this.value)"></div>
              </div>
            `).join('')}
          </div>
        `;
      } else if (b.type === 'amenidades') {
        const selectedList = b.items || [];
        bodyHtml = `
          <div class="fb-controls-bar">
            <span>Selección rápida de amenidades con iconos preconfigurados:</span>
          </div>
          <div class="amenity-chip-grid">
            ${POPULAR_AMENITIES.map(pop => {
              const isSelected = selectedList.includes(pop.name);
              return `
                <div class="amenity-chip ${isSelected ? 'active' : ''}" onclick="toggleAmenityChip(${idx}, '${pop.name}')">
                  <i data-lucide="${pop.icon}"></i>
                  <span>${pop.name}</span>
                </div>
              `;
            }).join('')}
          </div>
          <div class="f"><label>Amenidades personalizadas adicionales (separadas por comas)</label>
            <textarea style="min-height:70px" oninput="bAmenidadesInput(${idx}, this.value)">${selectedList.join(', ')}</textarea>
          </div>
        `;
      } else if (b.type === 'plan_pago') {
        bodyHtml = `
          <div class="fb-controls-bar">
            <span>Pasos y porcentajes del plan de financiamiento:</span>
            <button type="button" class="btn sm" onclick="addPaymentStep(${idx})" style="margin-left:auto">+ Añadir Hito</button>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
            ${(b.steps||[]).map((st, stIdx) => `
              <div style="background:#FAFAFA;border:1px solid var(--line);border-radius:8px;padding:10px;position:relative">
                <button type="button" onclick="removeSubItem(${idx}, 'steps', ${stIdx})" style="position:absolute;top:6px;right:6px;border:none;background:none;color:var(--red);cursor:pointer">×</button>
                <div class="f" style="margin-bottom:6px"><label style="font-size:11px">Porcentaje / Monto</label><input type="text" value="${st.pct||''}" oninput="bStepInput(${idx}, ${stIdx}, 'pct', this.value)" style="font-weight:700;color:var(--green)"></div>
                <div class="f" style="margin-bottom:6px"><label style="font-size:11px">Hito / Título</label><input type="text" value="${st.title||''}" oninput="bStepInput(${idx}, ${stIdx}, 'title', this.value)"></div>
                <div class="f" style="margin-bottom:0"><label style="font-size:11px">Condición / Tiempo</label><input type="text" value="${st.desc||''}" oninput="bStepInput(${idx}, ${stIdx}, 'desc', this.value)"></div>
              </div>
            `).join('')}
          </div>
        `;
      } else if (b.type === 'distancias') {
        bodyHtml = `
          <div class="fb-controls-bar">
            <span>Puntos de interés cercanos y tiempos de traslado:</span>
            <button type="button" class="btn sm" onclick="addDistancePoint(${idx})" style="margin-left:auto">+ Añadir Punto</button>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px">
            ${(b.points||[]).map((pt, ptIdx) => `
              <div style="display:flex;gap:8px;align-items:center;background:#FAFAFA;border:1px solid var(--line);padding:8px 10px;border-radius:6px">
                <input type="text" placeholder="Lugar" value="${pt.place||''}" oninput="bPointInput(${idx}, ${ptIdx}, 'place', this.value)" style="flex:2">
                <input type="text" placeholder="3 min" value="${pt.time||''}" oninput="bPointInput(${idx}, ${ptIdx}, 'time', this.value)" style="flex:1;font-weight:600">
                <button type="button" onclick="removeSubItem(${idx}, 'points', ${ptIdx})" style="border:none;background:none;color:var(--red);cursor:pointer">×</button>
              </div>
            `).join('')}
          </div>
        `;
      } else if (b.type === 'galeria') {
        bodyHtml = `
          <div class="f"><label>Fotos de la Galería (URLs por línea)</label>
            <textarea style="min-height:90px" oninput="bGaleriaInput(${idx}, this.value)">${(b.images||[]).join('\n')}</textarea>
          </div>
        `;
      } else if (b.type === 'editorial') {
        bodyHtml = `
          <div class="f"><label>Título del Bloque</label><input type="text" value="${b.heading||''}" oninput="updateBlockField(${idx}, 'heading', this.value)"></div>
          <div class="f"><label>Texto Conceptual</label><textarea style="min-height:90px" oninput="updateBlockField(${idx}, 'content', this.value)">${b.content||''}</textarea></div>
        `;
      }

      return `
        <div class="fb-container" id="fb_card_${idx}" data-idx="${idx}">
          <div class="fb-header">
            <div class="fb-title-wrap">
              <div class="fb-drag-handle" title="Arrastrar para mover">
                <i data-lucide="grip-vertical"></i>
              </div>
              <div class="fb-icon-badge"><i data-lucide="${getBlockIcon(b.type)}"></i></div>
              <div>
                <span class="fb-title">${b.title || getBlockDefaultTitle(b.type)}</span>
                <span class="fb-badge" style="margin-left:6px">${b.type}</span>
              </div>
            </div>
            <div class="fb-actions">
              <button type="button" class="fb-btn" onclick="moveBlock(${idx}, -1)" title="Subir bloque" ${idx===0?'disabled style="opacity:0.4"':''}><i data-lucide="chevron-up"></i></button>
              <button type="button" class="fb-btn" onclick="moveBlock(${idx}, 1)" title="Bajar bloque" ${idx===blocksState.length-1?'disabled style="opacity:0.4"':''}><i data-lucide="chevron-down"></i></button>
              <button type="button" class="fb-btn delete" onclick="deleteBlock(${idx})" title="Eliminar contenedor"><i data-lucide="trash-2"></i></button>
            </div>
          </div>
          <div class="fb-body">
            <div class="f" style="margin-bottom:12px">
              <label style="font-size:11px;color:var(--gray)">Título visible de la sección</label>
              <input type="text" value="${b.title||''}" oninput="updateBlockField(${idx}, 'title', this.value)" style="font-weight:600">
            </div>
            ${bodyHtml}
          </div>
        </div>
      `;
    }).join('');

    if (window.lucide) lucide.createIcons();
    initSortable();
    syncHiddenJson();
  }

  function initSortable() {
    const list = document.getElementById('containersList');
    if (!list || !window.Sortable) return;
    
    if (list._sortable) {
      list._sortable.destroy();
    }

    list._sortable = new Sortable(list, {
      handle: '.fb-drag-handle',
      animation: 180,
      ghostClass: 'sortable-ghost',
      chosenClass: 'sortable-chosen',
      onEnd: function(evt) {
        const oldIndex = evt.oldIndex;
        const newIndex = evt.newIndex;
        if (oldIndex === newIndex) return;

        const moved = blocksState.splice(oldIndex, 1)[0];
        blocksState.splice(newIndex, 0, moved);
        renderContainers();
      }
    });
  }

  function toggleAmenityChip(bIdx, name) {
    blocksState[bIdx].items = blocksState[bIdx].items || [];
    const pos = blocksState[bIdx].items.indexOf(name);
    if (pos > -1) {
      blocksState[bIdx].items.splice(pos, 1);
    } else {
      blocksState[bIdx].items.push(name);
    }
    renderContainers();
  }

  function getBlockIcon(type) {
    const map = { metricas: 'bar-chart-2', tipologias: 'building-2', galeria: 'image', amenidades: 'sparkles', plan_pago: 'credit-card', distancias: 'map-pin', editorial: 'file-text' };
    return map[type] || 'box';
  }

  function getBlockDefaultTitle(type) {
    const map = {
      metricas: 'Métricas Clave de Inversión',
      tipologias: 'Tipologías & Planos Arquitectónicos',
      galeria: 'Galería de Fotos & Masterplan',
      amenidades: 'Amenidades de Resort',
      plan_pago: 'Plan de Pagos Flexible',
      distancias: 'Ubicación & Puntos de Interés',
      editorial: 'Concepto Arquitectónico'
    };
    return map[type] || 'Contenedor Modular';
  }

  function addBlock(type) {
    let newB = { id: 'blk_' + Date.now(), type, title: getBlockDefaultTitle(type), flex_dir: 'row' };
    if (type === 'metricas') {
      newB.items = [{ label: 'Superficie', value: '75 m²', sub: 'Desde' }, { label: 'ROI Estimado', value: '10%', sub: 'Anual' }];
    } else if (type === 'tipologias') {
      newB.units = [{ name: 'Suite 1 Hab', area: '65 m²', habs: '1 Hab · 1 Baño', precio: 'US$150,000', plano_url: '', desc: 'Balcón privado.' }];
    } else if (type === 'amenidades') {
      newB.items = ['Piscina infinita', 'Gym & Wellness', 'Seguridad 24/7'];
    } else if (type === 'plan_pago') {
      newB.steps = [{ pct: 'US$3,000', title: 'Reserva', desc: 'Inmediata' }, { pct: '20%', title: 'Inicial', desc: '30 días' }, { pct: '80%', title: 'Entrega', desc: 'Contra entrega' }];
    } else if (type === 'distancias') {
      newB.points = [{ place: 'Playa Bávaro', time: '5 min' }, { place: 'Aeropuerto PUJ', time: '15 min' }];
    } else if (type === 'galeria') {
      newB.images = [];
    } else if (type === 'editorial') {
      newB.heading = 'Visión del Desarrollo';
      newB.content = '';
    }
    blocksState.push(newB);
    renderContainers();
  }

  function deleteBlock(idx) {
    if (confirm('¿Eliminar este contenedor?')) {
      blocksState.splice(idx, 1);
      renderContainers();
    }
  }

  function moveBlock(idx, dir) {
    const target = idx + dir;
    if (target < 0 || target >= blocksState.length) return;
    const temp = blocksState[idx];
    blocksState[idx] = blocksState[target];
    blocksState[target] = temp;
    renderContainers();
  }

  function updateBlockField(bIdx, field, val) {
    blocksState[bIdx][field] = val;
    syncHiddenJson();
  }

  function addMetricItem(bIdx) {
    blocksState[bIdx].items = blocksState[bIdx].items || [];
    blocksState[bIdx].items.push({ label: 'Nuevo dato', value: 'Valor', sub: 'Detalle' });
    renderContainers();
  }

  function addUnitItem(bIdx) {
    blocksState[bIdx].units = blocksState[bIdx].units || [];
    blocksState[bIdx].units.push({ name: 'Nueva Tipología', area: '80 m²', habs: '2 Habs', precio: 'US$200,000', plano_url: '', desc: '' });
    renderContainers();
  }

  function addPaymentStep(bIdx) {
    blocksState[bIdx].steps = blocksState[bIdx].steps || [];
    blocksState[bIdx].steps.push({ pct: '10%', title: 'Nuevo hito', desc: 'Descripción' });
    renderContainers();
  }

  function addDistancePoint(bIdx) {
    blocksState[bIdx].points = blocksState[bIdx].points || [];
    blocksState[bIdx].points.push({ place: 'Punto de interés', time: '10 min' });
    renderContainers();
  }

  function removeSubItem(bIdx, arrayName, subIdx) {
    if (blocksState[bIdx][arrayName]) {
      blocksState[bIdx][arrayName].splice(subIdx, 1);
      renderContainers();
    }
  }

  function bItemsInput(bIdx, itIdx, field, val) {
    blocksState[bIdx].items[itIdx][field] = val;
    syncHiddenJson();
  }

  function bUnitInput(bIdx, uIdx, field, val) {
    blocksState[bIdx].units[uIdx][field] = val;
    syncHiddenJson();
  }

  function bStepInput(bIdx, stIdx, field, val) {
    blocksState[bIdx].steps[stIdx][field] = val;
    syncHiddenJson();
  }

  function bPointInput(bIdx, ptIdx, field, val) {
    blocksState[bIdx].points[ptIdx][field] = val;
    syncHiddenJson();
  }

  function bAmenidadesInput(bIdx, text) {
    blocksState[bIdx].items = text.split(',').map(s => s.trim()).filter(Boolean);
    syncHiddenJson();
  }

  function bGaleriaInput(bIdx, text) {
    blocksState[bIdx].images = text.split('\n').map(s => s.trim()).filter(Boolean);
    syncHiddenJson();
  }

  function syncHiddenJson() {
    const jsonField = document.getElementById('bloquesJson');
    if (jsonField) {
      jsonField.value = JSON.stringify(blocksState);
    }
  }

  // Live Preview Renderer
