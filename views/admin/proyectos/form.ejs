    ];
  }

  function switchTab(tabId) {
    document.querySelectorAll('.builder-tab').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    
    event.target.closest('.builder-tab').classList.add('active');
    document.getElementById('tab-' + tabId).classList.add('active');
  }

  // Render Visual Builder Containers
  function renderContainers() {
    const list = document.getElementById('containersList');
    if (!list) return;

    if (blocksState.length === 0) {
      list.innerHTML = `
        <div class="card" style="text-align:center;padding:36px;color:var(--gray)">
          <i data-lucide="layout-grid" style="width:36px;height:36px;opacity:0.4;margin-bottom:8px"></i>
          <p>No hay bloques añadidos. Usa la barra superior para agregar contenedores Flexbox.</p>
        </div>
      `;
      if (window.lucide) lucide.createIcons();
      return;
    }

    list.innerHTML = blocksState.map((b, idx) => {
      let bodyHtml = '';

      if (b.type === 'metricas') {
        bodyHtml = `
          <div class="fb-controls-bar">
            <span><b>Orientación Flex:</b></span>
            <select onchange="updateBlockField(${idx}, 'flex_dir', this.value)" style="width:auto;padding:3px 8px;font-size:12px">
              <option value="row" ${b.flex_dir==='row'?'selected':''}>Fila (Horizontal Grid)</option>
              <option value="column" ${b.flex_dir==='column'?'selected':''}>Columna (Vertical Stack)</option>
            </select>
            <button type="button" class="btn sm" onclick="addMetricItem(${idx})" style="margin-left:auto">+ Añadir Métrica</button>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
            ${(b.items||[]).map((it, itIdx) => `
