<script>
  function switchSettingsTab(tab) {
    const tabs = ['logo', 'instagram', 'empresa', 'usuarios'];
    const buttons = document.querySelectorAll('.settings-tab-btn');
    
    tabs.forEach((t, i) => {
      const panel = document.getElementById(`tab-${t}`);
      if (panel) {
        if (t === tab) {
          panel.classList.add('active');
          if (buttons[i]) buttons[i].classList.add('active');
        } else {
          panel.classList.remove('active');
          if (buttons[i]) buttons[i].classList.remove('active');
        }
      }
    });

    window.location.hash = tab;
  }

  if (window.location.hash) {
    const hash = window.location.hash.replace('#', '');
    if (['logo', 'instagram', 'empresa', 'usuarios'].includes(hash)) {
      switchSettingsTab(hash);
    } else {
      switchSettingsTab('logo');
    }
  }

  /* User Management Modals & Filtering */
  function openCreateUserModal() {
    document.getElementById('createUserModal').classList.add('active');
  }

  function closeCreateUserModal() {
    document.getElementById('createUserModal').classList.remove('active');
  }

  function openEditUserModal(user) {
    document.getElementById('editUserForm').action = `/admin/ajustes/usuarios/${user.id}/editar`;
    document.getElementById('editUserTitleUsername').innerText = `@${user.usuario}`;
    document.getElementById('editUserNombre').value = user.nombre || '';
    document.getElementById('editUserUsername').value = user.usuario || '';
    document.getElementById('editUserEmail').value = user.email || '';
    document.getElementById('editUserCargo').value = user.cargo || '';
    document.getElementById('editUserTelefono').value = user.telefono || '';
    document.getElementById('editRoleSelect').value = user.rol || 'Asistente Operativo';
    document.getElementById('editUserEstado').value = user.estado || 'activo';

    let perms = [];
    try {
      perms = JSON.parse(user.permisos_json || '[]');
    } catch(e) { perms = []; }

    const checkboxes = document.querySelectorAll('#editPermsGrid input[type="checkbox"]');
    checkboxes.forEach(cb => {
      cb.checked = perms.includes(cb.value);
    });

    document.getElementById('editUserModal').classList.add('active');
  }

  function closeEditUserModal() {
    document.getElementById('editUserModal').classList.remove('active');
  }

  function toggleAllPerms(modalType, check) {
    const gridId = modalType === 'create' ? 'createPermsGrid' : 'editPermsGrid';
    const checkboxes = document.querySelectorAll(`#${gridId} input[type="checkbox"]`);
    checkboxes.forEach(cb => cb.checked = check);
  }

  function applyRolePreset(modalType, role) {
    const gridId = modalType === 'create' ? 'createPermsGrid' : 'editPermsGrid';
    const checkboxes = document.querySelectorAll(`#${gridId} input[type="checkbox"]`);
    
    let targetPerms = [];
    if (role.includes('Admin')) {
      targetPerms = ['expedientes', 'cotizaciones', 'propiedades', 'proyectos', 'blog', 'finanzas', 'ajustes', 'usuarios'];
    } else if (role.includes('Abogado')) {
      targetPerms = ['expedientes', 'cotizaciones', 'blog'];
    } else if (role.includes('Agrimensor')) {
      targetPerms = ['expedientes', 'cotizaciones', 'propiedades'];
    } else if (role.includes('Asesor')) {
      targetPerms = ['propiedades', 'proyectos', 'cotizaciones'];
    } else {
      targetPerms = ['expedientes', 'cotizaciones'];
    }

    checkboxes.forEach(cb => {
      cb.checked = targetPerms.includes(cb.value);
    });
  }

  function filterUsersTable() {
    const q = (document.getElementById('userSearchInput').value || '').toLowerCase();
    const roleFilter = (document.getElementById('userRoleFilter').value || '').toLowerCase();
    const rows = document.querySelectorAll('.user-row');

    rows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const username = row.getAttribute('data-username') || '';
      const email = row.getAttribute('data-email') || '';
      const role = row.getAttribute('data-role') || '';
      const cargo = row.getAttribute('data-cargo') || '';

      const matchesSearch = !q || name.includes(q) || username.includes(q) || email.includes(q) || cargo.includes(q);
      const matchesRole = !roleFilter || role.includes(roleFilter);

      if (matchesSearch && matchesRole) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  function handleFileSelected(input) {
    if (!input.files || !input.files[0]) return;
    const file = input.files[0];
    const previewContainer = document.getElementById('filePreviewContainer');
    const imgPreview = document.getElementById('tempImagePreview');
    const infoText = document.getElementById('fileInfoText');

    infoText.innerText = `${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
    const reader = new FileReader();

    reader.onload = function(e) {
      imgPreview.src = e.target.result;
      previewContainer.style.display = 'block';
    };
    reader.readAsDataURL(file);
  }

  const dropzone = document.getElementById('dropzone');
  if (dropzone) {
    ['dragenter', 'dragover'].forEach(eventName => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.add('dragover');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.remove('dragover');
      }, false);
    });

    dropzone.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      const files = dt.files;
      if (files && files.length > 0) {
        const fileInput = document.getElementById('logoFile');
        fileInput.files = files;
        handleFileSelected(fileInput);
      }
    });
  }
</script>

