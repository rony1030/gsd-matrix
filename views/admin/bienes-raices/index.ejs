<%- include('../partials/layout-start', {pageTitle:'Bienes Raíces', page}) %>
<% if(error){ %><p role="alert"><%= error %></p><a class="btn-add" href="/admin/bienes-raices">Reintentar</a><% }else{ %>
<div style="display:flex;gap:20px;align-items:center;margin-bottom:24px"><a class="btn-add" href="/admin/bienes-raices/propiedad">Nueva propiedad</a><span>Página <%= pageNumber+1 %></span></div>
<h2>Propiedades</h2><div class="table-card" style="overflow-x:auto"><table><thead><tr><th>Nombre</th><th>Destino</th><th>Operación</th><th>Precio</th><th>Publicación</th><th></th></tr></thead><tbody>
<% properties.forEach(p=>{ %><tr><td><%= p.title %></td><td><%= p.location %></td><td><%= p.operation %></td><td><%= p.currency %> <%= Number(p.price).toLocaleString('en-US') %></td><td><%= p.status %></td><td><a href="/admin/bienes-raices/propiedad?slug=<%= encodeURIComponent(p.slug) %>&p=<%= pageNumber %>">Editar</a></td></tr><% }) %>
</tbody></table></div><h2 style="margin-top:32px">Contactos del sitio inmobiliario</h2><div class="table-card" style="overflow-x:auto"><table><thead><tr><th>Nombre</th><th>Contacto</th><th>Propiedad</th><th>Mensaje</th><th>Estado</th></tr></thead><tbody>
<% leads.forEach(l=>{ %><tr><td><%= l.name %></td><td><%= l.email %><br><%= l.phone %></td><td><%= l.property_title || 'Consulta general' %></td><td style="max-width:300px;white-space:normal"><%= l.message %></td><td><form method="post" action="/admin/bienes-raices/lead"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= l.id %>"><select name="status" aria-label="Estado de <%= l.name %>"><% ['nuevo','contactado','calificado','cerrado'].forEach(s=>{ %><option <%= l.status===s?'selected':'' %>><%= s %></option><% }) %></select><button type="submit">Guardar</button></form></td></tr><% }) %>
<% if(!leads.length){ %><tr><td colspan="5">Todavía no hay contactos en esta página.</td></tr><% } %>
</tbody></table></div><div style="display:flex;gap:24px;margin-top:24px"><% if(pageNumber>0){ %><a href="?p=<%= pageNumber-1 %>">Anterior</a><% } %><% if(properties.length===100 || leads.length===100){ %><a href="?p=<%= pageNumber+1 %>">Siguiente</a><% } %></div>
<% } %>
<%- include('../partials/layout-end') %>
