<%- include('../../admin/partials/layout-start', { pageTitle: 'Nuevo Lead', page: 'leads' }) %>

<div style="margin-bottom:1.5rem;">
  <a href="/admin/leads" style="color:var(--gris-500);font-size:0.875rem;display:flex;align-items:center;gap:0.4rem;">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
    Volver a Leads
  </a>
</div>

<div style="max-width:600px;">
  <div class="admin-form-card">
    <h3>Crear Lead Manual</h3>
    <p style="font-size:0.85rem;color:var(--gris-500);margin-bottom:1.5rem;">Para registrar leads que llegaron por teléfono, WhatsApp u otro canal.</p>

    <form method="POST" action="/admin/leads/nuevo">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Nombre *</label>
          <input type="text" name="nombre" class="form-input" placeholder="Nombre completo" required>
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-input" placeholder="email@ejemplo.com">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Teléfono</label>
          <input type="tel" name="telefono" class="form-input" placeholder="809-000-0000">
        </div>
        <div class="form-group">
          <label class="form-label">Servicio</label>
          <select name="servicio" class="form-select">
            <option value="">Seleccionar...</option>
            <option value="Legal">Legal</option>
            <option value="Inmobiliaria">Inmobiliaria</option>
            <option value="Agrimensura">Agrimensura</option>
            <option value="Otro">Otro</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Mensaje / Notas</label>
        <textarea name="mensaje" class="form-textarea" placeholder="Detalles del cliente..."></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Estado</label>
          <select name="estado" class="form-select">
            <option value="nuevo">Nuevo</option>
            <option value="contactado">Contactado</option>
            <option value="cerrado">Cerrado</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Origen</label>
          <select name="origen" class="form-select">
            <option value="manual">Manual</option>
            <option value="whatsapp">WhatsApp</option>
            <option value="telefono">Teléfono</option>
            <option value="referido">Referido</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn-submit" style="margin-top:0.5rem;">Guardar Lead</button>
    </form>
  </div>
</div>

<%- include('../../admin/partials/layout-end') %>
