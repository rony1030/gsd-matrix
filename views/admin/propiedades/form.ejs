<%- include('../../admin/partials/layout-start', { pageTitle: isEdit ? 'Editar Propiedad' : 'Nueva Propiedad', page: 'propiedades' }) %>

<div style="margin-bottom:1.5rem;">
  <a href="/admin/propiedades" style="color:var(--gris-500);font-size:0.875rem;display:flex;align-items:center;gap:0.4rem;">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
    Volver a Propiedades
  </a>
</div>

<% if (error) { %>
<div class="alert-error" style="margin-bottom:1.5rem;display:flex;align-items:center;gap:0.5rem;">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
  <span><%= error %></span>
</div>
<% } %>

<form method="POST" action="/admin/propiedades/<%= isEdit ? prop.id + '/editar' : 'nueva' %>" enctype="multipart/form-data">

  <div class="admin-form-grid">

    <!-- Main form -->
    <div>
      <div class="admin-form-card">
        <h3>Información de la Propiedad</h3>

        <div class="form-group">
          <label class="form-label">Título *</label>
          <input type="text" name="titulo" class="form-input" value="<%= isEdit ? prop.titulo : '' %>" placeholder="Ej: Apartamento 3 hab. en Piantini" required>
        </div>

        <div class="form-group">
          <label class="form-label">Descripción</label>
          <textarea name="descripcion" class="form-textarea" style="min-height:130px;" placeholder="Describe la propiedad..."><%= isEdit ? prop.descripcion || '' : '' %></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Precio</label>
            <input type="number" name="precio" class="form-input" value="<%= isEdit ? prop.precio || '' : '' %>" placeholder="0" min="0" step="0.01">
          </div>
          <div class="form-group">
            <label class="form-label">Moneda</label>
            <select name="moneda" class="form-select">
              <option value="USD" <%= (!isEdit || prop.moneda === 'USD') ? 'selected' : '' %>>USD (Dólares)</option>
              <option value="DOP" <%= (isEdit && prop.moneda === 'DOP') ? 'selected' : '' %>>DOP (Pesos)</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Tipo</label>
            <select name="tipo" class="form-select">
              <option value="">Seleccionar...</option>
              <% ['Apartamento','Casa','Villa','Terreno','Local Comercial','Oficina','Penthouse'].forEach(t => { %>
              <option value="<%= t %>" <%= (isEdit && prop.tipo === t) ? 'selected' : '' %>><%= t %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Ubicación</label>
            <input type="text" name="ubicacion" class="form-input" value="<%= isEdit ? prop.ubicacion || '' : '' %>" placeholder="Ej: Piantini, Santo Domingo">
          </div>
        </div>
      </div>

      <!-- Imágenes -->
      <div class="admin-form-card">
        <h3>Imágenes (máx. 5)</h3>
        <input type="file" id="imagenes" name="imagenes" class="form-input" multiple accept="image/*" style="padding:0.5rem;" onchange="updateCoverPreview(this)">
        <div id="img-preview-grid" class="img-preview-grid">
          <% if (isEdit) { %>
            <% let imgs = []; try { imgs = JSON.parse(prop.imagenes || '[]'); } catch(e) {} %>
            <% imgs.forEach(img => { %>
            <div class="img-preview-item">
              <img src="<%= img %>" alt="">
              <input type="hidden" name="imagenes_existentes" value="<%= img %>">
            </div>
            <% }) %>
          <% } %>
        </div>
        <p style="font-size:0.75rem;color:var(--gris-500);margin-top:0.5rem;">JPG, PNG o WebP. Máx 5MB por imagen. La primera foto se usa como portada.</p>
      </div>

      <!-- SEO Panel -->
      <div class="admin-form-card">
        <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e2e8f0;padding-bottom:12px;margin-bottom:18px;">
          <div>
            <h3 style="margin:0;">🔍 Optimización & Puntuador SEO</h3>
            <p style="font-size:0.8rem;color:var(--gris-500);margin:4px 0 0;">Toma automáticamente la foto de portada del proyecto para Google SERP y OpenGraph.</p>
          </div>
          <div id="seoScoreBadge" class="seo-score-badge score-poor" style="display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:20px;font-weight:700;font-size:0.9rem;">
            <span>Puntaje SEO:</span>
            <span id="seoScoreText">0/100</span>
          </div>
        </div>

        <input type="hidden" name="seo_score" id="seo_score_input" value="<%= isEdit ? (prop.seo_score || 0) : 0 %>">

        <div class="form-group">
          <label class="form-label">Meta Title (Título en Google)</label>
          <input type="text" id="meta_title" name="meta_title" class="form-input"
                 value="<%= isEdit ? (prop.meta_title || prop.titulo || '') : '' %>"
                 placeholder="Ej: Villa de lujo en venta en Casa de Campo | GSD" maxlength="70">
          <div class="char-counter" id="meta-title-count">0/60 caracteres</div>
        </div>

        <div class="form-group">
          <label class="form-label">Meta Description (Limitador a 160 caracteres) *</label>
          <textarea id="meta_description" name="meta_description" class="form-textarea" style="min-height:80px;"
                    placeholder="Descripción atractiva para buscadores..." maxlength="160"><%= isEdit ? (prop.meta_description || prop.descripcion?.substring(0,160) || '') : '' %></textarea>
          <div class="char-counter" id="meta-desc-count">0/160 caracteres (Máximo exacto 160)</div>
        </div>

        <div class="form-group">
          <label class="form-label">Palabras Clave (Keywords)</label>
          <input type="text" id="keywords" name="keywords" class="form-input"
                 value="<%= isEdit ? (prop.keywords || '') : '' %>"
                 placeholder="villa la romana, inversion inmobiliaria rd, casa de campo">
        </div>

        <!-- Google Preview -->
        <div style="margin-top:16px;">
          <label class="form-label" style="margin-bottom:0.75rem;">Vista previa en Google</label>
          <div class="seo-preview">
            <div class="seo-preview-url">gsd-bienes-raices.com › propiedades › <span id="slug-preview"><%= isEdit ? (prop.slug || 'propiedad') : 'propiedad' %></span></div>
            <div class="seo-preview-title" id="seo-title-preview"><%= isEdit ? (prop.meta_title || prop.titulo || 'Título de la propiedad') : 'Título de la propiedad' %></div>
            <div class="seo-preview-desc" id="seo-desc-preview"><%= isEdit ? (prop.meta_description || 'Descripción breve de la propiedad para Google...') : 'Descripción breve de la propiedad para Google...' %></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div>
      <div class="admin-form-card">
        <h3>Publicación</h3>
        <div class="form-group">
          <label class="form-label">Estado</label>
          <select name="estado" class="form-select">
            <option value="disponible" <%= (!isEdit || prop.estado === 'disponible') ? 'selected' : '' %>>Disponible</option>
            <option value="en_negociacion" <%= (isEdit && prop.estado === 'en_negociacion') ? 'selected' : '' %>>En Negociación</option>
            <option value="vendida" <%= (isEdit && prop.estado === 'vendida') ? 'selected' : '' %>>Vendida</option>
          </select>
        </div>
        <div class="form-group">
          <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;">
            <input type="checkbox" name="destacada" value="1" <%= (isEdit && prop.destacada) ? 'checked' : '' %>
                   style="width:16px;height:16px;accent-color:var(--verde);">
            <span class="form-label" style="margin:0;">Propiedad destacada</span>
          </label>
        </div>
        <button type="submit" class="btn-submit" style="margin-top:1rem;">
          <%= isEdit ? 'Guardar Cambios' : 'Crear Propiedad' %>
        </button>
      </div>
    </div>
  </div>
</form>

<script>
const titleInput = document.querySelector('input[name="titulo"]');
const descInput = document.querySelector('textarea[name="descripcion"]');
const metaTitleInput = document.getElementById('meta_title');
const metaDescInput = document.getElementById('meta_description');
const keywordsInput = document.getElementById('keywords');

function updateCoverPreview(input) {
  analyzePropertySeo();
}

titleInput?.addEventListener('input', function() {
  if (!metaTitleInput.dataset.manual) {
    metaTitleInput.value = this.value;
  }
  document.getElementById('seo-title-preview').textContent = metaTitleInput.value || this.value || 'Título de la propiedad';
  analyzePropertySeo();
});

metaTitleInput?.addEventListener('input', function() {
  this.dataset.manual = '1';
  document.getElementById('seo-title-preview').textContent = this.value || titleInput.value || 'Título de la propiedad';
  analyzePropertySeo();
});

metaDescInput?.addEventListener('input', function() {
  document.getElementById('seo-desc-preview').textContent = this.value || 'Descripción breve de la propiedad para Google...';
  analyzePropertySeo();
});

descInput?.addEventListener('input', function() {
  if (!metaDescInput.value) {
    metaDescInput.value = this.value.substring(0, 155);
  }
  analyzePropertySeo();
});

keywordsInput?.addEventListener('input', analyzePropertySeo);

function analyzePropertySeo() {
  let score = 0;
  const title = (metaTitleInput?.value || titleInput?.value || '').trim();
  const desc = (metaDescInput?.value || descInput?.value || '').trim();
  const kw = (keywordsInput?.value || '').trim();

  // 1. Title
  if (title.length >= 30 && title.length <= 65) score += 30;
  else if (title.length > 0) score += 15;
  document.getElementById('meta-title-count').textContent = title.length + '/60 caracteres';

  // 2. Desc (max 160)
  if (desc.length >= 80 && desc.length <= 160) score += 35;
  else if (desc.length > 0) score += 15;
  document.getElementById('meta-desc-count').textContent = desc.length + '/160 caracteres (Máximo exacto 160)';

  // 3. Keywords
  if (kw.length > 4) score += 20;

  // 4. Has photo
  const hasImages = document.querySelectorAll('.img-preview-item').length > 0 || (document.getElementById('imagenes')?.files?.length || 0) > 0;
  if (hasImages) score += 15;

  document.getElementById('seo_score_input').value = score;
  const badge = document.getElementById('seoScoreBadge');
  const scoreText = document.getElementById('seoScoreText');
  scoreText.textContent = score + '/100';
  badge.className = 'seo-score-badge ' + (score >= 80 ? 'score-good' : score >= 50 ? 'score-medium' : 'score-poor');
}

setTimeout(analyzePropertySeo, 200);
</script>

<%- include('../../admin/partials/layout-end') %>
