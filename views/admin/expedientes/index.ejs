function switchTplEditTab(tabName) {
  const tabs = ['general', 'vision', 'etapas', 'docs'];
  const buttons = document.querySelectorAll('#tplEditorTabs button');
  
  tabs.forEach((t, i) => {
    const pane = document.getElementById(`tplTab${t.charAt(0).toUpperCase() + t.slice(1)}`);
    if (pane) {
      if (t === tabName) {
        pane.classList.remove('hidden');
        if (buttons[i]) buttons[i].classList.add('on');
      } else {
        pane.classList.add('hidden');
        if (buttons[i]) buttons[i].classList.remove('on');
      }
    }
  });
  icons();
}

