                  </div>
                </div>
                <div style="display:flex;gap:6px;align-items:center;margin-left:12px;flex-shrink:0;">
                  <span class="tag ${d.st==='ok'?'proc':'wait'}">${d.st==='ok'?'Listo':'Pendiente'}</span>
                  <button type="button" class="btn sm" onclick="previewDocModal('${d.expId}', '${encodeURIComponent(d.name)}', '${encodeURIComponent(d.cat)}')" title="Ver PDF">
