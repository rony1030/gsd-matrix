let calDate = new Date();

function changeCalMonth(delta) {
  calDate.setMonth(calDate.getMonth() + delta);
  renderCal();
}

function setCalToday() {
  calDate = new Date();
  renderCal();
}

const MONTH_NAMES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
const DAY_HEADERS = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];

function renderCal() {
  const year = calDate.getFullYear();
  const month = calDate.getMonth();
  
  // All active tasks with due dates
  const allT = allTasks().filter(t => t.due && t.st !== 'done' && t.st !== 'na');
  const tasksSorted = [...allT].sort((a, b) => a.due > b.due ? 1 : -1);
  
  // Group tasks by date YYYY-MM-DD
  const tasksByDate = {};
  allT.forEach(t => {
    (tasksByDate[t.due] = tasksByDate[t.due] || []).push(t);
  });

  // Month calculations (Monday = 0, Sunday = 6)
  const firstDay = new Date(year, month, 1).getDay();
  const offset = (firstDay + 6) % 7;
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const daysInPrevMonth = new Date(year, month, 0).getDate();
  const totalCells = Math.ceil((offset + daysInMonth) / 7) * 7;

  // Month tasks count
  const monthPrefix = `${year}-${String(month + 1).padStart(2, '0')}`;
  const monthTasksCount = allT.filter(t => t.due.startsWith(monthPrefix)).length;

  let gridHTML = '';
  // Day headers
  gridHTML += DAY_HEADERS.map(d => `<div class="cal-day-head">${d}</div>`).join('');

  // Calendar cells
  for (let i = 0; i < totalCells; i++) {
    if (i < offset) {
      // Prev month trailing
      const dNum = daysInPrevMonth - offset + i + 1;
      gridHTML += `<div class="cal-cell other-month"><div class="cal-num">${dNum}</div></div>`;
    } else if (i < offset + daysInMonth) {
      // Current month day
      const dNum = i - offset + 1;
      const dStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(dNum).padStart(2, '0')}`;
      const isToday = (dStr === TODAY);
      const dayTasks = tasksByDate[dStr] || [];

      gridHTML += `
        <div class="cal-cell ${isToday ? 'today' : ''}">
          <div class="cal-num">${dNum}</div>
          <div class="cal-events">
            ${dayTasks.map(t => {
              const diff = days(t.due);
              let pillCls = 'normal';
              if (diff < 0) pillCls = 'late';
              else if (diff === 0) pillCls = 'today';
              else if (diff <= 3) pillCls = 'soon';
              const divName = (TPL[t.e.svc] || TPL.deslinde).div || 'Legal';
              return `
                <div class="cal-pill ${pillCls}" onclick="openExp('${t.e.id}','tareas')" title="${t.name} (${t.e.id} - ${t.e.cliente?.nombre || 'Cliente'}) · Resp: ${t.who}">
                  ● ${t.name}
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    } else {
      // Next month leading
      const dNum = i - (offset + daysInMonth) + 1;
      gridHTML += `<div class="cal-cell other-month"><div class="cal-num">${dNum}</div></div>`;
    }
  }

  // Right side agenda
  const agendaHTML = tasksSorted.length ? tasksSorted.slice(0, 10).map(t => {
    const diff = days(t.due);
    const [y, m, d] = t.due.split('-');
    const mShort = M[parseInt(m) - 1]?.toUpperCase() || 'MES';
    const isLate = diff < 0;
    const isToday = diff === 0;
    const divName = (TPL[t.e.svc] || TPL.deslinde).div || 'Legal';

    return `
      <div class="cal-agenda-item" onclick="openExp('${t.e.id}','tareas')" style="cursor:pointer">
