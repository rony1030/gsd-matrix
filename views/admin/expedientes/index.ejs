                    </div>
                    <h4 style="margin:6px 0 3px 0;font-size:15px;color:#1e293b;font-weight:600;">${tpl.nombre}</h4>
                    <div style="font-size:12px;color:var(--gray);">
                      <span>Inicio: ${fd(e.inicio)} · Fin estimado: ${fd(e.fin)} · Responsable: ${e.resp}</span>
                    </div>
                  </div>
                  <div style="text-align:right;">
                    <b style="font-size:15px;color:var(--navy);">${e.mon || 'US$'}${fmt(e.honorario || 0)}</b>
                    <div style="margin-top:8px;">
                      <button type="button" class="btn sm" onclick="openExp('${e.id}')">
                        <i data-lucide="arrow-up-right"></i>Abrir Expediente
                      </button>
                    </div>
                  </div>
                </div>
                <div style="margin-top:14px;display:flex;align-items:center;gap:12px;">
                  <span style="font-size:11.5px;color:var(--gray);">Progreso:</span>
                  <div class="bar" style="flex:1;height:7px;"><i style="width:${p.pct}%;"></i></div>
                  <span style="font-size:11.5px;font-weight:700;color:var(--navy);">${p.pct}% (${p.done}/${p.total} tareas)</span>
                </div>
