                      <span>Expediente: <b style="color:var(--navy);">${d.expId}</b></span>
                      <span>·</span>
                      <span>Categoría: <span class="tag ${d.cat==='CLIENTE'?'wait':d.cat==='INMUEBLE'?'proc':d.cat==='TÉCNICO'?'rev':'lo'}" style="font-size:10px;padding:1px 6px;">${d.cat}</span></span>
                      ${d.size ? `<span>· ${d.size}</span>` : ''}
