  b.innerHTML=`<div class="card">
    <div class="ch">
      <h2>Documentos del expediente <small style="color:var(--gray);font-weight:400">· ${e.docs.filter(d=>d.st==='ok').length} de ${e.docs.length} listos</small></h2>
      <div style="display:flex;gap:8px">
        <button class="btn sm" onclick="openM('mDocNew')"><i data-lucide="plus"></i>Agregar requisito</button>
        <button class="btn sm p" onclick="uploadDocQuick()"><i data-lucide="upload"></i>Subir archivo</button>
      </div>
    </div>
    <div class="filters">${[['all','Todos'],['miss','Pendientes'],['ok','Completados'],['late','Esperando cliente']].map(x=>`<button class="${docF===x[0]?'on':''}" onclick="docF='${x[0]}';renderTab()">${x[1]}</button>`).join('')}</div>
    ${cats.map(c=>{
      const ds=e.docs.map((d,i)=>({...d,i})).filter(d=>d.cat===c&&f(d));
      if(!ds.length)return '';
      return `<div class="cat" style="font-weight:600;font-size:11px;letter-spacing:1px;color:var(--gray);margin:14px 0 6px;text-transform:uppercase">${c}</div>
      ${ds.map(d=>`
        <div class="doc" style="display:flex;align-items:center;justify-content:space-between;padding:10px 12px;border:1px solid var(--line);border-radius:8px;margin-bottom:6px;background:#fff">
          <div style="display:flex;align-items:center;gap:10px;flex:1;min-width:0">
            <div class="ic ${d.st==='ok'?'':'miss'}" style="width:34px;height:34px;border-radius:6px;background:${d.st==='ok'?'var(--green-l)':'var(--red-l)'};color:${d.st==='ok'?'var(--green)':'var(--red)'};display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <i data-lucide="${d.st==='ok'?'file-check':'file'}"></i>
            </div>
            <div style="min-width:0;flex:1">
              <b style="font-size:13px;color:var(--navy);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${d.st==='ok'?(d.file||d.name):d.name}</b>
              <small style="color:var(--gray);font-size:11px">${d.st==='ok'?`${d.size||'PDF'} · Subido ${fd(d.date)} por ${d.who?.split(' ')[0]||'GSD'}`:`Aporta: ${d.by==='cliente'?'Cliente':'GSD'} · ${d.st==='wait'?'Solicitado':'Pendiente'}`}</small>
            </div>
          </div>
          <div class="acts" style="display:flex;gap:6px;align-items:center">
            ${d.st==='ok'?`
              <span class="tag proc">Listo</span>
              <label style="font-size:11px;color:var(--gray);display:inline-flex;gap:4px;align-items:center;cursor:pointer" title="Visible para cliente">
                <input type="checkbox" style="width:auto" ${d.share?'checked':''} onchange="cur.docs[${d.i}].share=this.checked;save();toast(this.checked?'Compartido':'Ocultado')"> Compartir
              </label>
              ${d.dataUrl?`<a class="btn sm" href="${d.dataUrl}" download="${d.file||'documento'}" target="_blank"><i data-lucide="download"></i>Descargar</a>`:`<button class="btn sm" onclick="toast('Descargando archivo...')"><i data-lucide="download"></i>Descargar</button>`}
            `:`
              <span class="tag ${d.st==='wait'?'wait':'late'}">${d.st==='wait'?'Solicitado':'Pendiente'}</span>
              <button class="btn sm" onclick="triggerDocUpload(${d.i})"><i data-lucide="upload"></i>Subir</button>
              <button class="btn sm p" onclick="docSt(${d.i},'ok')">Marcar Listo</button>
            `}
          </div>
        </div>
      `).join('')}
    `}).join('')}
  </div>`;
}

function triggerDocUpload(index){
  const inp=document.createElement('input');
  inp.type='file';
  inp.accept='.pdf,image/*,.doc,.docx';
  inp.onchange=()=>{
    const f=inp.files[0];
    if(!f) return;
    const r=new FileReader();
    r.onload=()=>{
      const d=cur.docs[index];
      d.st='ok';
      d.file=f.name;
      d.size=(f.size/1048576).toFixed(2)+' MB';
      d.date=TODAY;
      d.who='Esteban Mejía';
      d.dataUrl=r.result;
      log(cur,`Documento "${d.name}" cargado (${f.name}).`);
      save();
      renderTab();
      toast('Documento cargado con éxito');
    };
    r.readAsDataURL(f);
  };
  inp.click();
}

function uploadDocQuick(){
  const inp=document.createElement('input');
  inp.type='file';
  inp.accept='.pdf,image/*,.doc,.docx';
  inp.onchange=()=>{
    const f=inp.files[0];
    if(!f) return;
    const r=new FileReader();
    r.onload=()=>{
      cur.docs.push({
        cat:'ADICIONAL',
        name:f.name.replace(/\.[^/.]+$/,""),
        by:'gsd',
        st:'ok',
        file:f.name,
        size:(f.size/1048576).toFixed(2)+' MB',
        date:TODAY,
        who:'Esteban Mejía',
        dataUrl:r.result
      });
      log(cur,`Documento adicional subido: ${f.name}.`);
      save();
      renderTab();
      toast('Documento añadido al expediente');
    };
    r.readAsDataURL(f);
  };
  inp.click();
}

function saveNewDocModal(){
  const name=$('newDocName').value.trim();
  if(!name){ toast('Escribe el nombre del documento'); return; }
  const cat=$('newDocCat').value;
  const by=$('newDocBy').value;
  const fileInput=$('newDocFile');
  const f=fileInput.files[0];
  
  if(f){
    const r=new FileReader();
    r.onload=()=>{
      cur.docs.push({
        cat,name,by,st:'ok',
        file:f.name,
        size:(f.size/1048576).toFixed(2)+' MB',
        date:TODAY,who:'Esteban Mejía',
        dataUrl:r.result
      });
      log(cur,`Nuevo documento registrado: ${name}.`);
      save();closeM('mDocNew');renderTab();toast('Documento guardado');
    };
    r.readAsDataURL(f);
  } else {
    cur.docs.push({cat,name,by,st:'miss',file:'',size:'',date:'',who:'Esteban Mejía'});
    log(cur,`Requisito documental añadido: ${name}.`);
    save();closeM('mDocNew');renderTab();toast('Requisito documental añadido');
  }
}

function docSt(i,st){
  const d=cur.docs[i];
  d.st=st;
  if(st==='ok'){
    d.file=d.name.replace(/ /g,'_')+'.pdf';
    d.size='1.0 MB';
    d.date=TODAY;
    d.who='Esteban Mejía';
    log(cur,`Documento "${d.name}" validado.`);
  } else {
    log(cur,`Documento "${d.name}" solicitado al cliente.`);
  }
  save();renderTab();toast(st==='ok'?'Documento verificado':'Solicitud registrada');
}

