<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GSD Expedientes — Geosolutions Source Dominicana</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/lucide@0.460.0/dist/umd/lucide.min.js"></script>
<style>
:root{--navy:#1A3A52;--green:#4A9B6F;--green-l:#E8F4EF;--gray:#6B7280;--line:#E5E7EB;--bg:#F9FAFB;--white:#fff;--red:#C0392B;--red-l:#FBEAEA;--amber:#B7791F;--amber-l:#FDF3E1;--blue:#2B6CB0;--blue-l:#E8F0FA;--ink:#1F2937}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Poppins',system-ui,sans-serif;font-size:13px;color:var(--ink);background:var(--bg);height:100vh;display:grid;grid-template-columns:250px 1fr;grid-template-rows:56px 1fr;overflow:hidden;margin:0;padding:0}
button{font:inherit;cursor:pointer}
input,select,textarea{font:inherit;font-size:13px;padding:8px 10px;border:1px solid var(--line);border-radius:6px;background:#fff;width:100%;color:var(--ink)}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 3px rgba(74,155,111,.15)}
textarea{min-height:80px;resize:vertical}
i[data-lucide],svg.lucide{width:16px;height:16px;vertical-align:-3px}
.hdr{grid-column:2;grid-row:1;height:56px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 24px;position:relative;z-index:10;box-sizing:border-box}
.hdr-search{position:absolute;left:50%;transform:translateX(-50%);width:380px;max-width:calc(100% - 460px);display:flex;align-items:center}
.hdr-search i{position:absolute;left:11px;color:var(--gray);width:15px;height:15px;pointer-events:none}
.hdr-search input.search{width:100%;padding:7px 12px 7px 34px;font-size:12.5px;border:1px solid var(--line);border-radius:7px;background:var(--bg);color:var(--ink);transition:all .15s}
.hdr-search input.search:focus{background:#fff;border-color:var(--green);box-shadow:0 0 0 3px rgba(74,155,111,.15);outline:none}
.hdr-actions{margin-left:auto;display:flex;align-items:center;gap:12px}
.hdr .quoter{border:1px solid var(--line);background:#fff;color:var(--navy);padding:7px 12px;border-radius:6px;font-weight:500;display:flex;align-items:center;gap:6px;font-size:12px;text-decoration:none;white-space:nowrap}
.hdr .user{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink);white-space:nowrap}
.hdr .av{width:30px;height:30px;border-radius:50%;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:11px}
.side{grid-column:1;grid-row:1/3;height:100vh;background:#fff;border-right:1px solid var(--line);display:flex;flex-direction:column;overflow:hidden;z-index:20}
.side .logo{height:56px;padding:0 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;box-sizing:border-box}
.side .logo a{display:flex;align-items:center;gap:8px;text-decoration:none;width:100%}
.side .logo img{max-height:36px;max-width:130px;width:auto;object-fit:contain;display:block}
.side .logo .prod{font-size:9.5px;letter-spacing:1.5px;color:var(--green);font-weight:600;white-space:nowrap;text-transform:uppercase}
.side .grp{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--gray);padding:14px 20px 4px;font-weight:600}
.side nav{flex:1;overflow-y:auto;scrollbar-width:none;-ms-overflow-style:none}
.side nav::-webkit-scrollbar{display:none}
.side a{display:flex;align-items:center;gap:10px;padding:8px 20px;color:var(--navy);font-weight:500;cursor:pointer;font-size:12.5px;border-left:3px solid transparent;text-decoration:none;transition:background .15s,border-color .15s,color .15s;line-height:1.3}
.side a:hover{background:var(--bg)}
.side a.on{background:var(--green-l);border-left-color:var(--green);color:var(--green)}
.side a .n{margin-left:auto;background:var(--red);color:#fff;font-size:10px;padding:1px 7px;border-radius:10px}
.side .me{padding:12px 20px;border-top:1px solid var(--line);display:flex;gap:10px;align-items:center;box-sizing:border-box}
.side .me .av{width:34px;height:34px;border-radius:50%;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:600;position:relative}
.side .me .av:after{content:'';position:absolute;right:-1px;bottom:-1px;width:10px;height:10px;border-radius:50%;background:var(--green);border:2px solid #fff}
.side .me b{display:block;font-weight:500;color:var(--navy);font-size:12.5px}
.side .me span{font-size:11px;color:var(--gray)}
.main{grid-column:2;grid-row:2;height:calc(100vh - 56px);overflow-y:auto;padding:26px 30px;background:var(--bg);box-sizing:border-box}
.view{display:none}.view.on{display:block}
h1{font-size:22px;font-weight:600;color:var(--navy)}
h2{font-size:15px;font-weight:600;color:var(--navy)}
.sub{color:var(--gray);margin-top:3px}
.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin:20px 0}
.kpi{background:#fff;border:1px solid var(--line);border-radius:10px;padding:16px 18px}
.kpi .l{font-size:11.5px;color:var(--gray);display:flex;align-items:center;gap:6px}
.kpi .v{font-size:26px;font-weight:600;color:var(--navy);margin-top:6px}
.kpi.warn .v{color:var(--red)}
.card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:18px 20px;margin-bottom:16px}
.card .ch{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.alerts{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.alert{border:1px solid var(--line);border-radius:8px;padding:12px 14px;display:flex;gap:10px;background:#fff;cursor:pointer}
.alert .dot{width:10px;height:10px;border-radius:50%;margin-top:4px;flex-shrink:0}
.alert b{display:block;font-weight:500;color:var(--navy)}
.alert small{color:var(--gray);display:block;font-size:11.5px}
.dot.r{background:var(--red)}.dot.y{background:#D69E2E}.dot.o{background:#DD6B20}.dot.b{background:var(--blue)}.dot.g{background:var(--green)}.dot.k{background:#4B5563}
table{width:100%;border-collapse:collapse}
th{text-align:left;font-size:11px;color:var(--gray);font-weight:500;padding:8px 10px;border-bottom:1px solid var(--line);text-transform:uppercase;letter-spacing:.5px}
td{padding:11px 10px;border-bottom:1px solid var(--line);vertical-align:middle}
tr.row:hover td{background:var(--bg);cursor:pointer}
.bar{height:6px;background:var(--line);border-radius:3px;overflow:hidden;min-width:80px}
.bar i{display:block;height:100%;background:var(--green)}
.tag{display:inline-block;padding:2px 9px;border-radius:10px;font-size:10.5px;font-weight:500;white-space:nowrap}
.tag.proc{background:var(--green-l);color:#2F6B4A}.tag.rev{background:var(--blue-l);color:var(--blue)}.tag.wait{background:var(--amber-l);color:var(--amber)}.tag.done{background:#EEF2F5;color:var(--navy)}.tag.late{background:var(--red-l);color:var(--red)}.tag.hi{background:var(--red-l);color:var(--red)}.tag.med{background:var(--amber-l);color:var(--amber)}.tag.lo{background:#EEF2F5;color:var(--gray)}
.btn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:#fff;color:var(--navy);padding:8px 14px;border-radius:6px;font-weight:500;font-size:12.5px}
.btn:hover{background:var(--bg)}
.btn.p{background:var(--green);border-color:var(--green);color:#fff}.btn.p:hover{background:#3E8A5F}
.btn.sm{padding:5px 9px;font-size:11.5px}
.btn.ghost{border-color:transparent;color:var(--gray)}
.link{color:var(--green);font-weight:500;cursor:pointer;font-size:12.5px}
.exp-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}
.exp-head .ref{font-size:11.5px;color:var(--gray);letter-spacing:1px}
.exp-head .cli{font-size:14px;color:var(--ink);margin-top:2px}
.exp-head .acts{display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
.prog{display:grid;grid-template-columns:2fr 1fr 1fr 1fr 1fr 1fr;gap:16px;align-items:center;margin-top:18px}
.prog .big{font-size:26px;font-weight:600;color:var(--navy)}
.prog .bar{height:10px;margin:6px 0}
.prog .k{font-size:11px;color:var(--gray)}.prog .v{font-weight:500;color:var(--navy);font-size:12.5px}
.tabs{display:flex;gap:2px;border-bottom:1px solid var(--line);margin:22px 0 18px;overflow-x:auto}
.tabs button{border:0;background:none;padding:10px 14px;color:var(--gray);font-weight:500;border-bottom:2px solid transparent;white-space:nowrap}
.tabs button.on{color:var(--green);border-bottom-color:var(--green)}
.tab{display:none}.tab.on{display:block}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:16px}.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.kv{display:grid;grid-template-columns:150px 1fr;gap:6px 12px;font-size:12.5px}
.kv .k{color:var(--gray)}.kv .v{color:var(--ink);font-weight:500}
.kv input{padding:5px 8px;font-size:12.5px}
.map{height:180px;background:linear-gradient(0deg,transparent 24%,rgba(26,58,82,.06) 25%,rgba(26,58,82,.06) 26%,transparent 27%,transparent 74%,rgba(26,58,82,.06) 75%,rgba(26,58,82,.06) 76%,transparent 77%),linear-gradient(90deg,transparent 24%,rgba(26,58,82,.06) 25%,rgba(26,58,82,.06) 26%,transparent 27%,transparent 74%,rgba(26,58,82,.06) 75%,rgba(26,58,82,.06) 76%,transparent 77%);background-size:40px 40px;background-color:#EEF3F1;border-radius:8px;position:relative;margin-bottom:10px}
.map .pin{position:absolute;left:50%;top:45%;transform:translate(-50%,-100%);color:var(--red)}
.map .pin svg{width:28px;height:28px}
.map .poly{position:absolute;left:32%;top:26%;width:36%;height:44%;border:2px dashed var(--green);background:rgba(74,155,111,.12)}
.doc{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)}
.doc .ic{width:34px;height:34px;border-radius:6px;background:var(--bg);display:flex;align-items:center;justify-content:center;color:var(--navy)}
.doc .ic.miss{color:var(--gray);background:transparent;border:1px dashed var(--line)}
.doc b{display:block;font-weight:500;color:var(--navy)}
.doc small{color:var(--gray);font-size:11.5px}
.doc .acts{margin-left:auto;display:flex;gap:6px;align-items:center}
.cat{font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--gray);margin:16px 0 4px}
.filters{display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap}
.filters button{border:1px solid var(--line);background:#fff;padding:5px 11px;border-radius:14px;font-size:11.5px;color:var(--gray)}
.filters button.on{background:var(--navy);border-color:var(--navy);color:#fff}
.phase{margin-bottom:14px}
.phase .ph{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--line);font-weight:500;color:var(--navy)}
.phase .ph small{color:var(--gray);font-weight:400}
.task{display:grid;grid-template-columns:20px 1fr 130px 120px 110px 60px;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid #F1F3F5}
.task .t{font-weight:500}.task .t.done{text-decoration:line-through;color:var(--gray);font-weight:400}
.task select{padding:3px 6px;font-size:11.5px;border-radius:12px}
.task .who,.task .due{font-size:11.5px;color:var(--gray)}
.task .due.late{color:var(--red);font-weight:500}
.st-pend{color:var(--blue)}.st-proc{color:var(--amber)}.st-done{color:var(--green)}.st-block{color:var(--red)}.st-na{color:#4B5563}
.tl{display:flex;gap:0;margin:8px 0 18px}
.tl .s{flex:1;text-align:center;position:relative;cursor:pointer;padding:6px 4px}
.tl .s:before{content:'';position:absolute;top:19px;left:0;right:0;height:2px;background:var(--line);z-index:0}
.tl .s:first-child:before{left:50%}.tl .s:last-child:before{right:50%}
.tl .s.done:before{background:var(--green)}
.tl .c{width:28px;height:28px;border-radius:50%;border:2px solid var(--line);background:#fff;margin:0 auto;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:var(--gray);position:relative;z-index:1}
.tl .s.done .c{background:var(--green);border-color:var(--green);color:#fff}
.tl .s.cur .c{border-color:#D69E2E;color:var(--amber)}
.tl .s.open .c{box-shadow:0 0 0 3px rgba(74,155,111,.2)}
.tl b{display:block;font-size:11px;color:var(--navy);margin-top:6px;font-weight:500}
.tl small{font-size:10.5px;color:var(--gray)}
.feed .it{display:grid;grid-template-columns:120px 1fr;gap:14px;padding:12px 0;border-bottom:1px solid var(--line)}
.feed .d{font-size:11.5px;color:var(--gray)}
.feed b{display:block;font-weight:500;color:var(--navy)}
.feed p{color:var(--ink);margin-top:3px}
.feed .who{font-size:11.5px;color:var(--gray);margin-top:3px}
.log .it{display:grid;grid-template-columns:150px 140px 1fr;gap:12px;padding:9px 0;border-bottom:1px solid #F1F3F5;font-size:12.5px}
.log .it .d{color:var(--gray);font-size:11.5px}.log .it .w{color:var(--navy);font-weight:500}
.gal{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.ev{border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#fff}
.ev .ph{height:120px;background:#DDE5E1;display:flex;align-items:center;justify-content:center;color:var(--navy);background-size:cover;background-position:center}
.ev .ph svg{width:28px;height:28px;opacity:.5}
.ev div.b{padding:9px 11px}.ev b{display:block;font-weight:500;color:var(--navy);font-size:12px}.ev small{color:var(--gray);font-size:11px;display:block}
.note{background:var(--amber-l);border-left:3px solid var(--amber);padding:10px 12px;border-radius:0 6px 6px 0;margin-bottom:10px}
.note b{display:block;color:var(--navy);font-weight:500;font-size:11.5px;margin-top:4px}
.modal{position:fixed;inset:0;background:rgba(26,58,82,.45);display:none;align-items:center;justify-content:center;z-index:50}
.modal.on{display:flex}
.modal .box{background:#fff;border-radius:12px;width:560px;max-width:94vw;max-height:90vh;overflow-y:auto;padding:22px 24px}
.modal .box h2{margin-bottom:14px}
.f{margin-bottom:12px}.f label{display:block;font-size:11.5px;color:var(--gray);margin-bottom:4px}
.mf{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}
.paper{border:1px solid var(--line);padding:22px 24px;font-size:12.5px;line-height:1.6;margin-bottom:8px}
.paper .lg{width:130px;margin-bottom:10px}
.paper h3{font-size:12px;letter-spacing:1px;color:var(--green);font-weight:600}
.paper .kv{margin:10px 0;grid-template-columns:120px 1fr}
.toast{position:fixed;bottom:22px;right:22px;background:var(--navy);color:#fff;padding:10px 16px;border-radius:6px;font-size:12px;opacity:0;transition:opacity .25s;pointer-events:none;z-index:60}
.toast.on{opacity:1}
.empty{color:var(--gray);padding:14px 0;text-align:center}
.radio{display:flex;gap:10px}.radio label{flex:1;border:1px solid var(--line);border-radius:8px;padding:12px;cursor:pointer;display:flex;gap:8px;align-items:center;font-size:12.5px;color:var(--navy)}
.radio input{width:auto}
.radio label.on{border-color:var(--green);background:var(--green-l)}
.quote-src{background:var(--bg);border-radius:8px;padding:12px 14px;margin:10px 0}
.hidden{display:none!important}
@media print{body{display:block}.side,.hdr,.main,.toast{display:none!important}.modal{position:static;background:none;display:block}.modal .box{width:auto;max-height:none;box-shadow:none}.mf,.modal .box h2{display:none}}

.bar i{transition:width .5s ease}
.btn,.svc,.tabs button,.tl .c,.alert{transition:background .15s,border-color .15s,color .15s,box-shadow .15s}
.card,.kpi{box-shadow:0 1px 2px rgba(26,58,82,.04)}
.modal .box{animation:pop .18s ease}
@keyframes pop{from{transform:translateY(8px);opacity:0}to{transform:none;opacity:1}}
.tab.on,.view.on{animation:fade .2s ease}
@keyframes fade{from{opacity:0}to{opacity:1}}
.strip{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center;background:var(--navy);color:#fff;border-radius:10px;padding:12px 18px;margin:0 0 16px;font-size:12px}
.strip b{font-weight:500;letter-spacing:.5px}.strip .ch{color:#CFE3D8;display:flex;gap:10px;flex-wrap:wrap}.strip .ch span:before{content:'·';margin-right:10px;color:var(--green)}
.sk{background:linear-gradient(90deg,#EEF1F4 25%,#F6F8FA 50%,#EEF1F4 75%);background-size:200% 100%;animation:sk 1s infinite;border-radius:6px;height:14px;margin:8px 0}
@keyframes sk{from{background-position:200% 0}to{background-position:-200% 0}}
.cv{border:1px solid var(--line);border-radius:12px;overflow:hidden}
.cv .top{background:var(--navy);color:#fff;padding:18px 22px;display:flex;justify-content:space-between;align-items:center}
.cv .top small{color:#CFE3D8;display:block;font-size:11px;letter-spacing:1px}
.cv .body{padding:18px 22px}
.cv .step{display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-bottom:1px solid var(--line)}
.cv .step .n{width:22px;height:22px;border-radius:50%;background:var(--green-l);color:#2F6B4A;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;flex-shrink:0}
[data-tip]{position:relative}[data-tip]:hover:after{content:attr(data-tip);position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);background:var(--navy);color:#fff;font-size:11px;padding:4px 8px;border-radius:4px;white-space:nowrap;z-index:20;font-weight:400}
@media (max-width:1400px){body{grid-template-columns:220px 1fr}.kpis{grid-template-columns:repeat(3,1fr)}.hdr-search{width:280px;max-width:calc(100% - 380px)}.prog{grid-template-columns:2fr 1fr 1fr 1fr}}
@media (max-width:1200px){body{grid-template-columns:64px 1fr}.side .logo img,.side .logo .prod,.side .grp,.side a span:not(.n),.side .me div{display:none}.side .logo{padding:0;justify-content:center}.side a{padding:12px 0;justify-content:center;border-left:0}.side .me{justify-content:center}.hdr-search{position:static;transform:none;width:200px;max-width:220px;margin:0 auto}.g2,.g3,.alerts{grid-template-columns:1fr}.task{grid-template-columns:20px 1fr 110px 90px}.task .due,.task .btn{display:none}.gal{grid-template-columns:repeat(2,1fr)}.main{padding:18px}}
</style>
</head>
<body>

<aside class="side">
  <div class="logo">
    <a href="/admin" style="text-decoration:none;display:flex;align-items:center;gap:8px;width:100%;">
      <img src="<%= typeof logoUrl !== 'undefined' ? logoUrl : '/img/logo-gsd.png' %>" alt="GSD Logo" style="max-height:36px;max-width:130px;width:auto;object-fit:contain;">
      <span class="prod" style="font-size:10px;letter-spacing:1px;color:var(--green);font-weight:600;white-space:nowrap;">EXPEDIENTES</span>
    </a>
  </div>
  <nav>
    <div class="grp">Principal</div>
    <a data-view="dash" class="on" href="/admin"><i data-lucide="layout-dashboard"></i><span>Dashboard</span></a>
    <a data-view="list" href="/admin/expedientes"><i data-lucide="folder-open"></i><span>Expedientes</span></a>
    <a data-view="mytasks" href="/admin/tareas"><i data-lucide="check-square"></i><span>Mis tareas</span><span class="n" id="nMy">0</span></a>
    <a data-view="cal" href="/admin/calendario"><i data-lucide="calendar"></i><span>Calendario</span></a>
    <a data-view="clients" href="/admin/clientes"><i data-lucide="users"></i><span>Clientes</span></a>
    <a data-view="docs" href="/admin/documentos"><i data-lucide="file-text"></i><span>Documentos</span></a>
    
    <div class="grp">Operaciones</div>
    <a href="/admin/cotizaciones"><i data-lucide="calculator"></i><span>GSD Quoter</span></a>
    <a href="/admin/propiedades"><i data-lucide="home"></i><span>Bienes Raíces</span></a>
    <a href="/admin/blog"><i data-lucide="newspaper"></i><span>Blog & SEO</span></a>
    
    <div class="grp">Gestión & Sistema</div>
    <a data-view="tpl" href="/admin/plantillas"><i data-lucide="layout-template"></i><span>Plantillas de expedientes</span></a>
    <a href="/admin/ajustes"><i data-lucide="settings"></i><span>Ajustes</span></a>
    <a href="/admin/logout" style="color:var(--red);"><i data-lucide="log-out"></i><span>Cerrar Sesión</span></a>
  </nav>
  <div class="me"><div class="av">EM</div><div><b>Esteban Mejía</b><span>Abogado / Administrador</span></div></div>
</aside>

<header class="hdr">
  <div class="hdr-search">
    <i data-lucide="search"></i>
    <input class="search" id="search" placeholder="Buscar expediente, cliente o parcela...">
  </div>
  <div class="hdr-actions">
    <button class="btn p" id="btnNewExp"><i data-lucide="plus"></i>Nuevo expediente</button>
    <button class="quoter" onclick="window.location.href='/admin/cotizaciones'"><i data-lucide="calculator"></i>GSD Quoter</button>
    <div class="user"><div class="av">EM</div>Esteban Mejía</div>
  </div>
</header>

<main class="main" id="main">

  <section class="view on" id="v-dash">
