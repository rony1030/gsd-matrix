        <div class="cli-metric-box">
          <span style="color:var(--gray);font-size:10px;font-weight:600;display:block;text-transform:uppercase;letter-spacing:0.5px;line-height:1.2;">Total Facturado</span>
          <b style="font-size:18px;color:var(--green);margin-top:2px;display:block;">US$${fmt(c.totalHonorarios)}</b>
        </div>
        <div class="cli-metric-box">
          <span style="color:var(--gray);font-size:10px;font-weight:600;display:block;text-transform:uppercase;letter-spacing:0.5px;line-height:1.2;">Saldo Pendiente</span>
          <b style="font-size:18px;color:${(c.totalHonorarios - c.totalPagado) > 0 ? 'var(--red)' : 'var(--navy)'};margin-top:2px;display:block;">US$${fmt(Math.max(0, c.totalHonorarios - c.totalPagado))}</b>
        </div>
      </div>
    </div>

    <!-- Pestañas de la Vista 360 -->
    <div class="tabs" id="cli360Tabs" style="margin:0 0 16px 0;background:#fff;border-bottom:1px solid var(--line);border-radius:8px 8px 0 0;padding:0 16px;">
      <button class="${_cur360Tab==='expedientes'?'on':''}" data-tab="expedientes" onclick="switchCli360Tab('expedientes')">1. Expedientes & Casos (${c.expedientes.length})</button>
      <button class="${_cur360Tab==='bienes_raices'?'on':''}" data-tab="bienes_raices" onclick="switchCli360Tab('bienes_raices')">2. Bienes Raíces & Proyectos (${c.proyectos.length})</button>
      <button class="${_cur360Tab==='cotizaciones'?'on':''}" data-tab="cotizaciones" onclick="switchCli360Tab('cotizaciones')">3. Cotizaciones & Quoter (${c.cotizaciones.length})</button>
      <button class="${_cur360Tab==='documentos'?'on':''}" data-tab="documentos" onclick="switchCli360Tab('documentos')">4. Documentos del Cliente</button>
      <button class="${_cur360Tab==='bitacora'?'on':''}" data-tab="bitacora" onclick="switchCli360Tab('bitacora')">5. Bitácora & Historial de Notas</button>
    </div>

    <!-- Contenido de la pestaña activa -->
    <div id="cli360Body"></div>
  `;

  renderCli360Body();
  icons();
}

function switchCli360Tab(tabName) {
  _cur360Tab = tabName;
  const tabBtns = document.querySelectorAll('#cli360Tabs button');
  tabBtns.forEach(b => b.classList.toggle('on', b.dataset.tab === tabName));
  renderCli360Body();
}

function renderCli360Body() {
  const c = _cur360Client;
  const body = $('cli360Body');
  if (!c || !body) return;

  const tabName = _cur360Tab;

  if (tabName === 'expedientes') {
    if (c.expedientes.length === 0) {
      body.innerHTML = `
        <div class="card" style="text-align:center;padding:40px 20px;">
          <i data-lucide="folder-plus" style="width:40px;height:40px;color:var(--gray);margin:0 auto 10px;display:block;opacity:0.5;"></i>
