let currentLeafletMap = null;
let currentMapMarker = null;

function parseCoords(str) {
  if (!str) return null;
  const m = str.match(/([-+]?\d+(?:\.\d+)?)\s*,\s*([-+]?\d+(?:\.\d+)?)/) || str.match(/([-+]?\d+(?:\.\d+)?)\s+([-+]?\d+(?:\.\d+)?)/);
  if (m) {
    const lat = parseFloat(m[1]);
    const lng = parseFloat(m[2]);
    if (!isNaN(lat) && !isNaN(lng) && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180) {
      return [lat, lng];
    }
  }
  return null;
}

function initExpMap(coordStr, title, dir) {
  const mapEl = document.getElementById('osmMap');
  if (!mapEl || typeof L === 'undefined') return;

  if (currentLeafletMap) {
    try { currentLeafletMap.remove(); } catch(e) {}
    currentLeafletMap = null;
    currentMapMarker = null;
  }

  if (L.Icon && L.Icon.Default && !L.Icon.Default._gsdPatched) {
    delete L.Icon.Default.prototype._getIconUrl;
    L.Icon.Default.mergeOptions({
      iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
      iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
      shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
    });
    L.Icon.Default._gsdPatched = true;
  }

  const parsed = parseCoords(coordStr);
  const defaultCenter = [18.5812, -68.4103]; // Bávaro / Punta Cana
  const center = parsed || defaultCenter;
  const zoom = parsed ? 16 : 12;

  currentLeafletMap = L.map('osmMap', {
    center: center,
    zoom: zoom,
    zoomControl: true,
    attributionControl: true
  });

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a>'
  }).addTo(currentLeafletMap);

  if (parsed) {
    currentMapMarker = L.marker(parsed, { draggable: true }).addTo(currentLeafletMap);
    currentMapMarker.bindPopup(`<b>${title || 'Ubicación'}</b><br><small>${dir || coordStr}</small>`).openPopup();
    currentMapMarker.on('dragend', function(ev) {
      const pos = ev.target.getLatLng();
      const lat = pos.lat.toFixed(6);
      const lng = pos.lng.toFixed(6);
      const inputCoord = document.querySelector('input[data-k="coord"]');
      if (inputCoord) {
        inputCoord.value = `${lat}, ${lng}`;
        toast('Coordenadas actualizadas');
      }
    });
  }

  currentLeafletMap.on('click', function(ev) {
    const inputCoord = document.querySelector('input[data-k="coord"]');
    if (inputCoord) {
      const lat = ev.latlng.lat.toFixed(6);
      const lng = ev.latlng.lng.toFixed(6);
      inputCoord.value = `${lat}, ${lng}`;
      if (currentMapMarker) {
        currentMapMarker.setLatLng(ev.latlng);
      } else {
        currentMapMarker = L.marker(ev.latlng, { draggable: true }).addTo(currentLeafletMap);
      }
      currentMapMarker.bindPopup(`<b>Punto seleccionado</b><br><small>${lat}, ${lng}</small>`).openPopup();
      toast('Coordenadas capturadas del mapa');
    }
  });

  setTimeout(() => {
    if (currentLeafletMap) currentLeafletMap.invalidateSize();
  }, 150);
}

