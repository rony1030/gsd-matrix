                ${c.proyectos.map(p => `<span class="cli-project-chip" style="font-size:12.5px;padding:5px 12px;"><i data-lucide="building-2" style="width:12px;height:12px;"></i>${p}</span>`).join('')}
              </div>
            ` : '<span style="color:var(--gray);font-size:12.5px;display:block;margin-bottom:8px;">Sin proyectos asignados formalmente aún.</span>'}
            
            <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;">
              <input type="text" id="addProjInput" placeholder="Ej. Stellar, Cosmo, Canar Rock..." style="flex:1;min-width:140px;font-size:12px;padding:6px 10px;height:34px;box-sizing:border-box;">
              <button type="button" class="btn sm p" onclick="addClientProject()" style="white-space:nowrap;height:34px;"><i data-lucide="plus"></i>Agregar</button>
            </div>
          </div>

          <div style="background:#f8fafc;border:1px solid var(--line);border-radius:10px;padding:14px;box-sizing:border-box;">
            <b style="font-size:13px;color:var(--navy);display:block;margin-bottom:10px;"><i data-lucide="compass" style="width:14px;height:14px;margin-right:5px;"></i>Perfil de Inversión & Ubicación</b>
            <div class="kv" style="grid-template-columns:110px 1fr;font-size:12px;gap:8px 12px;">
              <span class="k" style="color:var(--gray);font-weight:600;">Rol:</span><span class="v" style="word-break:break-word;">${c.tipo === 'Inversionista' ? 'Inversionista Principal' : isCorp ? 'Desarrollador / Empresa' : 'Comprador / Propietario'}</span>
              <span class="k" style="color:var(--gray);font-weight:600;">Ubicación:</span><span class="v" style="word-break:break-word;">${c.dir || 'Punta Cana / Bávaro / Cap Cana'}</span>
              <span class="k" style="color:var(--gray);font-weight:600;">Estado:</span><span class="v"><span class="tag proc" style="font-size:11px;">En Cartera Activa</span></span>
            </div>
          </div>
        </div>
      </div>
    `;
  } else if (tabName === 'cotizaciones') {
    body.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
        <h3 style="margin:0;font-size:15px;color:var(--navy);">Cotizaciones Emitidas en GSD Quoter (${c.cotizaciones.length})</h3>
        <button type="button" class="btn sm p" onclick="window.location.href='/admin/cotizaciones'"><i data-lucide="plus"></i>Nueva Cotización</button>
      </div>
      ${c.cotizaciones.length ? `
        <div style="display:grid;gap:12px;">
          ${c.cotizaciones.map(q => `
            <div class="card" style="padding:16px 20px;margin:0;">
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <div>
                  <b style="font-size:14px;color:var(--navy);">${q.ref}</b>
                  <div style="font-size:13px;color:#334155;margin-top:3px;font-weight:500;">${TPL[q.svc]?.nombre || q.svc || 'Servicio Profesional'}</div>
                  ${q.obj ? `<small style="color:var(--gray);display:block;margin-top:2px;">${q.obj}</small>` : ''}
                </div>
                <div style="text-align:right;">
                  <b style="font-size:16px;color:var(--green);">${q.mon || 'USD'}${fmt(q.hon || 0)}</b>
                  <div style="margin-top:6px;">
                    <span class="tag proc">Aprobada / Registrada</span>
                  </div>
                </div>
              </div>
            </div>
          `).join('')}
        </div>
      ` : `
        <div class="card" style="text-align:center;padding:40px 20px;">
          <p class="sub" style="margin-bottom:14px;">No hay cotizaciones previas emitidas para este cliente.</p>
          <button type="button" class="btn" onclick="window.location.href='/admin/cotizaciones'"><i data-lucide="calculator"></i>Crear Cotización en Quoter</button>
        </div>
      `}
    `;
  } else if (tabName === 'documentos') {
    const allDocs = c.expedientes.flatMap(e => (e.docs || []).map(d => {
      const cat = d.cat || (Array.isArray(d) ? d[0] : 'GENERAL') || 'GENERAL';
      const name = d.name || (Array.isArray(d) ? d[1] : (typeof d === 'string' ? d : 'Documento'));
      const by = d.by || (Array.isArray(d) ? d[2] : 'gsd') || 'gsd';
      const st = d.st || 'ok';
      return {
        ...d,
        cat,
        name,
        by,
        st,
        expId: e.id,
        expSvc: e.svc,
        clientName: e.cliente?.nombre || c.nombre
      };
    }));

    body.innerHTML = `
      <div class="card">
        <div class="ch">
          <h3>Documentos Consolidados del Cliente</h3>
          <span style="font-size:12px;color:var(--gray);">${allDocs.filter(d => d.st === 'ok').length} de ${allDocs.length} listos</span>
        </div>
        ${allDocs.length ? `
          <div style="display:grid;gap:8px;">
            ${allDocs.map(d => `
              <div style="display:flex;justify-content:space-between;align-items:center;padding:11px 15px;border:1px solid var(--line);border-radius:8px;background:#fff;">
