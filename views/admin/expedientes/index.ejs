  <h2>Actualización para el cliente</h2>
  <div class="paper" id="updPaper"></div>
  <div class="mf"><button class="btn" onclick="copyUpd()"><i data-lucide="copy"></i>Copiar</button><button class="btn" onclick="window.print()"><i data-lucide="download"></i>Descargar PDF</button><button class="btn p" onclick="closeM('mUpd');toast('Actualización enviada (simulado)')"><i data-lucide="send"></i>Enviar</button><button class="btn ghost" onclick="closeM('mUpd')">Cerrar</button></div>
</div></div>

<div class="modal" id="mConfirm"><div class="box" style="width:420px"><h2 id="cfTitle">Confirmar</h2><p id="cfText" class="sub" style="margin-bottom:6px"></p><div class="mf"><button class="btn" onclick="closeM('mConfirm')">Cancelar</button><button class="btn p" id="cfOk">Confirmar</button></div></div></div>
<div class="modal" id="mClient"><div class="box" style="width:600px;padding:0"><div id="clientView"></div><div class="mf" style="padding:0 22px 18px"><button class="btn" onclick="closeM('mClient')">Cerrar vista</button></div></div></div>
<div class="toast" id="toast"></div>
<script>
// ===== DATA: plantillas por servicio =====
const icons=()=>{try{lucide.createIcons()}catch(e){}};
const TEAM=['Esteban Mejía','Carlos Rodríguez','Ana Martínez','Brenda Laureano','Rafael Peña'];
const TPL={
 deslinde:{nombre:'Deslinde Catastral',div:'Agrimensura',plazo:120,tec:true,
  objeto:{provincia:'Provincia',municipio:'Municipio',dm:'Distrito Municipal',sector:'Sector',parcela:'Parcela',dc:'Distrito Catastral',areaReg:'Área registral',areaLev:'Área levantada',matricula:'Matrícula',titulo:'Certificado de título',propietario:'Propietario registral'},
  docs:[['CLIENTE','Cédula o pasaporte','cliente'],['CLIENTE','Autorización / poder','cliente'],['CLIENTE','Acta de matrimonio (si aplica)','cliente'],['INMUEBLE','Certificado de título o constancia','cliente'],['INMUEBLE','Plano anterior','cliente'],['INMUEBLE','Certificación de estado jurídico','gsd'],['TÉCNICO','Levantamiento GNSS','gsd'],['TÉCNICO','Fotografías de campo','gsd'],['TÉCNICO','Plano definitivo','gsd'],['TÉCNICO','Memoria descriptiva','gsd'],['PROCESO','Solicitud a Mensuras','gsd'],['PROCESO','Notificaciones a colindantes','gsd'],['PROCESO','Resolución Tribunal de Tierras','gsd'],['PROCESO','Certificado de título definitivo','gsd']],
  fases:[['Diagnóstico',['Recibir documentación del cliente','Revisar título','Consultar Registro de Títulos','Verificar antecedentes','Analizar colindantes','Dictamen de viabilidad']],['Documentación',['Certificación de estado jurídico','Autorización firmada','Constancia de IPI','Solicitud a Mensuras']],['Campo',['Coordinar visita','Levantamiento GNSS','Monumentación','Fotografías','Validación de campo']],['Procesamiento',['Procesamiento GNSS','Cálculos','Plano','Informe técnico','Memoria descriptiva']],['Mensura',['Depósito en Mensuras','Aprobación técnica']],['Aprobación',['Notificación a colindantes']],['Registro',['Tribunal de Tierras y emisión del título']],['Cierre',['Entrega al cliente']]]},
 transferencia:{nombre:'Transferencia de Inmuebles',div:'Inmobiliario',plazo:30,tec:false,
  objeto:{provincia:'Provincia',municipio:'Municipio',sector:'Sector',matricula:'Matrícula',titulo:'Certificado de título',dc:'Designación catastral',areaReg:'Área',vendedor:'Vendedor',comprador:'Comprador',precio:'Precio de venta'},
  docs:[['CLIENTE','Cédula comprador','cliente'],['CLIENTE','Cédula vendedor','cliente'],['CLIENTE','Acta de matrimonio vendedor','cliente'],['INMUEBLE','Certificado de título original','cliente'],['INMUEBLE','Certificación de estado jurídico','gsd'],['INMUEBLE','Constancia IPI','gsd'],['PROCESO','Contrato de compraventa notarizado','cliente'],['PROCESO','Recibo impuesto 3% DGII','gsd'],['PROCESO','Recibo depósito Registro','gsd'],['PROCESO','Nuevo certificado de título','gsd']],
  fases:[['Diagnóstico',['Recibir documentación','Revisar título y cargas','Verificar partes']],['Certificaciones',['Estado jurídico','Constancia IPI','Legalización de firmas']],['Impuestos',['Liquidación DGII','Pago del 3%']],['Registro',['Depósito en Registro de Títulos','Seguimiento','Emisión del nuevo título']],['Cierre',['Entrega al cliente','Cierre del expediente']]]},
 iguala:{nombre:'Iguala Legal',div:'Legal',plazo:180,tec:false,
  objeto:{empresa:'Empresa / cliente',rnc:'RNC',nivel:'Nivel de iguala',sede:'Sede',contacto:'Contacto principal',vigencia:'Vigencia del contrato'},
  docs:[['CLIENTE','Registro mercantil','cliente'],['CLIENTE','Estatutos sociales','cliente'],['CLIENTE','Cédula del representante','cliente'],['PROCESO','Contrato de iguala firmado','gsd'],['PROCESO','Informe mensual','gsd']],
  fases:[['Diagnóstico',['Reunión inicial','Relevar asuntos abiertos','Definir nivel de iguala']],['Contrato',['Redacción del contrato','Firma','Primer pago']],['Servicio',['Informe mensual 1','Informe mensual 2','Informe mensual 3']],['Renovación',['Evaluación','Renovación o cierre']]]}
};

// ===== DATA / REAL STATE =====
const SEED_KEY='gsd_exp_v5';
try {
  localStorage.removeItem('gsd_exp_v2');
  localStorage.removeItem('gsd_exp_v3');
  localStorage.removeItem('gsd_exp_v4');
} catch(e) {}

const SERVER_EXPEDIENTES = <%- JSON.stringify(typeof expedientes !== 'undefined' ? expedientes : []) %>;
const SERVER_QUOTES = <%- JSON.stringify(typeof cotizaciones !== 'undefined' ? cotizaciones : []) %>;

let localStored = null;
try {
  localStored = JSON.parse(localStorage.getItem(SEED_KEY) || 'null');
} catch(e) {}

let DB = (SERVER_EXPEDIENTES && SERVER_EXPEDIENTES.length > 0)
  ? SERVER_EXPEDIENTES
  : (Array.isArray(localStored) ? localStored : []);

let quotes = Array.isArray(SERVER_QUOTES) ? SERVER_QUOTES : [];

function addDays(s,n){const d=new Date(s+'T00:00:00');d.setDate(d.getDate()+n);return d.toISOString().slice(0,10);}
function mkTasks(t,doneUpTo,proc){let id=1,out=[];t.fases.forEach((f,fi)=>f[1].forEach((n,ti)=>{const k=`${fi}.${ti}`;let st='pend';if(k<doneUpTo||(fi<parseInt(doneUpTo)))st='done';if(k===doneUpTo)st='proc';if(proc&&proc.includes(k))st='proc';out.push({id:id++,phase:fi,name:n,who:fi<=1||fi>=4?'Esteban Mejía':'Carlos Rodríguez',due:'',pri:'Media',st,desc:''});}));return out;}
const save=()=>{
  localStorage.setItem(SEED_KEY,JSON.stringify(DB));
  if (cur) {
    fetch('/admin/expedientes/api/guardar', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(cur)
    }).catch(e=>console.log('Background sync error:',e));
  }
};
const TODAY=new Date().toISOString().slice(0,10);
const $=id=>document.getElementById(id);
const fmt=n=>Number(n).toLocaleString('en-US');
const M=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
const fd=s=>{if(!s)return '—';const [y,m,d]=s.slice(0,10).split('-');return `${parseInt(d)} ${M[m-1]} ${y}`;};
const days=s=>Math.round((new Date(s+'T00:00:00')-new Date(TODAY+'T00:00:00'))/864e5);
const ST={pend:['Pendiente','st-pend'],proc:['En proceso','st-proc'],done:['Completado','st-done'],block:['Bloqueado','st-block'],na:['No aplica','st-na']};
const ESTADO={proc:['EN PROCESO','proc'],rev:['EN REVISIÓN','rev'],wait:['ESPERANDO CLIENTE','wait'],done:['CERRADO','done']};
const ini=n=>n.split(' ').map(x=>x[0]).join('').slice(0,2).toUpperCase();
function progress(e){const t=e.tasks.filter(x=>x.st!=='na');const d=t.filter(x=>x.st==='done').length;return{pct:t.length?Math.round(d/t.length*100):0,done:d,total:t.length};}
function phaseState(e,fi){const t=e.tasks.filter(x=>x.phase===fi&&x.st!=='na');if(t.length&&t.every(x=>x.st==='done'))return 'done';if(t.some(x=>x.st==='done'||x.st==='proc'))return 'cur';return 'pend';}
function currentPhase(e){const f=TPL[e.svc].fases;for(let i=0;i<f.length;i++){if(phaseState(e,i)!=='done')return i;}return f.length-1;}
function toast(m){const t=$('toast');t.textContent=m;t.classList.add('on');setTimeout(()=>t.classList.remove('on'),2200);}
function confirmA(title,text,fn){$('cfTitle').textContent=title;$('cfText').textContent=text;$('cfOk').onclick=()=>{closeM('mConfirm');fn();};openM('mConfirm');}
function openM(id){$(id).classList.add('on');icons();}function closeM(id){$(id).classList.remove('on');}
function log(e,t,w='Esteban Mejía'){e.log.unshift({d:TODAY+' '+new Date().toTimeString().slice(0,5),w,t});}

// ===== ALERTS =====
function alerts(){const out=[];DB.forEach(e=>{if(e.estado==='done')return;e.tasks.forEach(t=>{if(t.due&&t.st!=='done'&&t.st!=='na'){const d=days(t.due);if(d<0)out.push({c:'r',t:'Tarea vencida',n:t.name,e:e.id,s:`Vencida hace ${-d} día${-d>1?'s':''}`,w:t.who});else if(d<=3)out.push({c:'y',t:'Vencimiento próximo',n:t.name,e:e.id,s:d===0?'Vence hoy':`Vence en ${d} día${d>1?'s':''}`,w:t.who});}});const w=e.docs.filter(d=>d.st!=='ok'&&d.by==='cliente');if(w.length)out.push({c:'o',t:'Documentación pendiente',n:'Falta '+w[0].name.toLowerCase()+(w.length>1?` y ${w.length-1} más`:''),e:e.id,s:'Esperando cliente',w:e.resp});});return out.sort((a,b)=>'ryo'.indexOf(a.c)-'ryo'.indexOf(b.c));}

// ===== NAVIGATION: vistas globales con sincronizacion URL =====
const URL_MAP = {
  dash: '/admin',
  list: '/admin/expedientes',
  mytasks: '/admin/tareas',
  cal: '/admin/calendario',
  clients: '/admin/clientes',
  docs: '/admin/documentos',
  tpl: '/admin/plantillas'
};

function go(v, push = true){
  if (!v || !$('v-'+v)) v = 'dash';
  document.querySelectorAll('.view').forEach(x=>x.classList.remove('on'));
  $('v-'+v).classList.add('on');
  document.querySelectorAll('.side a[data-view]').forEach(a=>a.classList.toggle('on',a.dataset.view===v));
  $('main').scrollTop=0;
  ({dash:renderDash,list:renderList,mytasks:renderMy,cal:renderCal,clients:renderCli,docs:renderDocsAll,tpl:renderTpl})[v]?.();
  icons();
  if (push && URL_MAP[v] && window.location.pathname !== URL_MAP[v]) {
    history.pushState({view: v}, '', URL_MAP[v]);
  }
}

window.addEventListener('popstate', (e) => {
  if (e.state && e.state.view) {
    go(e.state.view, false);
  } else {
    const p = window.location.pathname;
    const matched = Object.keys(URL_MAP).find(k => URL_MAP[k] === p);
    go(matched || 'dash', false);
  }
});

document.querySelectorAll('.side a[data-view]').forEach(a => {
  a.addEventListener('click', (e) => {
    e.preventDefault();
    go(a.dataset.view);
  });
});
function rowHTML(e,withDate){const p=progress(e),es=ESTADO[e.estado];return `<tr class="row" onclick="openExp('${e.id}')"><td><b style="color:var(--navy);font-weight:500">${e.id}</b></td><td>${e.cliente.nombre}</td><td>${TPL[e.svc].nombre}</td><td>${e.tec&&e.tec!==e.resp?e.resp.split(' ')[0]+' / '+e.tec.split(' ')[0]:e.resp}</td>${withDate?`<td>${fd(e.inicio)}</td>`:''}<td><div style="display:flex;align-items:center;gap:8px"><div class="bar" style="flex:1"><i style="width:${p.pct}%"></i></div><span style="font-size:11.5px;color:var(--gray);min-width:32px">${p.pct}%</span></div></td><td><span class="tag ${es[1]}">${es[0]}</span></td></tr>`;}
function renderDash(){const al=alerts(),act=DB.filter(e=>e.estado!=='done');const late=al.filter(a=>a.c==='r').length,soon=DB.flatMap(e=>e.tasks||[]).filter(t=>t.due&&t.st!=='done'&&days(t.due)>=0&&days(t.due)<=14).length;
 $('kpis').innerHTML=[['folder-open','Expedientes activos',act.length],['alert-circle','Requieren atención',al.length,al.length?'warn':''],['clock','Tareas vencidas',late,late?'warn':''],['calendar','Próximos vencimientos',soon],['check-circle','Completados este mes',DB.filter(e=>e.estado==='done').length]].map(k=>`<div class="kpi ${k[3]||''}"><div class="l"><i data-lucide="${k[0]}"></i>${k[1]}</div><div class="v">${k[2]}</div></div>`).join('');
 $('dashAlerts').innerHTML=al.slice(0,3).map(a=>`<div class="alert" onclick="openExp('${a.e}')"><span class="dot ${a.c}"></span><div><b>${a.n}</b><small>${a.e} · ${a.s}</small><small>Responsable: ${a.w.split(' ')[0]}</small></div></div>`).join('')||'<div class="empty" style="text-align:center;padding:18px;color:var(--gray);">Sin alertas pendientes. Todo al día.</div>';
 $('dashRows').innerHTML=DB.slice(0,4).map(e=>rowHTML(e)).join('')||'<tr><td colspan="6" class="empty" style="text-align:center;padding:24px;color:var(--gray);">No hay expedientes registrados aún. Haz clic en "Nuevo expediente" para crear el primero.</td></tr>';}
let listF='all';
$('listFilters').onclick=ev=>{if(ev.target.dataset.f){listF=ev.target.dataset.f;[...$('listFilters').children].forEach(b=>b.classList.toggle('on',b===ev.target));renderList();}};
function renderList(){const q=$('search').value.toLowerCase();const rows=DB.filter(e=>(listF==='all'||e.estado===listF)&&(!q||JSON.stringify(e).toLowerCase().includes(q)));$('listCount').textContent=`${rows.length} expediente${rows.length!==1?'s':''}`;$('listRows').innerHTML=rows.map(e=>rowHTML(e,true)).join('')||'<tr><td colspan="7" class="empty" style="text-align:center;padding:28px;color:var(--gray);">No hay expedientes registrados en esta vista.</td></tr>';}
$('search').addEventListener('input',()=>{go('list');});
let mtF='all';$('mtFilters').onclick=ev=>{if(ev.target.dataset.f){mtF=ev.target.dataset.f;[...$('mtFilters').children].forEach(b=>b.classList.toggle('on',b===ev.target));renderMy();}};
function allTasks(){return DB.flatMap(e=>(e.tasks||[]).map(t=>({...t,e})));}
function renderMy(){let ts=allTasks().filter(t=>t.st!=='done'&&t.st!=='na');if(mtF==='mine')ts=ts.filter(t=>t.who==='Esteban Mejía');if(mtF==='late')ts=ts.filter(t=>t.due&&days(t.due)<0);if(mtF==='week')ts=ts.filter(t=>t.due&&days(t.due)>=0&&days(t.due)<=7);ts.sort((a,b)=>(a.due||'9')>(b.due||'9')?1:-1);
 $('mtRows').innerHTML=ts.map(t=>`<tr class="row" onclick="openExp('${t.e.id}','tareas')"><td>${t.name}</td><td>${t.e.id}</td><td>${TPL[t.e.svc]?.fases[t.phase]?.[0]||'General'}</td><td>${t.who}</td><td class="${t.due&&days(t.due)<0?'st-block':''}">${fd(t.due)}</td><td class="${ST[t.st][1]}">● ${ST[t.st][0]}</td></tr>`).join('')||'<tr><td colspan="6" class="empty" style="text-align:center;padding:28px;color:var(--gray);">No hay tareas pendientes.</td></tr>';
 const myC = allTasks().filter(t=>t.who==='Esteban Mejía'&&t.due&&t.st!=='done'&&t.st!=='na'&&days(t.due)<=3).length;
 $('nMy').textContent=myC;
 $('nMy').style.display=myC>0?'inline-block':'none';}
function renderCal(){const ts=allTasks().filter(t=>t.due&&t.st!=='done'&&t.st!=='na').sort((a,b)=>a.due>b.due?1:-1);const g={};ts.forEach(t=>{(g[t.due]=g[t.due]||[]).push(t);});$('calBox').innerHTML=Object.keys(g).map(d=>`<div style="display:grid;grid-template-columns:110px 1fr;gap:14px;padding:10px 0;border-bottom:1px solid var(--line)"><div><b style="color:${days(d)<0?'var(--red)':'var(--navy)'};font-weight:500">${fd(d)}</b><br><small style="color:var(--gray)">${days(d)<0?'vencido':days(d)===0?'hoy':'en '+days(d)+' días'}</small></div><div>${g[d].map(t=>`<div style="padding:3px 0"><span class="link" onclick="openExp('${t.e.id}','tareas')">${t.name}</span> <small style="color:var(--gray)">· ${t.e.id} · ${t.who}</small></div>`).join('')}</div></div>`).join('')||'<div class="empty" style="text-align:center;padding:28px;color:var(--gray);">Sin vencimientos programados.</div>';}
function renderCli(){const g={};DB.forEach(e=>{if(e.cliente?.nombre){(g[e.cliente.nombre]=g[e.cliente.nombre]||{c:e.cliente,ex:[]}).ex.push(e.id);}});$('cliRows').innerHTML=Object.values(g).map(x=>`<tr><td><b style="font-weight:500;color:var(--navy)">${x.c.nombre}</b></td><td>${x.c.cedula||'—'}</td><td>${x.c.email||'—'}<br><small style="color:var(--gray)">${x.c.tel||'—'}</small></td><td>${x.ex.map(i=>`<span class="link" onclick="openExp('${i}')">${i}</span>`).join(', ')}</td></tr>`).join('')||'<tr><td colspan="4" class="empty" style="text-align:center;padding:28px;color:var(--gray);">No hay clientes registrados aún.</td></tr>';}
function renderDocsAll(){const rows=DB.flatMap(e=>(e.docs||[]).filter(d=>d.st!=='ok').map(d=>({...d,e})));$('docsAll').innerHTML=rows.map(d=>`<div class="doc"><div class="ic miss"><i data-lucide="file"></i></div><div><b>${d.name}</b><small>${d.e.id} · ${d.e.cliente?.nombre||'Cliente'} · aporta: ${d.by==='cliente'?'cliente':'GSD'}</small></div><div class="acts"><span class="tag ${d.st==='wait'?'wait':'late'}">${d.st==='wait'?'Solicitado':'Pendiente'}</span><button class="btn sm" onclick="openExp('${d.e.id}','documentos')">Abrir</button></div></div>`).join('')||'<div class="empty" style="text-align:center;padding:28px;color:var(--gray);">No hay documentos pendientes. Todo al día.</div>';}
function renderTpl(){$('tplCards').innerHTML=Object.entries(TPL).map(([k,t])=>`<div class="card"><h2>${t.nombre}</h2><p class="sub">${t.div} · plazo estimado ${t.plazo} días</p><div class="kv" style="margin-top:12px;grid-template-columns:110px 1fr"><span class="k">Campos</span><span class="v">${Object.keys(t.objeto).length} del objeto</span><span class="k">Documentos</span><span class="v">${t.docs.length}</span><span class="k">Etapas</span><span class="v">${t.fases.length}</span><span class="k">Tareas</span><span class="v">${t.fases.reduce((a,f)=>a+f[1].length,0)}</span></div><div style="margin-top:12px;font-size:11.5px;color:var(--gray)">${t.fases.map(f=>f[0]).join(' → ')}</div></div>`).join('');}

// ===== EXPEDIENTE: control center =====
let cur=null,tab='resumen',openPhase=null;
function openExp(id,t){cur=DB.find(e=>e.id===id);tab=t||'resumen';openPhase=null;$('v-exp').innerHTML='<div class="sk" style="width:180px"></div><div class="sk" style="width:320px;height:26px"></div><div class="sk" style="width:240px"></div><div class="card" style="margin-top:18px"><div class="sk"></div><div class="sk" style="width:60%"></div></div><div class="card"><div class="sk"></div><div class="sk"></div><div class="sk" style="width:40%"></div></div>';setTimeout(renderExp,260);document.querySelectorAll('.view').forEach(x=>x.classList.remove('on'));$('v-exp').classList.add('on');document.querySelectorAll('.side a').forEach(a=>a.classList.toggle('on',a.dataset.view==='list'));$('main').scrollTop=0;icons();}
function renderExp(){const e=cur,T=TPL[e.svc],p=progress(e),es=ESTADO[e.estado];const obj=e.objeto;const sub=e.svc==='deslinde'?`Parcela ${obj.parcela} · ${obj.areaReg} · ${obj.sector}, ${obj.provincia}`:e.svc==='transferencia'?`Matrícula ${obj.matricula} · ${obj.sector} · ${obj.precio}`:`${obj.empresa} · Nivel ${obj.nivel}`;
 const tabs=['resumen','informacion','documentos','checklist','proceso','tareas','avances','bitacora','evidencias','finanzas'];const tn={resumen:'Resumen',informacion:'Información',documentos:'Documentos',checklist:'Checklist',proceso:'Proceso',tareas:'Tareas',avances:'Avances',bitacora:'Bitácora',evidencias:'Evidencias',finanzas:'Finanzas'};
 $('v-exp').innerHTML=`<span class="link" onclick="go('list')">← Volver a expedientes</span>
 <div class="exp-head" style="margin-top:10px"><div><div class="ref">${e.id} · desde ${e.quote}</div><h1>${T.nombre}</h1><div class="cli">${e.cliente.nombre}</div><div class="sub">${sub}</div></div>
 <div class="acts"><span class="tag ${es[1]}" style="font-size:11.5px;padding:5px 12px">● ${es[0]}</span><select onchange="setEstado(this.value)" style="width:auto;padding:6px 8px;font-size:12px">${Object.entries(ESTADO).map(([k,v])=>`<option value="${k}" ${k===e.estado?'selected':''}>${v[0]}</option>`).join('')}</select><button class="btn" onclick="setTab('informacion');toast('Use Editar en cada bloque')"><i data-lucide="pencil"></i>Editar expediente</button><button class="btn" onclick="noteModal(false)"><i data-lucide="sticky-note"></i>Agregar nota</button><button class="btn" onclick="clientView()" data-tip="Cómo lo ve el cliente"><i data-lucide="eye"></i>Vista previa para cliente</button><button class="btn p" onclick="genUpdate()"><i data-lucide="send"></i>Generar actualización</button></div></div>
 <div class="card" style="margin-top:18px"><div class="prog"><div><div style="font-size:11.5px;color:var(--gray)">Progreso del expediente</div><div class="bar"><i style="width:${p.pct}%"></i></div><span class="big">${p.pct}%</span> <span style="color:var(--gray)">${p.done} de ${p.total} tareas completadas</span></div>
 <div><div class="k">Inicio</div><div class="v">${fd(e.inicio)}</div></div><div><div class="k">Fecha estimada</div><div class="v">${fd(e.fin)}</div></div><div><div class="k">Responsable</div><div class="v">${e.resp}</div></div><div><div class="k">${T.tec?'Agrimensor':'Asistente'}</div><div class="v">${e.tec||'—'}</div></div><div><div class="k">Prioridad</div><div class="v"><span class="tag ${e.pri==='Alta'?'hi':e.pri==='Media'?'med':'lo'}">${e.pri.toUpperCase()}</span></div></div></div></div>
 <div class="tabs">${tabs.map(t=>`<button class="${t===tab?'on':''}" onclick="setTab('${t}')">${tn[t]}</button>`).join('')}</div>
 <div id="tabBox"></div>`;renderTab();icons();}
function setTab(t){tab=t;document.querySelectorAll('.tabs button').forEach(b=>b.classList.toggle('on',b.textContent===({resumen:'Resumen',informacion:'Información',documentos:'Documentos',checklist:'Checklist',proceso:'Proceso',tareas:'Tareas',avances:'Avances',bitacora:'Bitácora',evidencias:'Evidencias',finanzas:'Finanzas'})[t]));renderTab();icons();}
function setEstado(v){if(v==='done'){confirmA('Cerrar expediente','El expediente pasará a estado Cerrado y dejará de generar alertas.',()=>{cur.estado='done';log(cur,'Expediente cerrado.');save();renderExp();toast('Expediente cerrado');});renderExp();return;}cur.estado=v;log(cur,`Estado cambiado a "${ESTADO[v][0]}".`);save();renderExp();toast('Estado actualizado');}
function renderTab(){const e=cur,T=TPL[e.svc],b=$('tabBox');({resumen,informacion,documentos,checklist,proceso,tareas,avances,bitacora,evidencias,finanzas})[tab](e,T,b);icons();}

function resumen(e,T,b){const p=progress(e),cp=currentPhase(e),next=e.tasks.filter(t=>t.st!=='done'&&t.st!=='na').slice(0,3),due=e.tasks.filter(t=>t.due&&t.st!=='done'&&t.st!=='na').sort((a,b)=>a.due>b.due?1:-1)[0],last=e.log[0];
 b.innerHTML=`<div class="g2"><div class="card"><h2>Estado actual</h2><div style="margin:8px 0 4px;font-weight:500;color:var(--green);letter-spacing:1px;font-size:12px">${T.fases[cp][0].toUpperCase()}</div><p>${cp>0?`La etapa "${T.fases[cp-1][0]}" ha sido completada. `:''}Actualmente el expediente se encuentra en la fase de ${T.fases[cp][0].toLowerCase()}${cp+1<T.fases.length?`; la siguiente etapa es ${T.fases[cp+1][0].toLowerCase()}`:''}.</p>
 <h2 style="margin-top:18px">Próximas acciones</h2><ol style="padding-left:18px;margin-top:6px;line-height:1.9">${next.map(t=>`<li>${t.name} <small style="color:var(--gray)">· ${t.who.split(' ')[0]}</small></li>`).join('')||'<li>Sin acciones pendientes.</li>'}</ol></div>
 <div><div class="card"><h2>Última actividad</h2><div style="margin-top:8px"><small style="color:var(--gray)">${last?last.d.replace(' ',' — ')+' · '+last.w:''}</small><p style="margin-top:4px">${last?last.t:'—'}</p></div></div>
 <div class="card"><h2>Próximo vencimiento</h2>${due?`<div style="margin-top:8px"><b style="font-weight:500;color:var(--navy)">${due.name}</b><br><small style="color:var(--gray)">${fd(due.due)} · ${due.who}</small><div style="margin-top:6px"><span class="tag ${days(due.due)<0?'late':days(due.due)<=3?'wait':'proc'}">${days(due.due)<0?'Vencido hace '+(-days(due.due))+' días':days(due.due)===0?'Vence hoy':days(due.due)+' días restantes'}</span></div></div>`:'<p class="sub">Sin fechas programadas.</p>'}</div>
 <div class="card"><h2>Notas internas</h2>${e.notas.map(n=>`<div class="note" style="margin-top:8px">${n.txt}<b>${n.who} · ${fd(n.date)}</b></div>`).join('')||'<p class="sub">Sin notas.</p>'}</div></div></div>`;}

function kvBlock(title,obj,labels,path){return `<div class="card" data-path="${path}"><div class="ch"><h2>${title}</h2><button class="btn sm ghost" onclick="editBlock(this)"><i data-lucide="pencil"></i>Editar</button></div><div class="kv">${Object.keys(labels).map(k=>`<span class="k">${labels[k]}</span><span class="v" data-k="${k}">${obj[k]||'—'}</span>`).join('')}</div></div>`;}
function informacion(e,T,b){b.innerHTML=`<div class="g2">${kvBlock('Datos del cliente',e.cliente,{nombre:'Nombre',cedula:'Cédula / RNC',tel:'Teléfono',email:'Email',dir:'Dirección'},'cliente')}
 <div class="card"><div class="ch"><h2>Datos del servicio</h2></div><div class="kv"><span class="k">Servicio</span><span class="v">${T.nombre}</span><span class="k">Cotización</span><span class="v">${e.quote}</span><span class="k">Fecha de aprobación</span><span class="v">${fd(e.aprob)}</span><span class="k">Honorario</span><span class="v">${e.mon}${fmt(e.honorario)}</span><span class="k">Estado</span><span class="v">${ESTADO[e.estado][0]}</span><span class="k">Plazo estimado</span><span class="v">${T.plazo} días</span></div></div>
 ${kvBlock(e.svc==='iguala'?'Datos del cliente corporativo':'Datos del inmueble',e.objeto,T.objeto,'objeto')}
 ${T.tec?`<div class="card" data-path="ubic"><div class="ch"><h2>Ubicación</h2><button class="btn sm ghost" onclick="editBlock(this)"><i data-lucide="pencil"></i>Editar</button></div><div class="map"><div class="poly"></div><div class="pin"><i data-lucide="map-pin"></i></div></div><div class="kv"><span class="k">Coordenadas</span><span class="v" data-k="coord">${e.ubic.coord}</span><span class="k">Dirección</span><span class="v" data-k="dir">${e.ubic.dir||'—'}</span><span class="k">Referencia</span><span class="v" data-k="ref">${e.ubic.ref||'—'}</span></div><div style="margin-top:10px"><a class="btn sm" href="https://www.google.com/maps?q=${e.ubic.coord.replace(/ /g,'')}" target="_blank"><i data-lucide="external-link"></i>Abrir ubicación</a></div></div>
 ${kvBlock('Linderos',e.linderos,{Norte:'Norte',Sur:'Sur',Este:'Este',Oeste:'Oeste'},'linderos')}
 ${kvBlock('Datos técnicos',e.tecnico,{tipo:'Tipo de levantamiento',equipo:'Equipo',sist:'Sistema de coordenadas',zona:'Zona',datum:'Datum',prec:'Precisión'},'tecnico')}`:''}</div>`;}
function editBlock(btn){const card=btn.closest('.card');card.querySelectorAll('.v[data-k]').forEach(v=>{const val=v.textContent==='—'?'':v.textContent;v.innerHTML=`<input value="${val.replace(/"/g,'&quot;')}" data-k="${v.dataset.k}">`;});btn.parentElement.innerHTML=`<h2>${card.querySelector('h2').textContent}</h2><span><button class="btn sm" onclick="renderTab()">Cancelar</button> <button class="btn sm p" onclick="saveBlock(this)">Guardar cambios</button></span>`;}
function saveBlock(btn){const card=btn.closest('.card');const obj=cur[card.dataset.path];card.querySelectorAll('input[data-k]').forEach(i=>obj[i.dataset.k]=i.value);log(cur,`Bloque "${card.querySelector('h2').textContent}" actualizado.`);save();renderExp();toast('Cambios guardados');}

// ===== DOCUMENTS =====
let docF='all';
function documentos(e,T,b){const cats=[...new Set(e.docs.map(d=>d.cat))];const f=d=>docF==='all'||(docF==='ok'&&d.st==='ok')||(docF==='miss'&&d.st!=='ok')||(docF==='late'&&d.st!=='ok'&&d.by==='cliente');
 b.innerHTML=`<div class="card"><div class="ch"><h2>Documentos del expediente <small style="color:var(--gray);font-weight:400">· ${e.docs.filter(d=>d.st==='ok').length} de ${e.docs.length} completos</small></h2><button class="btn p" onclick="uploadDoc()"><i data-lucide="upload"></i>Subir documento</button></div>
 <div class="filters">${[['all','Todos'],['miss','Pendientes'],['ok','Completados'],['late','Esperando cliente']].map(x=>`<button class="${docF===x[0]?'on':''}" onclick="docF='${x[0]}';renderTab()">${x[1]}</button>`).join('')}</div>
 ${cats.map(c=>{const ds=e.docs.map((d,i)=>({...d,i})).filter(d=>d.cat===c&&f(d));if(!ds.length)return '';return `<div class="cat">${c}</div>${ds.map(d=>`<div class="doc"><div class="ic ${d.st==='ok'?'':'miss'}"><i data-lucide="${d.st==='ok'?'file-check':'file'}"></i></div><div><b>${d.st==='ok'?d.file:d.name}</b><small>${d.st==='ok'?`PDF · ${d.size} · subido ${fd(d.date)} por ${d.who.split(' ')[0]}`:`Aporta: ${d.by==='cliente'?'cliente':'GSD'} · ${d.st==='wait'?'solicitado, esperando':'pendiente'}`}</small></div><div class="acts">${d.st==='ok'?`<span class="tag proc">Verificado</span><label style="font-size:11px;color:var(--gray);display:inline-flex;gap:4px;align-items:center;cursor:pointer" data-tip="Visible en el portal del cliente"><input type="checkbox" style="width:auto" ${d.share?'checked':''} onchange="cur.docs[${d.i}].share=this.checked;save();toast(this.checked?'Compartido con el cliente':'Retirado del cliente')">Compartir</label><button class="btn sm" onclick="toast('Vista previa (simulado)')">Ver</button><button class="btn sm" onclick="toast('Descargando (simulado)')">Descargar</button>`:`<span class="tag ${d.st==='wait'?'wait':'late'}">${d.st==='wait'?'Solicitado':'Pendiente'}</span>${d.st!=='wait'?`<button class="btn sm" onclick="docSt(${d.i},'wait')">Solicitar</button>`:''}<button class="btn sm p" onclick="docSt(${d.i},'ok')">Marcar recibido</button>`}</div></div>`).join('')}`;}).join('')}</div>`;}
function docSt(i,st){const d=cur.docs[i];d.st=st;if(st==='ok'){d.file=d.name.replace(/ /g,'_')+'.pdf';d.size='1.1 MB';d.date=TODAY;d.who='Esteban Mejía';log(cur,`Documento "${d.name}" recibido y verificado.`);}else log(cur,`Documento "${d.name}" solicitado al cliente.`);save();renderTab();toast(st==='ok'?'Documento verificado':'Solicitud registrada');}
function uploadDoc(){const inp=document.createElement('input');inp.type='file';inp.onchange=()=>{const f=inp.files[0];if(!f)return;cur.docs.push({cat:'ADICIONAL',name:f.name,by:'gsd',st:'ok',file:f.name,size:(f.size/1048576).toFixed(1)+' MB',date:TODAY,who:'Esteban Mejía'});log(cur,`Documento "${f.name}" subido.`);save();renderTab();toast('Documento cargado');};inp.click();}

// ===== CHECKLIST / TASKS =====
function checklist(e,T,b){const p=progress(e);b.innerHTML=`<div class="card"><div class="ch"><h2>Checklist del expediente</h2><div style="display:flex;align-items:center;gap:10px"><span style="color:var(--gray);font-size:12px">${p.done} / ${p.total} completadas</span><div class="bar" style="width:140px"><i style="width:${p.pct}%"></i></div><b style="color:var(--navy)">${p.pct}%</b><button class="btn sm p" onclick="taskModal()"><i data-lucide="plus"></i>Tarea</button></div></div>
 ${T.fases.map((f,fi)=>{const ts=e.tasks.filter(t=>t.phase===fi);const d=ts.filter(t=>t.st==='done').length;return `<div class="phase"><div class="ph"><span>Fase ${fi+1} — ${f[0]}</span><small>${d}/${ts.length}</small></div>${ts.map(t=>taskRow(t)).join('')}</div>`;}).join('')}</div>`;}
function taskRow(t){const late=t.due&&t.st!=='done'&&t.st!=='na'&&days(t.due)<0;return `<div class="task"><input type="checkbox" style="width:auto" ${t.st==='done'?'checked':''} onchange="setSt(${t.id},this.checked?'done':'pend')"><span class="t ${t.st==='done'?'done':''}" onclick="taskModal(${t.id})" style="cursor:pointer">${t.name}${t.desc?` <small style="color:var(--gray)">· ${t.desc}</small>`:''}</span><span class="who"><i data-lucide="user"></i> ${t.who}</span><span class="due ${late?'late':''}">${t.due?'<i data-lucide="calendar"></i> '+fd(t.due):'—'}</span><select class="${ST[t.st][1]}" onchange="setSt(${t.id},this.value)">${Object.entries(ST).map(([k,v])=>`<option value="${k}" ${k===t.st?'selected':''}>${v[0]}</option>`).join('')}</select><button class="btn sm ghost" onclick="taskModal(${t.id})"><i data-lucide="pencil"></i></button></div>`;}
function setSt(id,st){const t=cur.tasks.find(x=>x.id===id);const T=TPL[cur.svc];const prev=phaseState(cur,t.phase);t.st=st;if(st==='done')toast('Tarea completada');log(cur,`Tarea "${t.name}" → ${ST[st][0]}.`);if(prev!=='done'&&phaseState(cur,t.phase)==='done'){log(cur,`Etapa "${T.fases[t.phase][0]}" completada. Expediente avanzado automáticamente.`,'Sistema');cur.avances.unshift({date:TODAY,title:`Etapa "${T.fases[t.phase][0]}" completada`,who:'Sistema',desc:`Todas las tareas de la etapa ${T.fases[t.phase][0].toLowerCase()} han sido completadas.`,client:false});}save();renderExp();}
let editTask=null;
function taskModal(id){editTask=id?cur.tasks.find(t=>t.id===id):null;$('mTaskTitle').textContent=editTask?'Editar tarea':'Nueva tarea';$('tWho').innerHTML=TEAM.map(n=>`<option>${n}</option>`).join('');$('tPhase').innerHTML=TPL[cur.svc].fases.map((f,i)=>`<option value="${i}">${f[0]}</option>`).join('');
 $('tName').value=editTask?.name||'';$('tDesc').value=editTask?.desc||'';$('tWho').value=editTask?.who||cur.resp;$('tPhase').value=editTask?editTask.phase:currentPhase(cur);$('tPri').value=editTask?.pri||'Media';$('tDue').value=editTask?.due||'';$('tSt').value=editTask?.st||'pend';openM('mTask');}
function saveTask(){const n=$('tName').value.trim();if(!n){toast('El nombre es obligatorio');return;}const d={name:n,desc:$('tDesc').value,who:$('tWho').value,phase:+$('tPhase').value,pri:$('tPri').value,due:$('tDue').value,st:$('tSt').value};if(editTask){Object.assign(editTask,d);log(cur,`Tarea "${n}" editada.`);}else{cur.tasks.push({id:Math.max(0,...cur.tasks.map(t=>t.id))+1,...d});log(cur,`Tarea "${n}" creada y asignada a ${d.who}.`);}save();closeM('mTask');renderExp();toast('Tarea guardada');}

// ===== TIMELINE =====
function proceso(e,T,b){const cp=currentPhase(e);b.innerHTML=`<div class="card"><h2>Proceso</h2><div class="tl" style="margin-top:14px">${T.fases.map((f,i)=>{const s=phaseState(e,i);return `<div class="s ${s} ${openPhase===i?'open':''}" onclick="openPhase=${openPhase===i?'null':i};renderTab()"><div class="c">${s==='done'?'✓':i+1}</div><b>${f[0]}</b><small>${s==='done'?'Completado':s==='cur'?'En proceso':'Pendiente'}</small></div>`;}).join('')}</div>
 ${openPhase!==null?(()=>{const fi=openPhase,ts=e.tasks.filter(t=>t.phase===fi),d=ts.filter(t=>t.st==='done').length,pct=ts.length?Math.round(d/ts.length*100):0,who=[...new Set(ts.map(t=>t.who))].join(', '),dues=ts.filter(t=>t.due).map(t=>t.due).sort();return `<div style="border-top:1px solid var(--line);padding-top:14px"><div class="ch"><h2>Etapa ${fi+1} — ${T.fases[fi][0]}</h2><span style="color:var(--gray);font-size:12px">${pct}% · ${d}/${ts.length} tareas</span></div><div class="kv" style="margin-bottom:12px"><span class="k">Responsables</span><span class="v">${who||'—'}</span><span class="k">Fechas</span><span class="v">${dues.length?fd(dues[0])+' → '+fd(dues[dues.length-1]):'sin fechas asignadas'}</span><span class="k">Documentos</span><span class="v">${e.docs.filter(x=>x.st!=='ok').length} pendientes en el expediente</span></div>${ts.map(t=>taskRow(t)).join('')}</div>`;})():'<p class="sub">Haga clic en una etapa para ver sus tareas, responsables y fechas.</p>'}</div>`;}

let tkF='all';
function tareas(e,T,b){let ts=e.tasks.map(t=>t);if(tkF==='mine')ts=ts.filter(t=>t.who==='Esteban Mejía');if(tkF==='late')ts=ts.filter(t=>t.due&&t.st!=='done'&&days(t.due)<0);if(tkF==='today')ts=ts.filter(t=>t.due===TODAY);if(tkF==='week')ts=ts.filter(t=>t.due&&days(t.due)>=0&&days(t.due)<=7);if(tkF==='done')ts=ts.filter(t=>t.st==='done');if(tkF==='all')ts=ts.filter(t=>t.st!=='done');
 b.innerHTML=`<div class="card"><div class="ch"><h2>Tareas</h2><button class="btn p" onclick="taskModal()"><i data-lucide="plus"></i>Nueva tarea</button></div><div class="filters">${[['all','Todas'],['mine','Mis tareas'],['late','Vencidas'],['today','Hoy'],['week','Esta semana'],['done','Completadas']].map(x=>`<button class="${tkF===x[0]?'on':''}" onclick="tkF='${x[0]}';renderTab()">${x[1]}</button>`).join('')}</div>
 <table><thead><tr><th>Tarea</th><th>Etapa</th><th>Responsable</th><th>Fecha límite</th><th>Prioridad</th><th>Estado</th></tr></thead><tbody>${ts.map(t=>`<tr class="row" onclick="taskModal(${t.id})"><td>${t.name}</td><td>${T.fases[t.phase][0]}</td><td>${t.who}</td><td class="${t.due&&t.st!=='done'&&days(t.due)<0?'st-block':''}">${fd(t.due)}</td><td><span class="tag ${t.pri==='Alta'?'hi':t.pri==='Media'?'med':'lo'}">${t.pri}</span></td><td class="${ST[t.st][1]}">● ${ST[t.st][0]}</td></tr>`).join('')||'<tr><td colspan="6" class="empty">Sin tareas en este filtro.</td></tr>'}</tbody></table></div>`;}

// ===== AVANCES / NOTAS / ACTUALIZACIÓN AL CLIENTE =====
function avances(e,T,b){b.innerHTML=`<div class="card"><div class="ch"><h2>Avances del expediente</h2><div style="display:flex;gap:8px"><button class="btn" onclick="noteModal(true)"><i data-lucide="plus"></i>Registrar avance</button><button class="btn p" onclick="genUpdate()"><i data-lucide="send"></i>Generar actualización</button></div></div><p class="sub" style="margin-bottom:10px">Los avances marcados como visibles alimentan la actualización al cliente y el futuro portal.</p>
 <div class="feed">${e.avances.map((a,i)=>`<div class="it"><div class="d">${fd(a.date).toUpperCase()}</div><div><b>${a.title}</b><p>${a.desc}</p><div class="who">Responsable: ${a.who}</div><label style="display:inline-flex;gap:6px;align-items:center;margin-top:6px;font-size:11.5px;cursor:pointer"><input type="checkbox" style="width:auto" ${a.client?'checked':''} onchange="cur.avances[${i}].client=this.checked;save();renderTab()"> ${a.client?'<span class="tag proc">VISIBLE PARA CLIENTE</span>':'<span class="tag done">SOLO INTERNO</span>'}</label></div></div>`).join('')||'<div class="empty">Sin avances registrados.</div>'}</div></div>`;}
let noteIsAdv=false;
function noteModal(adv){noteIsAdv=adv;$('mNoteTitle').textContent=adv?'Registrar avance':'Agregar nota interna';$('noteVisWrap').classList.toggle('hidden',!adv);$('noteVis').checked=adv;$('noteTxt').value='';openM('mNote');}
function saveNote(){const t=$('noteTxt').value.trim();if(!t){toast('Escriba el contenido');return;}if(noteIsAdv){cur.avances.unshift({date:TODAY,title:t.split('.')[0].slice(0,70),who:'Esteban Mejía',desc:t,client:$('noteVis').checked});log(cur,'Avance registrado.');}else{cur.notas.unshift({date:TODAY,who:'Esteban Mejía',txt:t});log(cur,'Se agregó nota interna.');}save();closeM('mNote');renderExp();toast(noteIsAdv?'Avance registrado':'Nota guardada');}
function genUpdate(){const e=cur,T=TPL[e.svc],p=progress(e),cp=currentPhase(e),last=e.avances.find(a=>a.client),next=e.tasks.filter(t=>t.st!=='done'&&t.st!=='na')[0];
 $('updPaper').innerHTML=`<img class="lg" src="${document.querySelector('.side img').src}"><h3>ACTUALIZACIÓN DE SU PROCESO</h3><p style="margin-top:10px">Estimado ${e.cliente.nombre}:</p><p style="margin-top:8px">Nos complace informarle que su expediente de ${T.nombre} (${e.id}) ha avanzado satisfactoriamente.</p><div class="kv"><span class="k">Estado actual</span><span class="v">${T.fases[cp][0]}</span><span class="k">Progreso</span><span class="v">${p.pct}%</span><span class="k">Último avance</span><span class="v">${last?last.desc:'—'}</span><span class="k">Próximo paso</span><span class="v">${next?next.name:'Cierre del expediente'}</span><span class="k">Fecha estimada</span><span class="v">${fd(e.fin)}</span></div><p style="margin-top:8px">Quedamos a su disposición para cualquier consulta.</p><p style="margin-top:14px">Atentamente,<br><b style="font-weight:500;color:var(--navy)">Geosolutions Source Dominicana, S.R.L.</b><br><small style="color:var(--gray)">Punta Cana · +1 (829) 493-7254 · mejia2925@gmail.com</small></p>`;openM('mUpd');}
function clientView(){const e=cur,T=TPL[e.svc],p=progress(e),cp=currentPhase(e),last=e.avances.find(a=>a.client),shared=e.docs.filter(d=>d.share&&d.st==='ok'),next=T.fases.slice(cp,cp+3);
 $('clientView').innerHTML=`<div class="cv"><div class="top"><div><small>PORTAL DEL CLIENTE · VISTA PREVIA</small><b style="font-size:15px;font-weight:500">${T.nombre}</b><div style="font-size:12px;color:#CFE3D8">${e.id}</div></div><img src="${document.querySelector('.side img').src}" style="width:110px;filter:brightness(0) invert(1)"></div>
 <div class="body"><p class="sub">Estimado ${e.cliente.nombre}, este es el estado de su proceso al ${fd(TODAY)}.</p>
 <div style="margin:14px 0"><div style="display:flex;justify-content:space-between;font-size:12px"><span style="color:var(--gray)">Progreso</span><b style="color:var(--navy)">${p.pct}%</b></div><div class="bar" style="height:10px;margin-top:6px"><i style="width:${p.pct}%"></i></div></div>
 <div class="kv" style="grid-template-columns:140px 1fr"><span class="k">Estado actual</span><span class="v">${T.fases[cp][0]}</span><span class="k">Última actualización</span><span class="v">${last?fd(last.date)+' — '+last.desc:'—'}</span><span class="k">Fecha estimada</span><span class="v">${fd(e.fin)}</span></div>
 <h2 style="margin-top:16px;font-size:13px">Próximos pasos</h2>${next.map((f,i)=>`<div class="step"><span class="n">${i+1}</span><div><b style="font-weight:500;color:var(--navy)">${f[0]}</b></div></div>`).join('')}
 <h2 style="margin-top:16px;font-size:13px">Documentos compartidos</h2>${shared.map(d=>`<div class="doc"><div class="ic"><i data-lucide="file-check"></i></div><div><b>${d.name}</b><small>${fd(d.date)}</small></div></div>`).join('')||'<p class="sub">Aún no hay documentos compartidos.</p>'}
 <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--line);font-size:12px;color:var(--gray)">Su contacto en GSD: <b style="color:var(--navy);font-weight:500">${e.resp}</b> · +1 (829) 493-7254 · mejia2925@gmail.com<br><span style="font-style:italic;color:var(--green)">Los límites, claros.</span></div></div></div>`;openM('mClient');}
function copyUpd(){navigator.clipboard?.writeText($('updPaper').innerText);toast('Texto copiado');}

function bitacora(e,T,b){b.innerHTML=`<div class="card"><h2>Bitácora</h2><div class="log" style="margin-top:10px">${e.log.map(l=>`<div class="it"><span class="d">${l.d.replace(' ',' — ')}</span><span class="w">${l.w}</span><span>${l.t}</span></div>`).join('')}</div></div>`;}
function evidencias(e,T,b){b.innerHTML=`<div class="card"><div class="ch"><h2>Evidencias de campo</h2><button class="btn p" onclick="$('evFile').value='';$('evDesc').value='';$('evCoord').value='';openM('mEv')"><i data-lucide="camera"></i>Agregar evidencia</button></div><div class="gal">${e.evid.map(v=>`<div class="ev"><div class="ph" ${v.img?`style="background-image:url(${v.img})"`:''}>${v.img?'':'<i data-lucide="image"></i>'}</div><div class="b"><b>${v.t}</b><small>${v.d.replace(' ',' · ')}</small><small>${v.c}</small><small>${v.w}</small></div></div>`).join('')||'<div class="empty" style="grid-column:1/-1">Sin evidencias. Agregue fotografías de campo.</div>'}</div></div>`;}
function saveEv(){const f=$('evFile').files[0],d=$('evDesc').value.trim();if(!d){toast('Agregue una descripción');return;}const add=img=>{cur.evid.unshift({t:d,d:TODAY+' '+new Date().toTimeString().slice(0,5),c:$('evCoord').value||'—',w:'Esteban Mejía',img});log(cur,`Evidencia "${d}" cargada.`);save();closeM('mEv');renderTab();icons();toast('Evidencia agregada');};if(f){const r=new FileReader();r.onload=()=>add(r.result);r.readAsDataURL(f);}else add('');}
function finanzas(e,T,b){const pag=e.pagos.filter(p=>p.st==='Pagado').reduce((a,p)=>a+p.m,0),pct=Math.round(pag/e.honorario*100);b.innerHTML=`<div class="kpis" style="grid-template-columns:repeat(4,1fr)"><div class="kpi"><div class="l">Honorario contratado</div><div class="v">${e.mon}${fmt(e.honorario)}</div></div><div class="kpi"><div class="l">Pagado</div><div class="v" style="color:var(--green)">${e.mon}${fmt(pag)}</div></div><div class="kpi"><div class="l">Pendiente</div><div class="v" style="color:${e.honorario-pag?'var(--red)':'var(--navy)'}">${e.mon}${fmt(e.honorario-pag)}</div></div><div class="kpi"><div class="l">Progreso de pago</div><div class="v">${pct}%</div><div class="bar" style="margin-top:6px"><i style="width:${pct}%"></i></div></div></div>
 <div class="card"><div class="ch"><h2>Historial de pagos</h2></div><table><thead><tr><th>Fecha</th><th>Concepto</th><th>Monto</th><th>Estado</th><th></th></tr></thead><tbody>${e.pagos.map((p,i)=>`<tr><td>${fd(p.d)}</td><td>${p.c}</td><td>${e.mon}${fmt(p.m)}</td><td><span class="tag ${p.st==='Pagado'?'proc':'wait'}">${p.st}</span></td><td>${p.st!=='Pagado'?`<button class="btn sm" onclick="cur.pagos[${i}].st='Pagado';cur.pagos[${i}].d='${TODAY}';log(cur,'Pago registrado: ${p.c}.');save();renderTab();toast('Pago registrado')">Registrar pago</button>`:''}</td></tr>`).join('')}</tbody></table></div>`;}

// ===== MODALS: nuevo expediente =====
$('btnNewExp').onclick=()=>{
  $('nQuote').innerHTML=quotes.length ? quotes.map(q=>`<option value="${q.ref}">${q.ref} — ${q.cli}</option>`).join('') : '<option value="">(Sin cotizaciones aprobadas)</option>';
  $('nSvc').innerHTML=Object.entries(TPL).map(([k,t])=>`<option value="${k}">${t.nombre}</option>`).join('');
  $('nResp').innerHTML=TEAM.map(n=>`<option>${n}</option>`).join('');
  if (!quotes.length) {
    const rM = document.querySelector('input[name=orig][value="m"]');
    if (rM) { rM.checked = true; rM.dispatchEvent(new Event('change')); }
  } else {
    const rQ = document.querySelector('input[name=orig][value="q"]');
    if (rQ) { rQ.checked = true; rQ.dispatchEvent(new Event('change')); }
  }
  quoteInfo();
  openM('mNew');
};
$('nQuote').onchange=quoteInfo;
function quoteInfo(){
  const q=quotes.find(x=>x.ref===$('nQuote').value);
  if(!q){$('nQuoteInfo').innerHTML='<span class="sub" style="display:block;padding:6px 0;">No hay cotizaciones aprobadas registradas. Puede seleccionar "Creación manual" arriba para crear el expediente directamente.</span>';return;}
  $('nQuoteInfo').innerHTML=`<div class="kv" style="grid-template-columns:100px 1fr"><span class="k">Cliente</span><span class="v">${q.cli}</span><span class="k">Servicio</span><span class="v">${TPL[q.svc]?.nombre||'Servicio'}</span><span class="k">Honorario</span><span class="v">${q.mon||'USD'}${fmt(q.hon||0)}</span><span class="k">Objeto</span><span class="v">${q.obj||'—'}</span></div>`;
}
document.querySelectorAll('input[name=orig]').forEach(r=>r.onchange=()=>{
  document.querySelectorAll('.radio label').forEach(l=>l.classList.toggle('on',l.querySelector('input').checked));
  const q=r.value==='q';
  $('newQ').classList.toggle('hidden',!q);
  $('newM').classList.toggle('hidden',q);
});
function createExp(){
  const fromQ=document.querySelector('input[name=orig]:checked')?.value==='q';
  let cli='',svc='deslinde',hon=0,mon='US$',quote='',obj='';
  if(fromQ){
    const q=quotes.find(x=>x.ref===$('nQuote').value);
    if(!q){toast('Seleccione una cotización válida o elija Creación manual');return;}
    cli=q.cli;svc=q.svc||'deslinde';hon=parseFloat(q.hon)||0;mon=q.mon||'US$';quote=q.ref;obj=q.obj||'';
    quotes=quotes.filter(x=>x!==q);
  } else {
    cli=$('nCli').value.trim();
    svc=$('nSvc').value||'deslinde';
    hon=parseFloat(($('nHon').value||'0').replace(/[^\d.]/g,''))||0;
    quote='Manual';
    obj=$('nObj').value.trim()||'Inmueble / Asunto general';
    if(!cli){toast('Por favor ingrese el nombre del cliente');return;}
  }
  const T=TPL[svc]||TPL.deslinde;
  const nSeq = (DB.length > 0 ? Math.max(...DB.map(e => parseInt((e.id||'').split('-')[2])||0)) : 0) + 1;
  const id = (fromQ && quote && quote.includes('-')) ? `EXP-2026-${String(parseInt(quote.split('-')[3]) || nSeq).padStart(3, '0')}` : `EXP-2026-${String(nSeq).padStart(3, '0')}`;
  const resp=$('nResp').value||TEAM[0];
  const objeto={};
  Object.keys(T.objeto).forEach(k=>objeto[k]='');
  if(svc==='deslinde'){
    const m=obj.match(/Parcela ([\w-]+)/);objeto.parcela=m?m[1]:'';
    const a=obj.match(/([\d,]+ m²)/);objeto.areaReg=a?a[1]:'';
    objeto.provincia='La Altagracia';objeto.municipio='Higüey';objeto.sector=obj.split('·').pop().trim()||'Punta Cana';
    objeto.propietario=cli;
  }
  if(svc==='transferencia'){
    const m=obj.match(/Matrícula (\d+)/);objeto.matricula=m?m[1]:'';
    objeto.comprador=cli;objeto.sector=obj.split('·').pop().trim()||'Punta Cana';
  }
  if(svc==='iguala'){
    objeto.empresa=cli;objeto.nivel=obj.includes('Business')?'Business':'Essential';objeto.sede=obj.split('·').pop().trim()||'Punta Cana';
  }
  const e={
    id,quote,svc,cliente:{nombre:cli,cedula:'',tel:'',email:'',dir:''},honorario:hon,mon,
    pagos:[{d:'',c:'Pago inicial',m:hon/2,st:'Pendiente'},{d:'',c:'Saldo',m:hon/2,st:'Pendiente'}],
    aprob:TODAY,inicio:TODAY,fin:addDays(TODAY,T.plazo||90),resp,tec:T.tec?'Carlos Rodríguez':'',
    pri:$('nPri').value||'Media',estado:'proc',objeto,ubic:{coord:'',ref:'',dir:''},
    linderos:{Norte:'',Sur:'',Este:'',Oeste:''},
    tecnico:{tipo:'GNSS RTK',equipo:'Apeks',sist:'UTM',zona:'19N',datum:'WGS84',prec:''},
    docs:(T.docs||[]).map(d=>({cat:d[0],name:d[1],by:d[2],share:false,st:'miss',file:'',size:'',date:'',who:resp})),
    tasks:mkTasks(T,'-1'),
    avances:[{date:TODAY,title:'Expediente abierto',who:resp,desc:'Se abrió el expediente y se inició el proceso.',client:true}],
    notas:[],
    log:[{d:TODAY+' '+new Date().toTimeString().slice(0,5),w:'Sistema',t:fromQ?`Expediente creado desde cotización ${quote}.`:'Expediente creado manualmente.'}],
    evid:[]
  };
  if (e.tasks && e.tasks.length > 0) e.tasks[0].due=addDays(TODAY,5);
  DB.unshift(e);
  cur = e;
  save();
  closeM('mNew');
  openExp(id);
  toast(`${id} creado`);
}

// ===== INIT =====
const h=new Date().getHours();
if ($('greet')) $('greet').textContent=(h<12?'Buenos días':h<19?'Buenas tardes':'Buenas noches')+', Esteban';
const initView = '<%= typeof initialView !== "undefined" ? initialView : "dash" %>';
go(initView, false);
renderMy();
icons();
</script>
</body>
</html>
