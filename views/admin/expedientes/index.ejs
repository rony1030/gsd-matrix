                  </button>
                  <button type="button" class="btn sm ghost" onclick="downloadDocDirect('${d.expId}', '${encodeURIComponent(d.name)}')" title="Descargar">
                    <i data-lucide="download"></i>
                  </button>
                </div>
              </div>
            `).join('')}
          </div>
        ` : `
          <p class="sub" style="text-align:center;padding:30px;">Sin documentos específicos adjuntos en los expedientes.</p>
        `}
      </div>
    `;
  } else if (tabName === 'bitacora') {
    body.innerHTML = `
      <div class="card" style="margin-bottom:14px;">
        <h3 style="margin-bottom:10px;">Agregar Nota de Seguimiento / Acuerdo</h3>
        <div>
          <textarea id="cliQuickNoteTxt" placeholder="Escribe un resumen de llamada, reunión o interés del cliente..." style="min-height:70px;"></textarea>
        </div>
        <div style="display:flex;justify-content:flex-end;margin-top:8px;">
