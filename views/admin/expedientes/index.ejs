const TODAY=new Date().toISOString().slice(0,10);
const $=id=>document.getElementById(id);
const fmt=n=>Number(n).toLocaleString('en-US');
const M=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
const fd=s=>{if(!s)return '—';const [y,m,d]=s.slice(0,10).split('-');return `${parseInt(d)} ${M[m-1]} ${y}`;};
const days=s=>Math.round((new Date(s+'T00:00:00')-new Date(TODAY+'T00:00:00'))/864e5);
const ST={pend:['Pendiente','st-pend'],proc:['En proceso','st-proc'],done:['Completado','st-done'],block:['Bloqueado','st-block'],na:['No aplica','st-na']};
const ESTADO={proc:['EN PROCESO','proc'],rev:['EN REVISIÓN','rev'],wait:['ESPERANDO CLIENTE','wait'],done:['CERRADO','done']};
const ini=n=>n.split(' ').map(x=>x[0]).join('').slice(0,2).toUpperCase();
function progress(e){const t=e.tasks.filter(x=>x.st!=='na');const d=t.filter(x=>x.st==='done').length;return{pct:t.length?Math.round(d/t.length*100):0,done:d,total:t.length};}
function phaseState(e,fi){const t=e.tasks.filter(x=>x.phase===fi&&x.st!=='na');if(t.length&&t.every(x=>x.st==='done'))return 'done';if(t.some(x=>x.st==='done'||x.st==='proc'))return 'cur';return 'pend';}
function currentPhase(e){const f=(TPL[e.svc]||TPL.deslinde).fases;for(let i=0;i<f.length;i++){if(phaseState(e,i)!=='done')return i;}return f.length-1;}
function toast(m){const t=$('toast');t.textContent=m;t.classList.add('on');setTimeout(()=>t.classList.remove('on'),2200);}
function confirmA(title,text,fn){$('cfTitle').textContent=title;$('cfText').textContent=text;$('cfOk').onclick=()=>{closeM('mConfirm');fn();};openM('mConfirm');}
function openM(id){$(id).classList.add('on');icons();}function closeM(id){$(id).classList.remove('on');}
function log(e,t,w='Esteban Mejía'){e.log.unshift({d:TODAY+' '+new Date().toTimeString().slice(0,5),w,t});}

