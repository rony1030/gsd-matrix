function toggleStepperExpand() {
  stepperExpanded = !stepperExpanded;
  renderExp();
}

function renderStepper(e, T) {
  const fases = (T && T.fases) ? T.fases : [];
  if (!fases.length) return '';
  const total = fases.length;
  const doneCount = fases.filter((_, i) => phaseState(e, i) === 'done').length;
  const curIdx = currentPhase(e);
  const curFaseName = fases[curIdx] ? fases[curIdx][0] : 'En curso';
  const pctTotal = Math.round((doneCount / total) * 100);

  return `
  <div class="exp-stepper-container">
    <div class="stepper-hero-top">
      <div style="display:flex;align-items:center;gap:8px;min-width:0;cursor:pointer;" onclick="toggleStepperExpand()">
        <div class="stepper-icon-badge">
          <i data-lucide="git-merge" style="width:15px;height:15px;"></i>
        </div>
        <div style="min-width:0;">
          <h3 class="stepper-title">Línea de Tiempo del Proceso</h3>
          <span class="stepper-subtitle">Etapa actual: <strong>${curIdx+1}. ${curFaseName}</strong></span>
        </div>
      </div>
      <div class="stepper-meta">
        <span class="stepper-pill-count"><b>${doneCount} de ${total}</b></span>
        <span class="stepper-pill-pct">${pctTotal}%</span>
        <button type="button" class="btn sm ghost stepper-toggle-btn" onclick="toggleStepperExpand()" style="padding:3px 8px;font-size:11px;font-weight:600;display:inline-flex;align-items:center;gap:4px;color:var(--navy);background:#fff;border:1px solid var(--line);border-radius:6px;" title="${stepperExpanded ? 'Contraer línea de tiempo' : 'Expandir etapas'}">
          <span>${stepperExpanded ? 'Contraer' : 'Expandir'}</span>
          <i data-lucide="${stepperExpanded ? 'chevron-up' : 'chevron-down'}" style="width:13px;height:13px;"></i>
        </button>
      </div>
    </div>

    <!-- Segmented Pipeline Progress Bar (Siempre visible) -->
    <div class="stepper-pipeline-bar" style="cursor:pointer;" onclick="if(!stepperExpanded){ stepperExpanded=true; renderExp(); }">
      ${fases.map((f, i) => {
        const s = phaseState(e, i);
        const isOpen = openPhase === i;
        return `
          <div class="pipeline-segment ${s} ${isOpen ? 'active' : ''}" onclick="event.stopPropagation(); togglePhaseDrawer(${i})" title="Etapa ${i+1}: ${f[0]} (${s==='done'?'Completada':s==='cur'?'En curso':'Pendiente'})"></div>
        `;
      }).join('')}
    </div>

    ${stepperExpanded ? `
      <!-- Desktop Grid of Interactive Stage Cards -->
      <div class="stepper-cards-grid">
        ${fases.map((f, i) => {
          const s = phaseState(e, i);
          const isOpen = openPhase === i;
          const ts = (e.tasks || []).filter(t => t.phase === i && t.st !== 'na');
          const d = ts.filter(t => t.st === 'done').length;
          const isCur = s === 'cur';
          const isDone = s === 'done';
          return `
            <div class="stage-card ${s} ${isOpen ? 'selected' : ''}" onclick="togglePhaseDrawer(${i})" title="Haz clic para ver tareas de la Etapa ${i+1}">
              <div class="stage-card-header">
                <span class="stage-num-badge ${s}">
                  ${isDone ? '<i data-lucide="check" style="width:11px;height:11px;stroke-width:3"></i>' : (i + 1)}
                </span>
                <span class="stage-status-tag ${s}">
                  ${isDone ? 'Listo' : isCur ? 'En curso' : 'Pendiente'}
                </span>
              </div>
              <div class="stage-card-title">${f[0]}</div>
              <div class="stage-card-footer">
                <span><i data-lucide="check-circle-2" style="width:11px;height:11px;vertical-align:-1px;margin-right:2px;"></i>${d}/${ts.length} tareas</span>
                ${ts.length ? `<span class="stage-pct-mini">${Math.round(d/ts.length*100)}%</span>` : ''}
              </div>
            </div>
          `;
        }).join('')}
      </div>

      <!-- Mobile View: Clean Vertical Pipeline Checklist -->
      <div class="stepper-mobile-view">
        <div class="mobile-timeline-list">
          ${fases.map((f, i) => {
            const s = phaseState(e, i);
            const isOpen = openPhase === i;
            const ts = (e.tasks || []).filter(t => t.phase === i && t.st !== 'na');
            const d = ts.filter(t => t.st === 'done').length;
            const isCur = s === 'cur';
            const isDone = s === 'done';
            return `
              <div class="mobile-timeline-item ${s} ${isOpen ? 'open' : ''}">
                <div class="mobile-timeline-track">
                  <div class="mobile-timeline-node ${s}">
                    ${isDone ? '<i data-lucide="check" style="width:11px;height:11px;stroke-width:3"></i>' : (i + 1)}
                  </div>
                  ${i < total - 1 ? `<div class="mobile-timeline-line ${isDone ? 'done' : ''}"></div>` : ''}
                </div>
                <div class="mobile-timeline-content" onclick="togglePhaseDrawer(${i})">
                  <div class="mobile-timeline-header">
                    <span class="mobile-stage-name">${i+1}. ${f[0]}</span>
                    <span class="stage-status-tag ${s}">${isDone ? 'Completada' : isCur ? 'En proceso' : 'Pendiente'}</span>
                  </div>
                  <div class="mobile-timeline-sub">
                    <span>${d} de ${ts.length} tareas (${ts.length ? Math.round(d/ts.length*100) : 0}%)</span>
                    <span style="display:flex;align-items:center;gap:2px;color:var(--navy);font-weight:600;font-size:11px;">
                      ${isOpen ? 'Ocultar' : 'Ver detalle'} <i data-lucide="${isOpen ? 'chevron-up' : 'chevron-down'}" style="width:12px;height:12px;"></i>
                    </span>
                  </div>
                </div>
              </div>
              ${isOpen ? `
                <div class="mobile-inline-drawer">
                  <div style="font-size:11px;color:var(--gray);margin-bottom:8px;">
                    <b>Etapa ${i+1}:</b> ${f[0]}
                  </div>
                  ${ts.map(t => taskRow(t)).join('') || '<p class="sub" style="font-size:11.5px;padding:4px 0;">Sin tareas en esta etapa.</p>'}
                </div>
              ` : ''}
            `;
          }).join('')}
        </div>
      </div>

      <!-- Desktop Detail Drawer -->
      ${openPhase !== null && fases[openPhase] ? (() => {
        const fi = openPhase;
        const ts = (e.tasks || []).filter(t => t.phase === fi);
        const d = ts.filter(t => t.st === 'done').length;
        const pct = ts.length ? Math.round(d / ts.length * 100) : 0;
        const who = [...new Set(ts.map(t => t.who))].filter(Boolean).join(', ');
        const dues = ts.filter(t => t.due).map(t => t.due).sort();
        return `
        <div class="stepper-desktop-drawer">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid var(--line);">
            <div style="display:flex;align-items:center;gap:8px">
              <span class="tag ${phaseState(e, fi) === 'done' ? 'proc' : phaseState(e, fi) === 'cur' ? 'wait' : 'done'}" style="font-weight:700;">Etapa ${fi+1}</span>
              <b style="font-size:13.5px;color:var(--navy)">${fases[fi][0]}</b>
            </div>
            <div style="display:flex;align-items:center;gap:10px">
              <span style="font-size:12px;font-weight:600;color:var(--navy);">${pct}% (${d}/${ts.length} tareas)</span>
              <button class="btn sm ghost" onclick="togglePhaseDrawer(null)" style="padding:2px 6px" title="Cerrar detalle"><i data-lucide="x"></i></button>
            </div>
          </div>
          <div class="kv" style="grid-template-columns:120px 1fr;margin-bottom:10px;font-size:11.5px">
            <span class="k">Responsables:</span><span class="v">${who || '—'}</span>
            <span class="k">Plazo estimado:</span><span class="v">${dues.length ? fd(dues[0]) + ' → ' + fd(dues[dues.length-1]) : 'Sin fechas asignadas'}</span>
          </div>
          <div style="max-height:220px;overflow-y:auto">
            ${ts.map(t => taskRow(t)).join('') || '<p class="sub" style="font-size:11.5px;padding:6px 0">Sin tareas en esta etapa.</p>'}
          </div>
        </div>
        `;
      })() : ''}
    ` : ''}
  </div>
  `;
}

function togglePhaseDrawer(i) {
  if (i === null) {
    openPhase = null;
  } else {
    if (openPhase === i) {
