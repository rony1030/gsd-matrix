function printTplPdf() {
  const paper = $('tplPdfPaper');
  if (!paper) return;
  toast('Generando y descargando PDF...');
  const t = TPL[_curTplKey] || { nombre: 'Plantilla_GSD' };
  const filename = `Ficha_Tecnica_${(t.nombre || 'Servicio').replace(/[^a-z0-9]/gi, '_')}_GSD.pdf`;
  if (window.html2pdf) {
    const opt = {
      margin: [8, 8, 8, 8],
      filename: filename,
      image: { type: 'jpeg', quality: 0.98 },
      html2canvas: { scale: 2, useCORS: true, logging: false },
      jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
    };
    html2pdf().set(opt).from(paper).save().then(() => {
      toast('PDF descargado con éxito');
    }).catch(err => {
      console.log('PDF download error:', err);
      toast('PDF procesado');
    });
  } else {
    toast('Descarga en proceso...');
  }
}

