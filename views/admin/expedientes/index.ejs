function alerts(){const out=[];DB.forEach(e=>{if(e.estado==='done')return;e.tasks.forEach(t=>{if(t.due&&t.st!=='done'&&t.st!=='na'){const d=days(t.due);if(d<0)out.push({c:'r',t:'Tarea vencida',n:t.name,e:e.id,s:`Vencida hace ${-d} día${-d>1?'s':''}`,w:t.who});else if(d<=3)out.push({c:'y',t:'Vencimiento próximo',n:t.name,e:e.id,s:d===0?'Vence hoy':`Vence en ${d} día${d>1?'s':''}`,w:t.who});}});const w=e.docs.filter(d=>d.st!=='ok'&&d.by==='cliente');if(w.length)out.push({c:'o',t:'Documentación pendiente',n:'Falta '+w[0].name.toLowerCase()+(w.length>1?` y ${w.length-1} más`:''),e:e.id,s:'Esperando cliente',w:e.resp});});return out.sort((a,b)=>'ryo'.indexOf(a.c)-'ryo'.indexOf(b.c));}

// ===== NAVIGATION: vistas globales con sincronizacion URL =====
const URL_MAP = {
  dash: '/admin',
  list: '/admin/expedientes',
  mytasks: '/admin/tareas',
  cal: '/admin/calendario',
  clients: '/admin/clientes',
  docs: '/admin/documentos',
  tpl: '/admin/plantillas'
};

function go(v, push = true){
  if (!v || !$('v-'+v)) v = 'dash';
  document.querySelectorAll('.view').forEach(x=>x.classList.remove('on'));
  $('v-'+v).classList.add('on');
  document.querySelectorAll('.side a').forEach(a => a.classList.remove('on'));
  const targetA = document.querySelector(`.side a[data-view="${v}"]`);
  if (targetA) targetA.classList.add('on');
  $('main').scrollTop=0;
  ({dash:renderDash,list:renderList,mytasks:renderMy,cal:renderCal,clients:renderCli,docs:renderDocsAll,tpl:renderTpl})[v]?.();
  if (typeof updateTaskBadge === 'function') updateTaskBadge();
  icons();
  if (push && URL_MAP[v] && window.location.pathname !== URL_MAP[v]) {
    history.pushState({view: v}, '', URL_MAP[v]);
  }
}

window.addEventListener('popstate', (e) => {
  if (e.state && e.state.view) {
    go(e.state.view, false);
  } else {
    const p = window.location.pathname;
    const matched = Object.keys(URL_MAP).find(k => URL_MAP[k] === p);
    go(matched || 'dash', false);
  }
});

document.querySelectorAll('.side a[data-view]').forEach(a => {
  a.addEventListener('click', (e) => {
    e.preventDefault();
    go(a.dataset.view);
  });
});
