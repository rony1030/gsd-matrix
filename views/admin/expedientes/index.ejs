  card.querySelectorAll('input[data-k]').forEach(i=>obj[i.dataset.k]=i.value);
  log(cur,`Bloque "${card.querySelector('h2').textContent}" actualizado.`);
  save();renderExp();toast('Cambios guardados');
}

// ===== CHECKLIST & TASKS =====
function checklist(e,T,b){
  const p=progress(e);
  b.innerHTML=`<div class="card">
    <div class="ch">
      <h2>Checklist del expediente</h2>
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span style="color:var(--gray);font-size:12px">${p.done} / ${p.total} completadas</span>
        <div class="bar" style="width:120px"><i style="width:${p.pct}%"></i></div>
        <b style="color:var(--navy)">${p.pct}%</b>
        <button class="btn sm p" onclick="taskModal()"><i data-lucide="plus"></i>Tarea</button>
      </div>
    </div>
    ${T.fases.map((f,fi)=>{
      const ts=e.tasks.filter(t=>t.phase===fi);
      const d=ts.filter(t=>t.st==='done').length;
      return `<div class="phase" style="margin-bottom:14px;">
        <div class="ph" style="display:flex;justify-content:space-between;align-items:center;">
          <span>Fase ${fi+1} — ${f[0]}</span>
          <div style="display:flex;align-items:center;gap:8px;">
            <small style="color:var(--gray);font-weight:600;">${d}/${ts.length}</small>
            <button class="btn sm" onclick="taskModal(null, ${fi})" style="padding:2px 7px;font-size:11px;" title="Agregar tarea a esta etapa"><i data-lucide="plus" style="width:12px;height:12px"></i>Tarea</button>
          </div>
        </div>
        ${ts.length ? ts.map(t=>taskRow(t)).join('') : '<div style="padding:8px 12px;color:var(--gray);font-size:11.5px;font-style:italic;">Sin tareas en esta etapa. Haga clic en "+ Tarea" para agregar una.</div>'}
      </div>`;
    }).join('')}
  </div>`;
}

function taskRow(t){
  const late=t.due&&t.st!=='done'&&t.st!=='na'&&days(t.due)<0;
  return `
  <div class="task">
    <div class="task-top-row">
      <input type="checkbox" style="width:auto;margin-top:2px;flex-shrink:0" ${t.st==='done'?'checked':''} onchange="setSt(${t.id},this.checked?'done':'pend')">
      <span class="t ${t.st==='done'?'done':''}" onclick="taskModal(${t.id})" style="cursor:pointer;flex:1;font-weight:500;font-size:12.5px;color:var(--navy);">${t.name}${t.desc?` <small style="color:var(--gray);display:block;font-size:11px;font-weight:400;">${t.desc}</small>`:''}</span>
      <button class="btn sm ghost task-edit-btn" onclick="taskModal(${t.id})" title="Editar" style="padding:2px 6px;"><i data-lucide="pencil" style="width:13px;height:13px;"></i></button>
    </div>
    <div class="task-bottom-row">
      <div style="display:flex;align-items:center;gap:8px;font-size:11px;color:var(--gray);">
        <span class="who"><i data-lucide="user" style="width:11px;height:11px;vertical-align:-1px;margin-right:2px;"></i>${t.who.split(' ')[0]}</span>
        <span class="due ${late?'late':''}"><i data-lucide="calendar" style="width:11px;height:11px;vertical-align:-1px;margin-right:2px;"></i>${t.due ? fd(t.due) : 'Sin fecha'}</span>
      </div>
      <select class="${ST[t.st]?ST[t.st][1]:''}" onchange="setSt(${t.id},this.value)" style="width:auto;padding:2px 6px;font-size:11px;font-weight:600;border-radius:5px;">
        ${Object.entries(ST).map(([k,v])=>`<option value="${k}" ${k===t.st?'selected':''}>${v[0]}</option>`).join('')}
      </select>
    </div>
  </div>`;
}

function setSt(id,st){
  const t=cur.tasks.find(x=>x.id===id);
  if(!t) return;
  const T=TPL[cur.svc]||TPL.deslinde;
  const prev=phaseState(cur,t.phase);
  t.st=st;
  if(st==='done')toast('Tarea completada');
  log(cur,`Tarea "${t.name}" → ${ST[st]?ST[st][0]:st}.`);
  if(prev!=='done'&&phaseState(cur,t.phase)==='done'){
    log(cur,`Etapa "${T.fases[t.phase][0]}" completada. Expediente avanzado automáticamente.`,'Sistema');
    cur.avances.unshift({date:TODAY,title:`Etapa "${T.fases[t.phase][0]}" completada`,who:'Sistema',desc:`Todas las tareas de la etapa ${T.fases[t.phase][0].toLowerCase()} han sido completadas.`,client:false});
  }
  save();
  renderExp();
}

let editTask=null;
function taskModal(id, phaseIndex){
  editTask=id?cur.tasks.find(t=>t.id===id):null;
  $('mTaskTitle').textContent=editTask?'Editar tarea':'Nueva tarea';
  $('tWho').innerHTML=TEAM.map(n=>`<option>${n}</option>`).join('');
  $('tPhase').innerHTML=(TPL[cur.svc]||TPL.deslinde).fases.map((f,i)=>`<option value="${i}">Fase ${i+1} — ${f[0]}</option>`).join('');
  $('tName').value=editTask?.name||'';
  $('tDesc').value=editTask?.desc||'';
  $('tWho').value=editTask?.who||cur.resp;
  $('tPhase').value=editTask?editTask.phase:(phaseIndex!==undefined?phaseIndex:currentPhase(cur));
  $('tPri').value=editTask?.pri||'Media';
  $('tDue').value=editTask?.due||'';
  $('tSt').value=editTask?.st||'pend';
  
  const delBtn = $('btnDeleteTask');
  if (delBtn) delBtn.style.display = editTask ? 'inline-flex' : 'none';
  
  openM('mTask');
}

function deleteTask(){
  if (!editTask || !cur) return;
  if (!confirm(`¿Eliminar la tarea "${editTask.name}" de este expediente?`)) return;
  cur.tasks = cur.tasks.filter(t => t.id !== editTask.id);
  log(cur, `Tarea "${editTask.name}" eliminada.`);
  save();
  closeM('mTask');
  renderExp();
  toast('Tarea eliminada');
}

function saveTask(){
  const n=$('tName').value.trim();
  if(!n){toast('El nombre es obligatorio');return;}
  const d={name:n,desc:$('tDesc').value,who:$('tWho').value,phase:+$('tPhase').value,pri:$('tPri').value,due:$('tDue').value,st:$('tSt').value};
  if(editTask){
    Object.assign(editTask,d);
    log(cur,`Tarea "${n}" editada.`);
  } else {
    cur.tasks.push({id:Math.max(0,...cur.tasks.map(t=>t.id))+1,...d});
    log(cur,`Tarea "${n}" creada y asignada a ${d.who}.`);
  }
  save();
  closeM('mTask');
  renderExp();
  toast('Tarea guardada');
}

