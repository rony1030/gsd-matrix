.btn-sidebar-toggle i, .btn-sidebar-toggle svg{width:20px;height:20px}
.side-close-btn{display:none;background:none;border:none;color:var(--gray);padding:6px;border-radius:6px;cursor:pointer;margin-left:auto;align-items:center;justify-content:center}
.side-close-btn:hover{color:var(--navy);background:var(--bg)}
.side-close-btn i, .side-close-btn svg{width:18px;height:18px}
.side-backdrop{display:none;position:fixed;inset:0;background:rgba(15,23,42,0.5);backdrop-filter:blur(4px);z-index:998;opacity:0;transition:opacity .25s ease;pointer-events:none}
