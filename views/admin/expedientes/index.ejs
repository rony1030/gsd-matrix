}
.stage-pct-mini {
  font-weight: 600;
  color: var(--navy);
}

.stepper-desktop-drawer {
  margin-top: 12px;
  padding: 14px 16px;
  background: #ffffff;
  border: 1px solid var(--line);
  border-radius: 10px;
  animation: pop 0.18s ease;
}

.stepper-mobile-view {
  display: none;
}

@media (max-width: 768px) {
