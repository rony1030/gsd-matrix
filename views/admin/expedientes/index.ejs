function proceso(e,T,b){
  const cp=currentPhase(e);
  b.innerHTML=`<div class="card">
    <h2>Línea de Tiempo del Proceso</h2>
    <div class="tl" style="margin-top:14px">${T.fases.map((f,i)=>{
      const s=phaseState(e,i);
      return `<div class="s ${s} ${openPhase===i?'open':''}" onclick="openPhase=${openPhase===i?'null':i};renderTab()"><div class="c">${s==='done'?'✓':i+1}</div><b>${f[0]}</b><small>${s==='done'?'Completado':s==='cur'?'En proceso':'Pendiente'}</small></div>`;
    }).join('')}</div>
    ${openPhase!==null?(()=>{
      const fi=openPhase,ts=e.tasks.filter(t=>t.phase===fi),d=ts.filter(t=>t.st==='done').length,pct=ts.length?Math.round(d/ts.length*100):0,who=[...new Set(ts.map(t=>t.who))].join(', '),dues=ts.filter(t=>t.due).map(t=>t.due).sort();
      return `<div style="border-top:1px solid var(--line);padding-top:14px"><div class="ch"><h2>Etapa ${fi+1} — ${T.fases[fi][0]}</h2><span style="color:var(--gray);font-size:12px">${pct}% · ${d}/${ts.length} tareas</span></div><div class="kv" style="margin-bottom:12px"><span class="k">Responsables</span><span class="v">${who||'—'}</span><span class="k">Fechas</span><span class="v">${dues.length?fd(dues[0])+' → '+fd(dues[dues.length-1]):'sin fechas asignadas'}</span><span class="k">Documentos</span><span class="v">${e.docs.filter(x=>x.st!=='ok').length} pendientes en el expediente</span></div>${ts.map(t=>taskRow(t)).join('')}</div>`;
    })():'<p class="sub">Haga clic en una etapa para ver sus tareas, responsables y fechas.</p>'}
  </div>`;
}

// ===== TAREAS GENERALES =====
let tkF='all';
function tareas(e,T,b){
  let ts=e.tasks.map(t=>t);
  if(tkF==='mine')ts=ts.filter(t=>t.who==='Esteban Mejía');
  if(tkF==='late')ts=ts.filter(t=>t.due&&t.st!=='done'&&days(t.due)<0);
  if(tkF==='today')ts=ts.filter(t=>t.due===TODAY);
  if(tkF==='week')ts=ts.filter(t=>t.due&&days(t.due)>=0&&days(t.due)<=7);
  if(tkF==='done')ts=ts.filter(t=>t.st==='done');
  if(tkF==='all')ts=ts.filter(t=>t.st!=='done');
  b.innerHTML=`<div class="card">
    <div class="ch">
      <h2>Control de Tareas</h2>
      <button class="btn p" onclick="taskModal()"><i data-lucide="plus"></i>Nueva tarea</button>
    </div>
    <div class="filters">${[['all','Todas activas'],['mine','Mis tareas'],['late','Vencidas'],['today','Hoy'],['week','Esta semana'],['done','Completadas']].map(x=>`<button class="${tkF===x[0]?'on':''}" onclick="tkF='${x[0]}';renderTab()">${x[1]}</button>`).join('')}</div>
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Tarea</th>
            <th>Etapa</th>
            <th>Responsable</th>
            <th>Fecha límite</th>
            <th>Prioridad</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          ${ts.map(t=>`<tr class="row" onclick="taskModal(${t.id})">
            <td><b>${t.name}</b>${t.desc?`<small style="display:block;color:var(--gray)">${t.desc}</small>`:''}</td>
            <td>${T.fases[t.phase]?T.fases[t.phase][0]:'General'}</td>
            <td>${t.who}</td>
            <td class="${t.due&&t.st!=='done'&&days(t.due)<0?'st-block':''}">${fd(t.due)}</td>
            <td><span class="tag ${t.pri==='Alta'?'hi':t.pri==='Media'?'med':'lo'}">${t.pri}</span></td>
            <td><span class="tag ${ST[t.st]?ST[t.st][1].replace('st-',''):'lo'}">${ST[t.st]?ST[t.st][0]:t.st}</span></td>
          </tr>`).join('')||'<tr><td colspan="6" class="empty">Sin tareas en este filtro.</td></tr>'}
        </tbody>
      </table>
    </div>
  </div>`;
}

