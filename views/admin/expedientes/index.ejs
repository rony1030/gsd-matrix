function saveNewClientDirect() {
  const nombre = $('cliFormNombre')?.value.trim();
  if (!nombre) {
    toast('El nombre es obligatorio');
    return;
  }
  const key = nombre.toLowerCase();
  const tipo = $('cliFormTipo')?.value || 'Persona Física';
  const cedula = $('cliFormCedula')?.value.trim() || '';
  const tel = $('cliFormTel')?.value.trim() || '';
  const email = $('cliFormEmail')?.value.trim() || '';
  const dir = $('cliFormDir')?.value.trim() || '';
  const proyectosStr = $('cliFormProyectos')?.value.trim() || '';
  const proyectos = proyectosStr ? proyectosStr.split(',').map(p => p.trim()).filter(Boolean) : [];
  const notasStr = $('cliFormNotas')?.value.trim() || '';

  const tags = new Set();
  if ($('cliFormIntAgri')?.checked) tags.add('Agrimensura');
  if ($('cliFormIntLegal')?.checked) tags.add('Legal');
  if ($('cliFormIntRE')?.checked || proyectos.length > 0) tags.add('Bienes Raíces');

  const clientData = {
    key,
    id: 'cli-' + key.replace(/[^a-z0-9]/g, '-'),
    nombre,
    tipo,
    cedula,
    tel,
    email,
    dir,
    proyectos,
    propiedades: [],
    tags: Array.from(tags),
    notas: notasStr ? [{ date: TODAY, who: 'Esteban Mejía', txt: notasStr }] : [],
    totalHonorarios: 0,
    totalPagado: 0
  };

  // Guardar en localStorage
  try {
    const saved = JSON.parse(localStorage.getItem('gsd_custom_clients_v1') || '{}');
    saved[key] = clientData;
    localStorage.setItem('gsd_custom_clients_v1', JSON.stringify(saved));
  } catch(e) {}

  // Sincronizar con backend si está disponible
  fetch('/admin/clientes/api/guardar', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      nombre,
      email,
      telefono: tel,
      cedula,
      tipo_cliente: tipo,
      notas: notasStr,
      is_real_estate: tags.has('Bienes Raíces'),
      tags: Array.from(tags),
      proyectos_interes: proyectosStr
    })
  }).catch(e => console.log('Sync client notice:', e));

  closeM('mNewClientDirect');
  renderCli();
  toast(`Cliente "${nombre}" guardado con éxito`);
}
