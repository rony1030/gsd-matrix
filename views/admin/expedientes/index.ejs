function downloadCurPreviewDoc() {
  if (!_curPreviewDoc) return;
  
  if (_curPreviewDoc.dataUrl && !_curPreviewDoc.dataUrl.startsWith('data:image/svg')) {
    const a = document.createElement('a');
    a.href = _curPreviewDoc.dataUrl;
    a.download = _curPreviewDoc.file || `${(_curPreviewDoc.name || 'documento').replace(/[^a-z0-9]/gi, '_')}.pdf`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    toast('PDF descargado con éxito');
    return;
  }

  const sheet = document.getElementById('printDocSheet');
  if (!sheet) return;

  toast('Generando y descargando PDF...');

  const cleanFileName = `${(_curPreviewDoc.name || 'Documento_GSD').replace(/[^a-z0-9]/gi, '_')}_${_curPreviewDoc.expId || 'GSD'}.pdf`;

  if (window.html2pdf) {
    const opt = {
      margin: [10, 10, 10, 10],
      filename: cleanFileName,
      image: { type: 'jpeg', quality: 0.98 },
      html2canvas: { scale: 2, useCORS: true, logging: false },
      jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
    };
    html2pdf().set(opt).from(sheet).save().then(() => {
      toast('PDF descargado con éxito');
    }).catch(err => {
      console.log('PDF download error:', err);
      toast('PDF generado');
    });
  } else {
    const blob = new Blob([sheet.innerHTML], { type: 'text/html' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = cleanFileName;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    toast('Documento guardado');
  }
}

function downloadDocDirect(expId, encDocName) {
  const docName = decodeURIComponent(encDocName || '');
  const exp = DB.find(e => e.id === expId) || (cur && cur.id === expId ? cur : null);
  const doc = exp?.docs?.find(d => d.name === docName);
  
  if (doc?.dataUrl) {
    const a = document.createElement('a');
    a.href = doc.dataUrl;
    a.download = doc.file || `${docName.replace(/[^a-z0-9]/gi, '_')}.pdf`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    toast('PDF descargado con éxito');
  } else {
    previewDocModal(expId, encDocName, doc?.cat ? encodeURIComponent(doc.cat) : 'GENERAL');
    setTimeout(downloadCurPreviewDoc, 300);
  }
}

