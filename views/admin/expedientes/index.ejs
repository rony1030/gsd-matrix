function addEditTplDoc() {
  if (!_editTplData) return;
  if (!_editTplData.docs) _editTplData.docs = [];
  _editTplData.docs.push(['CLIENTE', 'Nuevo documento requerido', 'cliente']);
  renderEditTplDocs();
}

function deleteEditTplDoc(di) {
  if (!_editTplData || !_editTplData.docs) return;
  _editTplData.docs.splice(di, 1);
  renderEditTplDocs();
}

/* Guardar Cambios en Plantilla */
function saveTplModal() {
  const nombre = $('editTplNombre').value.trim();
  if (!nombre) {
    toast('El nombre del servicio es obligatorio');
    switchTplEditTab('general');
    $('editTplNombre').focus();
    return;
  }

  let key = $('editTplKey').value.trim();
  if (!key) {
    key = nombre.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  }

  _editTplData.nombre = nombre;
  _editTplData.div = $('editTplDiv').value;
  _editTplData.plazo = parseInt($('editTplPlazo').value, 10) || 30;
  _editTplData.honorario = parseFloat($('editTplHonorario').value) || 0;
  _editTplData.moneda = $('editTplMoneda').value;
  _editTplData.tec = $('editTplTec').checked;
  _editTplData.descripcion = $('editTplDesc').value.trim();
  _editTplData.condiciones = $('editTplCondiciones').value.trim();

  // Save to TPL object
  TPL[key] = JSON.parse(JSON.stringify(_editTplData));

  // Persist custom templates
  try {
    const savedCustom = JSON.parse(localStorage.getItem(TPL_STORAGE_KEY) || '{}');
    savedCustom[key] = TPL[key];
    localStorage.setItem(TPL_STORAGE_KEY, JSON.stringify(savedCustom));
  } catch(e) {}

  closeM('mTplEdit');
  renderTpl();
  toast(`Plantilla "${nombre}" guardada con éxito`);
}

function restoreTplDefault() {
  const key = $('editTplKey').value.trim();
  if (!key || !DEFAULT_TPL[key]) {
    toast('No hay versión predeterminada para esta plantilla personalizada.');
    return;
  }
  if (!confirm(`¿Restablecer la plantilla "${TPL[key].nombre}" a sus valores originales de fábrica?`)) return;

  TPL[key] = JSON.parse(JSON.stringify(DEFAULT_TPL[key]));
  try {
    const savedCustom = JSON.parse(localStorage.getItem(TPL_STORAGE_KEY) || '{}');
    delete savedCustom[key];
    localStorage.setItem(TPL_STORAGE_KEY, JSON.stringify(savedCustom));
  } catch(e) {}

  openTplEditModal(key);
  renderTpl();
  toast('Valores predeterminados restaurados');
}

