}
function closeMobileSidebar() {
  const side = document.querySelector('.side');
  const backdrop = document.getElementById('sideBackdrop');
  if (side) side.classList.remove('open');
  if (backdrop) backdrop.classList.remove('open');
}
</script>
</body>
</html>
