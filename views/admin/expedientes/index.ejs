            `;
          }).join('')}
        </div>
      `;
    }
  } else if (tabName === 'bienes_raices') {
    const isCorp = c.tipo === 'Empresa';
    body.innerHTML = `
      <div class="card" style="margin-bottom:16px;">
        <div class="ch" style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:8px;">
          <h3 style="margin:0;">Interés Inmobiliario & Proyectos</h3>
          <span class="tag ${c.tags.has('Bienes Raíces') ? 'proc' : 'wait'}">${c.tags.has('Bienes Raíces') ? 'CLIENTE ACTIVO BIENES RAÍCES' : 'PROSPECTO INMOBILIARIO'}</span>
        </div>
        <p class="sub" style="margin:8px 0 14px;line-height:1.4;">Gestiona los proyectos de interés o propiedades en cartera (Stellar, Cosmo, Galaxy, Canar Rock, Far View, etc.).</p>
        
        <div class="cli-re-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          <div style="background:#f8fafc;border:1px solid var(--line);border-radius:10px;padding:14px;box-sizing:border-box;">
            <b style="font-size:13px;color:var(--navy);display:block;margin-bottom:10px;"><i data-lucide="building-2" style="width:14px;height:14px;margin-right:5px;"></i>Proyectos de Interés / Asignados</b>
            ${c.proyectos.length ? `
