.btn-text-short{display:none}

@media (max-width:1400px){body{grid-template-columns:220px 1fr}.kpis{grid-template-columns:repeat(3,1fr)}.hdr-search{width:280px;max-width:calc(100% - 380px)}.prog{grid-template-columns:2fr 1fr 1fr 1fr}}
@media (max-width:1024px) and (min-width:769px){
  body{grid-template-columns:64px 1fr}
