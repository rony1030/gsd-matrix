      <div class="card">
        <h3 style="margin-bottom:14px;">Historial de Notas & Actividad</h3>
        ${(c.notas && c.notas.length) ? `
          <div style="display:grid;gap:10px;">
            ${c.notas.map(n => `
              <div style="padding:12px 14px;border:1px solid var(--line);border-radius:8px;background:#fff;">
                <div style="display:flex;justify-content:space-between;font-size:11.5px;color:var(--gray);margin-bottom:6px;">
                  <span><i data-lucide="user" style="width:12px;height:12px;margin-right:4px;"></i>${n.who || 'Esteban Mejía'}</span>
                  <span>${fd(n.date)}</span>
                </div>
                <p style="margin:0;font-size:13px;color:#334155;line-height:1.5;">${n.txt}</p>
              </div>
            `).join('')}
          </div>
        ` : `
          <p class="sub" style="text-align:center;padding:24px;">Sin notas registradas aún para este cliente.</p>
        `}
      </div>
    `;
  }

  icons();
}

/* ===== VISOR Y PREVIEW DE DOCUMENTOS PDF ===== */
let _curPreviewDoc = null;

function previewDocModal(expId, encDocName, encDocCat) {
  const docName = decodeURIComponent(encDocName || '');
  const docCat = decodeURIComponent(encDocCat || 'GENERAL');
  
  const exp = DB.find(e => e.id === expId) || (cur && cur.id === expId ? cur : null);
  const doc = exp?.docs?.find(d => d.name === docName) || { name: docName, cat: docCat, st: 'ok', file: docName + '.pdf', date: TODAY, expId };
  
  _curPreviewDoc = { ...doc, expId, exp };
  
  $('docPreviewTitle').textContent = doc.name;
  $('docPreviewSub').innerHTML = `Expediente: <b>${expId}</b> · ${(TPL[exp?.svc]?.nombre || exp?.svc || 'Servicio Técnico')} · Categoría: ${doc.cat || docCat}`;

  const container = $('docPreviewContainer');
  if (!container) return;

  if (doc.dataUrl && (doc.dataUrl.startsWith('data:application/pdf') || doc.dataUrl.startsWith('blob:') || doc.dataUrl.endsWith('.pdf'))) {
    container.innerHTML = `
      <iframe src="${doc.dataUrl}" style="width:100%;height:680px;border:none;border-radius:8px;background:#fff;box-shadow:0 4px 14px rgba(0,0,0,0.1);"></iframe>
    `;
  } else if (doc.dataUrl && doc.dataUrl.startsWith('data:image/')) {
    container.innerHTML = `
      <div style="background:#fff;border-radius:8px;padding:16px;box-shadow:0 4px 14px rgba(0,0,0,0.1);max-width:100%;text-align:center;">
        <img src="${doc.dataUrl}" style="max-width:100%;max-height:650px;object-fit:contain;border-radius:4px;">
      </div>
    `;
  } else {
    // Render High-Fidelity Official GSD Technical Document Sheet / Certificate
    const sideLogo = document.querySelector('.side .logo img');
    const logoSrc = sideLogo ? sideLogo.src : '/img/logo-gsd.png';
    const cliName = exp?.cliente?.nombre || (_cur360Client ? _cur360Client.nombre : 'Cliente');
    const cliCed = exp?.cliente?.cedula || (_cur360Client ? _cur360Client.cedula : '—');
    const objStr = exp?.svc === 'deslinde' 
      ? `Parcela ${exp.objeto?.parcela || '—'} · ${exp.objeto?.sector || 'Punta Cana'}, ${exp.objeto?.provincia || 'La Altagracia'}` 
      : (exp?.objeto?.matricula ? `Matrícula ${exp.objeto.matricula} · Punta Cana` : 'Inmueble / Asunto en trámite');
    const svcName = TPL[exp?.svc]?.nombre || 'Servicio Profesional Inmobiliario y Catastral';
    const numDoc = `DOC-${expId.replace('EXP-','')}-${Math.abs(docName.split('').reduce((a,b)=>{a=((a<<5)-a)+b.charCodeAt(0);return a&a},0)%10000)}`;

    container.innerHTML = `
      <div id="printDocSheet" style="background:#ffffff;border:1px solid #e2e8f0;border-radius:8px;padding:36px 40px;width:100%;max-width:720px;box-shadow:0 6px 20px rgba(0,0,0,0.07);color:var(--ink);font-family:'Poppins',sans-serif;line-height:1.5;">
        <!-- Header -->
        <div style="display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid var(--navy);padding-bottom:16px;margin-bottom:20px;">
          <div>
            <img src="${logoSrc}" style="height:38px;object-fit:contain;margin-bottom:6px;display:block;">
            <b style="font-size:14px;color:var(--navy);display:block;">GEOSOLUTIONS SOURCE DOMINICANA, S.R.L.</b>
            <small style="color:var(--gray);font-size:11px;display:block;">RNC: 1-33-79694-5 · Agrimensura, Notaría & Asesoría Inmobiliaria</small>
            <small style="color:var(--gray);font-size:11px;display:block;">Av. Barceló, Plaza Roque III, Punta Cana, R.D. · Tel: (829) 493-7254</small>
          </div>
          <div style="text-align:right;">
            <span class="tag proc" style="font-size:11px;font-weight:700;padding:4px 10px;">EXPEDIENTE DIGITAL</span>
            <div style="font-weight:700;color:var(--navy);font-size:13px;margin-top:6px;font-family:monospace;">${numDoc}</div>
            <small style="color:var(--gray);display:block;margin-top:2px;">Fecha de Registro: ${fd(doc.date || TODAY)}</small>
          </div>
        </div>

        <!-- Document Title Banner -->
        <div style="background:var(--green-l);border-left:4px solid var(--green);padding:12px 16px;border-radius:0 8px 8px 0;margin-bottom:22px;">
          <small style="color:var(--green);font-weight:700;text-transform:uppercase;font-size:10px;letter-spacing:0.5px;">Documento Oficial Protocolizado</small>
          <h2 style="margin:2px 0 0 0;font-size:17px;color:var(--navy);font-weight:700;">${doc.name}</h2>
        </div>

        <!-- Metadata Grid -->
        <div class="kv" style="grid-template-columns:140px 1fr;gap:10px 14px;margin-bottom:24px;font-size:12.5px;">
          <span class="k" style="color:var(--gray);font-weight:600;">Expediente:</span>
          <span class="v" style="color:var(--navy);font-weight:700;">${expId} — ${svcName}</span>

          <span class="k" style="color:var(--gray);font-weight:600;">Titular / Cliente:</span>
          <span class="v" style="color:var(--navy);font-weight:600;">${cliName}</span>

          <span class="k" style="color:var(--gray);font-weight:600;">Identificación:</span>
          <span class="v" style="font-family:monospace;">${cliCed || '—'}</span>

          <span class="k" style="color:var(--gray);font-weight:600;">Objeto / Inmueble:</span>
          <span class="v">${objStr}</span>

          <span class="k" style="color:var(--gray);font-weight:600;">Categoría:</span>
          <span class="v"><span class="tag ${doc.cat==='CLIENTE'?'wait':doc.cat==='INMUEBLE'?'proc':doc.cat==='TÉCNICO'?'rev':'lo'}">${doc.cat || docCat}</span></span>

          <span class="k" style="color:var(--gray);font-weight:600;">Aportado por:</span>
          <span class="v">${doc.by === 'cliente' ? 'Cliente Propietario / Representante' : 'Geosolutions Source Dominicana (GSD)'}</span>

          <span class="k" style="color:var(--gray);font-weight:600;">Estado Documental:</span>
          <span class="v" style="color:var(--green);font-weight:600;">✓ Verificado y anexado formalmente a la carpeta técnica</span>
        </div>

        <!-- Verification Seal Box -->
        <div style="background:#f8fafc;border:1px dashed #cbd5e1;border-radius:8px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;margin-bottom:28px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <i data-lucide="shield-check" style="width:28px;height:28px;color:var(--green);"></i>
            <div>
              <b style="font-size:12px;color:var(--navy);display:block;">Validación de Integridad y Custodia Digital</b>
              <small style="color:var(--gray);font-size:11px;">Este registro confirma la existencia y resguardo del documento en los archivos jurídicos de GSD.</small>
