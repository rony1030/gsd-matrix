function renderList(){const q=$('search').value.toLowerCase();const rows=DB.filter(e=>(listF==='all'||e.estado===listF)&&(divF==='all'||(TPL[e.svc]||TPL.deslinde).div===divF)&&(!q||JSON.stringify(e).toLowerCase().includes(q)));$('listCount').textContent=`${rows.length}`;$('listRows').innerHTML=rows.map(e=>rowHTML(e,true)).join('')||'<tr><td colspan="8" class="empty" style="text-align:center;padding:28px;color:var(--gray);">No hay expedientes registrados en esta vista.</td></tr>';}
