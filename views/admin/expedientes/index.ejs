let calDate = new Date();

function changeCalMonth(delta) {
  calDate.setMonth(calDate.getMonth() + delta);
  renderCal();
}

function setCalToday() {
  calDate = new Date();
  renderCal();
}

const MONTH_NAMES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
const DAY_HEADERS = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];

function renderCal() {
  const year = calDate.getFullYear();
  const month = calDate.getMonth();
  
  // All active tasks with due dates
  const allT = allTasks().filter(t => t.due && t.st !== 'done' && t.st !== 'na');
  const tasksSorted = [...allT].sort((a, b) => a.due > b.due ? 1 : -1);
  
  // Group tasks by date YYYY-MM-DD
  const tasksByDate = {};
  allT.forEach(t => {
    (tasksByDate[t.due] = tasksByDate[t.due] || []).push(t);
  });

  // Month calculations (Monday = 0, Sunday = 6)
  const firstDay = new Date(year, month, 1).getDay();
  const offset = (firstDay + 6) % 7;
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const daysInPrevMonth = new Date(year, month, 0).getDate();
  const totalCells = Math.ceil((offset + daysInMonth) / 7) * 7;

  // Month tasks count
  const monthPrefix = `${year}-${String(month + 1).padStart(2, '0')}`;
  const monthTasksCount = allT.filter(t => t.due.startsWith(monthPrefix)).length;

  let gridHTML = '';
  // Day headers
  gridHTML += DAY_HEADERS.map(d => `<div class="cal-day-head">${d}</div>`).join('');

  // Calendar cells
  for (let i = 0; i < totalCells; i++) {
    if (i < offset) {
      // Prev month trailing
      const dNum = daysInPrevMonth - offset + i + 1;
      gridHTML += `<div class="cal-cell other-month"><div class="cal-num">${dNum}</div></div>`;
    } else if (i < offset + daysInMonth) {
      // Current month day
      const dNum = i - offset + 1;
      const dStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(dNum).padStart(2, '0')}`;
      const isToday = (dStr === TODAY);
      const dayTasks = tasksByDate[dStr] || [];

      gridHTML += `
        <div class="cal-cell ${isToday ? 'today' : ''}">
          <div class="cal-num">${dNum}</div>
          <div class="cal-events">
            ${dayTasks.map(t => {
              const diff = days(t.due);
              let pillCls = 'normal';
              if (diff < 0) pillCls = 'late';
              else if (diff === 0) pillCls = 'today';
              else if (diff <= 3) pillCls = 'soon';
              const divName = (TPL[t.e.svc] || TPL.deslinde).div || 'Legal';
              return `
                <div class="cal-pill ${pillCls}" onclick="openExp('${t.e.id}','tareas')" title="${t.name} (${t.e.id} - ${t.e.cliente?.nombre || 'Cliente'}) · Resp: ${t.who}">
                  ${t.name}
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    } else {
      // Next month leading
      const dNum = i - (offset + daysInMonth) + 1;
      gridHTML += `<div class="cal-cell other-month"><div class="cal-num">${dNum}</div></div>`;
    }
  }

  // Right side agenda
  const agendaHTML = tasksSorted.length ? tasksSorted.slice(0, 10).map(t => {
    const diff = days(t.due);
    const [y, m, d] = t.due.split('-');
    const mShort = M[parseInt(m) - 1]?.toUpperCase() || 'MES';
    const isLate = diff < 0;
    const isToday = diff === 0;
    const divName = (TPL[t.e.svc] || TPL.deslinde).div || 'Legal';

    return `
      <div class="cal-agenda-item" onclick="openExp('${t.e.id}','tareas')" style="cursor:pointer">
        <div class="cal-agenda-date" style="border-color:${isLate ? 'var(--red)' : isToday ? 'var(--green)' : 'var(--line)'};background:${isLate ? 'var(--red-l)' : isToday ? 'var(--green-l)' : 'var(--bg)'}">
          <b style="color:${isLate ? 'var(--red)' : isToday ? '#2F6B4A' : 'var(--navy)'}">${parseInt(d)}</b>
          <small style="color:${isLate ? 'var(--red)' : isToday ? '#2F6B4A' : 'var(--gray)'}">${mShort}</small>
        </div>
        <div style="flex:1;min-width:0">
          <div style="display:flex;align-items:center;gap:6px;margin-bottom:2px">
            <span style="font-size:10px;padding:1px 6px;border-radius:6px;font-weight:600;background:${DIV_BG[divName] || '#eee'};color:${DIV_COLOR[divName] || '#666'}">${divName}</span>
            <span style="font-size:11px;color:var(--gray)">${t.e.id}</span>
          </div>
          <b style="font-size:12.5px;color:var(--navy);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${t.name}">${t.name}</b>
          <div style="font-size:11px;color:var(--gray);margin-top:2px;display:flex;justify-content:space-between">
            <span>${t.e.cliente?.nombre || 'Cliente'}</span>
            <span style="font-weight:500;color:${isLate ? 'var(--red)' : isToday ? 'var(--green)' : 'var(--gray)'}">
              ${isLate ? `Vencida (${-diff}d)` : isToday ? 'Vence hoy' : `En ${diff}d`}
            </span>
          </div>
        </div>
      </div>
    `;
  }).join('') : '<div class="empty" style="text-align:center;padding:24px;color:var(--gray)">Sin vencimientos programados. Todo al día.</div>';

  $('calBox').innerHTML = `
    <div class="cal-container">
      <!-- CALENDARIO MENSUAL -->
      <div class="cal-card">
        <div class="cal-header">
          <h2>
            <i data-lucide="calendar" style="color:var(--green)"></i>
            <span>${MONTH_NAMES[month]} ${year}</span>
            ${monthTasksCount > 0 ? `<span class="tag proc" style="font-size:11px">${monthTasksCount} compromiso${monthTasksCount !== 1 ? 's' : ''}</span>` : ''}
          </h2>
          <div class="cal-nav">
            <button class="btn sm" onclick="setCalToday()" style="font-weight:600;height:32px;padding:0 10px">Hoy</button>
            <button class="cal-nav-btn" onclick="changeCalMonth(-1)" title="Mes anterior"><i data-lucide="chevron-left"></i></button>
            <button class="cal-nav-btn" onclick="changeCalMonth(1)" title="Mes siguiente"><i data-lucide="chevron-right"></i></button>
          </div>
        </div>
        <div class="cal-grid">
          ${gridHTML}
        </div>
        <div style="display:flex;gap:14px;margin-top:14px;padding-top:12px;border-top:1px solid var(--line);font-size:11px;color:var(--gray);flex-wrap:wrap">
          <span style="display:inline-flex;align-items:center;gap:5px"><span style="width:8px;height:8px;border-radius:2px;background:var(--red)"></span> Vencido</span>
          <span style="display:inline-flex;align-items:center;gap:5px"><span style="width:8px;height:8px;border-radius:2px;background:var(--green)"></span> Vence hoy</span>
          <span style="display:inline-flex;align-items:center;gap:5px"><span style="width:8px;height:8px;border-radius:2px;background:var(--blue)"></span> Próximo (≤3 días)</span>
          <span style="display:inline-flex;align-items:center;gap:5px"><span style="width:8px;height:8px;border-radius:2px;background:var(--navy)"></span> Programado</span>
        </div>
      </div>

      <!-- AGENDA DE PRÓXIMOS VENCIMIENTOS -->
      <div class="cal-card">
        <div class="cal-header">
          <h2 style="font-size:15px">
            <i data-lucide="clock" style="color:var(--navy)"></i>
            <span>Próximos Vencimientos</span>
          </h2>
          <span class="tag ${allT.some(t => days(t.due) < 0) ? 'late' : 'proc'}">${allT.length} pendientes</span>
        </div>
        <div class="cal-side-list">
          ${agendaHTML}
        </div>
      </div>
    </div>
  `;
  icons();
}
let _cliFilter = 'all';
let _cur360Client = null;
let _cur360Tab = 'expedientes';
let CLIENTS_MAP = {};

function buildClientsDatabase() {
  const map = {};

  // 1. Clientes desde Expedientes
  DB.forEach(e => {
    const name = e.cliente?.nombre?.trim();
    if (!name) return;
    const key = name.toLowerCase();
    if (!map[key]) {
      const isCorp = name.toLowerCase().includes('srl') || name.toLowerCase().includes('s.a.') || name.toLowerCase().includes('corp') || name.toLowerCase().includes('grupo') || name.toLowerCase().includes('desarrollos') || name.toLowerCase().includes('constructora');
      map[key] = {
        key: key,
        id: 'cli-' + key.replace(/[^a-z0-9]/g, '-'),
        nombre: name,
        cedula: e.cliente.cedula || '',
        tel: e.cliente.tel || '',
        email: e.cliente.email || '',
        dir: e.cliente.dir || '',
        tipo: isCorp ? 'Empresa' : 'Persona Física',
        expedientes: [],
        cotizaciones: [],
        proyectos: [],
        propiedades: [],
        leads: [],
        notas: (e.notas || []).map(n => ({ date: n.date, who: n.who, txt: n.txt })),
        totalHonorarios: 0,
        totalPagado: 0,
        tags: new Set()
      };
    }

    if (!map[key].cedula && e.cliente.cedula) map[key].cedula = e.cliente.cedula;
    if (!map[key].tel && e.cliente.tel) map[key].tel = e.cliente.tel;
    if (!map[key].email && e.cliente.email) map[key].email = e.cliente.email;
    if (!map[key].dir && e.cliente.dir) map[key].dir = e.cliente.dir;

    map[key].expedientes.push(e);
    const divName = TPL[e.svc]?.div || 'Agrimensura';
    map[key].tags.add(divName);
    map[key].totalHonorarios += (parseFloat(e.honorario) || 0);
    const pag = (e.pagos || []).filter(p => p.st === 'Pagado').reduce((a, b) => a + (parseFloat(b.m) || 0), 0);
    map[key].totalPagado += pag;
  });

  // 2. Clientes desde Cotizaciones
  quotes.forEach(q => {
    const name = q.cli?.trim();
    if (!name) return;
    const key = name.toLowerCase();
    if (!map[key]) {
      const isCorp = name.toLowerCase().includes('srl') || name.toLowerCase().includes('s.a.') || name.toLowerCase().includes('corp');
      map[key] = {
        key: key,
        id: 'cli-' + key.replace(/[^a-z0-9]/g, '-'),
        nombre: name,
        cedula: '',
        tel: '',
        email: '',
        dir: '',
        tipo: isCorp ? 'Empresa' : 'Persona Física',
        expedientes: [],
        cotizaciones: [],
        proyectos: [],
        propiedades: [],
        leads: [],
        notas: [],
        totalHonorarios: 0,
        totalPagado: 0,
        tags: new Set(['Cotizaciones'])
      };
    }
    map[key].cotizaciones.push(q);
    map[key].tags.add('Cotizaciones');
    if (!map[key].expedientes.length) {
      map[key].totalHonorarios += (parseFloat(q.hon) || 0);
    }
  });

  // 3. Clientes desde Leads / Bienes Raíces
  if (Array.isArray(SERVER_LEADS)) {
    SERVER_LEADS.forEach(l => {
      const name = l.nombre?.trim();
      if (!name) return;
      const key = name.toLowerCase();
      if (!map[key]) {
        map[key] = {
          key: key,
          id: 'cli-' + key.replace(/[^a-z0-9]/g, '-'),
          nombre: name,
          cedula: '',
          tel: l.telefono || '',
          email: l.email || '',
          dir: '',
          tipo: l.tipo_cliente || (l.is_real_estate ? 'Inversionista' : 'Persona Física'),
          expedientes: [],
          cotizaciones: [],
          proyectos: [],
          propiedades: [],
          leads: [],
          notas: l.mensaje ? [{ date: (l.created_at || TODAY).slice(0, 10), who: 'Lead CRM', txt: l.mensaje }] : [],
          totalHonorarios: 0,
          totalPagado: 0,
          tags: new Set()
        };
      }
      if (!map[key].tel && l.telefono) map[key].tel = l.telefono;
      if (!map[key].email && l.email) map[key].email = l.email;
      if (l.is_real_estate) map[key].tags.add('Bienes Raíces');
      if (l.tags) {
        l.tags.split(',').forEach(tg => {
          const tTrim = tg.trim();
          if (tTrim) {
            map[key].tags.add(tTrim);
            if (tTrim.toLowerCase().includes('stellar') || tTrim.toLowerCase().includes('cosmo') || tTrim.toLowerCase().includes('galaxy') || tTrim.toLowerCase().includes('canar') || tTrim.toLowerCase().includes('proyecto')) {
              map[key].proyectos.push(tTrim);
            }
          }
        });
      }
      map[key].leads.push(l);
    });
  }

  // 4. Clientes guardados personalizados en localStorage
  try {
    const savedCustomCli = JSON.parse(localStorage.getItem('gsd_custom_clients_v1') || '{}');
    Object.values(savedCustomCli).forEach(c => {
      const key = c.nombre?.toLowerCase().trim();
      if (!key) return;
      if (!map[key]) {
        map[key] = {
          key: key,
          id: c.id || ('cli-' + key.replace(/[^a-z0-9]/g, '-')),
          nombre: c.nombre,
          cedula: c.cedula || '',
          tel: c.tel || '',
          email: c.email || '',
          dir: c.dir || '',
          tipo: c.tipo || 'Persona Física',
          expedientes: [],
          cotizaciones: [],
          proyectos: c.proyectos || [],
          propiedades: c.propiedades || [],
          leads: [],
          notas: c.notas || [],
          totalHonorarios: c.totalHonorarios || 0,
          totalPagado: c.totalPagado || 0,
          tags: new Set(c.tags || ['Bienes Raíces'])
        };
      } else {
        if (c.cedula) map[key].cedula = c.cedula;
        if (c.tel) map[key].tel = c.tel;
        if (c.email) map[key].email = c.email;
        if (c.dir) map[key].dir = c.dir;
        if (c.tipo) map[key].tipo = c.tipo;
        if (c.proyectos && c.proyectos.length) map[key].proyectos = [...new Set([...map[key].proyectos, ...c.proyectos])];
        if (c.tags) c.tags.forEach(t => map[key].tags.add(t));
        if (c.notas && c.notas.length) {
          map[key].notas = [...map[key].notas, ...c.notas];
        }
      }
    });
  } catch(e) {}

  CLIENTS_MAP = map;
  return Object.values(map);
}

function renderCli() {
  const clients = buildClientsDatabase();
  const searchQ = ($('cliSearchInput')?.value || '').toLowerCase().trim();

  // Actualizar KPIs de Clientes
  const totalCli = clients.length;
  const activosCli = clients.filter(c => c.expedientes.some(e => e.estado !== 'done')).length;
  const reCli = clients.filter(c => c.tags.has('Bienes Raíces') || c.proyectos.length > 0 || c.tipo === 'Inversionista').length;
  const totalFac = clients.reduce((acc, c) => acc + (c.totalHonorarios || 0), 0);

  if ($('kpiCliTotal')) $('kpiCliTotal').textContent = totalCli;
  if ($('kpiCliActivos')) $('kpiCliActivos').textContent = activosCli;
  if ($('kpiCliRealEstate')) $('kpiCliRealEstate').textContent = reCli;
  if ($('kpiCliFacturado')) $('kpiCliFacturado').textContent = `US$${fmt(totalFac)}`;

  // Filtrado
  const filtered = clients.filter(c => {
    // Filtro de segmento
    if (_cliFilter === 'active' && !c.expedientes.some(e => e.estado !== 'done')) return false;
    if (_cliFilter === 're' && !(c.tags.has('Bienes Raíces') || c.proyectos.length > 0 || c.tipo === 'Inversionista')) return false;
    if (_cliFilter === 'legal_tech' && !c.expedientes.length) return false;
    if (_cliFilter === 'corp' && c.tipo !== 'Empresa') return false;

    // Filtro de búsqueda
    if (searchQ) {
      const matchName = (c.nombre || '').toLowerCase().includes(searchQ);
      const matchCed = (c.cedula || '').toLowerCase().includes(searchQ);
      const matchTel = (c.tel || '').toLowerCase().includes(searchQ);
      const matchEmail = (c.email || '').toLowerCase().includes(searchQ);
      const matchExp = c.expedientes.some(e => (e.id || '').toLowerCase().includes(searchQ) || (e.svc || '').toLowerCase().includes(searchQ));
      const matchProj = c.proyectos.some(p => p.toLowerCase().includes(searchQ));
      if (!matchName && !matchCed && !matchTel && !matchEmail && !matchExp && !matchProj) return false;
    }
    return true;
  });

  const tbody = $('cliRows');
  if (!tbody) return;

  if (filtered.length === 0) {
    tbody.innerHTML = `
      <tr>
        <td colspan="7" style="text-align:center;padding:36px;color:var(--gray);">
          <i data-lucide="users" style="width:32px;height:32px;margin:0 auto 8px;display:block;opacity:0.4;"></i>
          No se encontraron clientes que coincidan con la búsqueda.
        </td>
      </tr>
    `;
    icons();
    return;
  }

  tbody.innerHTML = filtered.map(c => {
    const isCorp = c.tipo === 'Empresa';
    const isVip = c.tipo === 'Inversionista';
    const hasRE = c.tags.has('Bienes Raíces') || c.proyectos.length > 0;
    const avatarClass = isVip ? 'vip' : isCorp ? 'corp' : hasRE ? 're' : '';
    const initialText = ini(c.nombre);

    // Badges
    const badgeTags = [];
    if (isCorp) badgeTags.push('<span class="cli-badge corp">Empresa</span>');
    if (isVip) badgeTags.push('<span class="cli-badge vip">Inversionista</span>');
    if (c.expedientes.some(e => e.svc === 'deslinde' || e.svc === 'subdivision' || e.svc === 'condominio')) badgeTags.push('<span class="cli-badge agri">Agrimensura</span>');
    if (c.expedientes.some(e => e.svc === 'transferencia' || e.svc === 'iguala' || e.svc === 'sucesiones')) badgeTags.push('<span class="cli-badge legal">Legal</span>');
    if (hasRE) badgeTags.push('<span class="cli-badge re">Bienes Raíces</span>');

    // Expedientes chips
    const expChips = c.expedientes.length > 0 ? c.expedientes.map(e => `
      <span class="cli-row-exp-tag" onclick="event.stopPropagation();openExp('${e.id}')" title="${(TPL[e.svc]||{}).nombre||e.svc}">
        <i data-lucide="folder" style="width:11px;height:11px;"></i>${e.id}
      </span>
    `).join(' ') : '<span style="color:#94a3b8;font-size:11.5px;">Sin expedientes</span>';

    // Proyectos chips
    const projChips = c.proyectos.length > 0 ? c.proyectos.map(p => `
      <span class="cli-project-chip">
        <i data-lucide="building-2" style="width:11px;height:11px;"></i>${p}
      </span>
    `).join(' ') : (hasRE ? '<span class="cli-badge re">Interés Inmobiliario</span>' : '<span style="color:#94a3b8;font-size:11.5px;">—</span>');

    // Tel & WhatsApp link
    const cleanPhone = (c.tel || '').replace(/[^\d+]/g, '');
    const waLink = cleanPhone ? `https://wa.me/${cleanPhone.startsWith('1')||cleanPhone.startsWith('+')?cleanPhone.replace('+',''):'1'+cleanPhone}` : '';

    return `
      <tr class="row cli-table-row" onclick="openClient360('${c.key}')" style="cursor:pointer;">
        <td class="cli-col-main" style="padding-left:16px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div class="cli-avatar ${avatarClass}">${initialText}</div>
            <div style="flex:1;min-width:0;">
              <div style="display:flex;justify-content:space-between;align-items:center;gap:6px;">
                <b style="font-size:13.5px;color:var(--navy);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${c.nombre}</b>
                <div class="cli-mobile-actions-top" style="display:none;">
                  <button type="button" class="btn sm" onclick="event.stopPropagation();openClient360('${c.key}')" style="padding:4px 8px;font-size:11px;" title="Ver Perfil 360°">
                    <i data-lucide="eye"></i>
                  </button>
                  <button type="button" class="btn sm p" onclick="event.stopPropagation();startExpForClient('${c.nombre}')" style="padding:4px 8px;font-size:11px;" title="Crear expediente">
                    <i data-lucide="plus"></i>
                  </button>
                </div>
              </div>
              <div style="display:flex;gap:4px;flex-wrap:wrap;margin-top:3px;">
                ${badgeTags.join('')}
              </div>
            </div>
          </div>
        </td>
        <td class="cli-col-id">
          <span style="font-family:monospace;font-size:12px;color:#334155;font-weight:600;">${c.cedula || '—'}</span>
        </td>
        <td class="cli-col-contact">
          <div>
            ${c.email ? `<a href="mailto:${c.email}" onclick="event.stopPropagation()" style="color:var(--blue);text-decoration:none;font-size:12px;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="mail" style="width:11px;height:11px;"></i><span>${c.email}</span></a>` : ''}
            ${c.tel ? `
              <div style="display:flex;align-items:center;gap:6px;margin-top:2px;">
                <span style="font-size:11.5px;color:var(--gray);">${c.tel}</span>
                ${waLink ? `<a href="${waLink}" target="_blank" onclick="event.stopPropagation()" title="Contactar por WhatsApp" style="color:#16A34A;display:inline-flex;align-items:center;"><i data-lucide="message-circle" style="width:13px;height:13px;"></i></a>` : ''}
              </div>
            ` : (!c.email ? '<span style="color:#94a3b8;font-size:11.5px;">—</span>' : '')}
          </div>
        </td>
        <td class="cli-col-exp">
          <div style="display:flex;gap:4px;flex-wrap:wrap;align-items:center;">
            ${expChips}
          </div>
        </td>
        <td class="cli-col-proj">
          <div style="display:flex;gap:4px;flex-wrap:wrap;align-items:center;">
            ${projChips}
          </div>
        </td>
        <td class="cli-col-money">
          <div>
            <b style="font-size:12.5px;color:var(--navy);">${c.totalHonorarios ? `US$${fmt(c.totalHonorarios)}` : '—'}</b>
            ${c.totalPagado ? `<small style="color:var(--green);display:block;font-size:10.5px;">Cobrado: US$${fmt(c.totalPagado)}</small>` : ''}
          </div>
        </td>
        <td class="cli-col-actions" style="text-align:right;padding-right:16px;">
          <div style="display:flex;gap:6px;justify-content:flex-end;align-items:center;">
            <button type="button" class="btn sm" onclick="event.stopPropagation();openClient360('${c.key}')" title="Ver Perfil 360°">
              <i data-lucide="eye"></i><span>Perfil 360°</span>
            </button>
            <button type="button" class="btn sm p" onclick="event.stopPropagation();startExpForClient('${c.nombre}')" title="Crear expediente para este cliente">
              <i data-lucide="plus"></i>
            </button>
          </div>
        </td>
      </tr>
    `;
  }).join('');

  icons();
}

function setCliFilter(filt) {
  _cliFilter = filt;
  const wrap = $('cliTypeFilters');
  if (wrap) {
    [...wrap.children].forEach(b => b.classList.toggle('on', b.dataset.filt === filt));
  }
  renderCli();
}

function filterClientsTable() {
  renderCli();
}

/* ===== VISTA 360° INTEGRADA DEL CLIENTE (FULL-PAGE CRM) ===== */
function openClient360(clientKey) {
  buildClientsDatabase();
  const c = CLIENTS_MAP[clientKey.toLowerCase()];
  if (!c) {
    toast('Cliente no encontrado');
    return;
  }
  _cur360Client = c;
  _cur360Tab = 'expedientes';

  document.querySelectorAll('.view').forEach(x => x.classList.remove('on'));
  const detailView = $('v-client-detail');
  if (detailView) detailView.classList.add('on');
  
  document.querySelectorAll('.side a').forEach(a => a.classList.toggle('on', a.dataset.view === 'clients'));
  $('main').scrollTop = 0;

  renderClientDetail();
  icons();
}

