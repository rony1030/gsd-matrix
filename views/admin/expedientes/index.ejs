  $('reciboPaper').innerHTML=`
    <div style="display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid var(--navy);padding-bottom:14px;margin-bottom:16px">
      <div>
        <h2 style="color:var(--navy);font-size:18px;margin:0">GEOSOLUTIONS SOURCE DOMINICANA</h2>
        <small style="color:var(--gray)">RNC / Registro Mercantil · Asesoría Jurídica & Agrimensura</small>
        <div style="font-size:11.5px;color:var(--gray);margin-top:3px">Punta Cana, República Dominicana · +1 (829) 493-7254</div>
      </div>
      <div style="text-align:right">
        <span class="tag proc" style="font-size:12px;padding:4px 10px">RECIBO DE PAGO</span>
        <div style="font-weight:700;color:var(--navy);font-size:14px;margin-top:4px">${numRecibo}</div>
        <small style="color:var(--gray)">Fecha: ${fd(p.d||TODAY)}</small>
      </div>
    </div>

    <div class="kv" style="grid-template-columns:140px 1fr;margin-bottom:16px">
      <span class="k">Recibido de:</span><span class="v" style="font-size:14px;font-weight:600">${cur.cliente.nombre}</span>
      <span class="k">Cédula / RNC:</span><span class="v">${cur.cliente.cedula||'—'}</span>
      <span class="k">Expediente / Asunto:</span><span class="v">${cur.id} — ${T.nombre}</span>
      <span class="k">Por concepto de:</span><span class="v">${p.c}</span>
      <span class="k">Referencia de pago:</span><span class="v">${p.nota||'Pago recibido conforme'}</span>
    </div>

    <div style="background:var(--bg);padding:14px;border-radius:8px;border:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
      <span style="font-size:13px;font-weight:600;color:var(--navy)">MONTO RECIBIDO</span>
      <span style="font-size:22px;font-weight:700;color:var(--green)">${cur.mon}${fmt(p.m)}</span>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-top:30px;padding-top:14px;border-top:1px dashed var(--line)">
      <div>
        <small style="color:var(--gray);display:block">Atendido por:</small>
        <b style="color:var(--navy)">${cur.resp}</b>
      </div>
      <div style="text-align:center;width:200px;border-top:1px solid var(--ink);padding-top:4px">
        <small style="color:var(--gray);display:block">Firma y Sello Autorizado</small>
        <span style="font-size:11px;color:var(--navy);font-weight:600">GSD DOMINICANA</span>
      </div>
    </div>
  `;
  openM('mRecibo');
}

function copyRecibo(){
  navigator.clipboard?.writeText($('reciboPaper').innerText);
  toast('Texto del recibo copiado al portapapeles');
}

