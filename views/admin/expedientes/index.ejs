            ${d.st==='ok'?`
              <span class="tag proc">Listo</span>
              <button class="btn sm" onclick="previewDocModal('${e.id}', '${encodeURIComponent(d.name)}', '${encodeURIComponent(d.cat)}')"><i data-lucide="eye"></i>Ver PDF</button>
              <label style="font-size:11px;color:var(--gray);display:inline-flex;gap:4px;align-items:center;cursor:pointer" title="Visible para cliente">
                <input type="checkbox" style="width:auto" ${d.share?'checked':''} onchange="cur.docs[${d.i}].share=this.checked;save();toast(this.checked?'Compartido':'Ocultado')"> Compartir
              </label>
              ${d.dataUrl?`<a class="btn sm" href="${d.dataUrl}" download="${d.file||'documento'}" target="_blank"><i data-lucide="download"></i>Descargar</a>`:`<button class="btn sm ghost" onclick="downloadDocDirect('${e.id}', '${encodeURIComponent(d.name)}')"><i data-lucide="download"></i></button>`}
            `:`
              <span class="tag ${d.st==='wait'?'wait':'late'}">${d.st==='wait'?'Solicitado':'Pendiente'}</span>
              <button class="btn sm" onclick="triggerDocUpload(${d.i})"><i data-lucide="upload"></i>Subir</button>
              <button class="btn sm p" onclick="docSt(${d.i},'ok')">Marcar Listo</button>
            `}
          </div>
        </div>
      `).join('')}
    `}).join('')}
  </div>`;
}

function triggerDocUpload(index){
  const inp=document.createElement('input');
  inp.type='file';
  inp.accept='.pdf,image/*,.doc,.docx';
  inp.onchange=()=>{
    const f=inp.files[0];
    if(!f) return;
    const r=new FileReader();
    r.onload=()=>{
      const d=cur.docs[index];
      d.st='ok';
      d.file=f.name;
      d.size=(f.size/1048576).toFixed(2)+' MB';
      d.date=TODAY;
      d.who='Esteban Mejía';
      d.dataUrl=r.result;
      log(cur,`Documento "${d.name}" cargado (${f.name}).`);
      save();
      renderTab();
      toast('Documento cargado con éxito');
    };
    r.readAsDataURL(f);
  };
  inp.click();
}

function uploadDocQuick(){
  const inp=document.createElement('input');
  inp.type='file';
  inp.accept='.pdf,image/*,.doc,.docx';
  inp.onchange=()=>{
    const f=inp.files[0];
    if(!f) return;
    const r=new FileReader();
    r.onload=()=>{
      cur.docs.push({
        cat:'ADICIONAL',
        name:f.name.replace(/\.[^/.]+$/,""),
        by:'gsd',
        st:'ok',
        file:f.name,
        size:(f.size/1048576).toFixed(2)+' MB',
        date:TODAY,
        who:'Esteban Mejía',
        dataUrl:r.result
      });
      log(cur,`Documento adicional subido: ${f.name}.`);
      save();
      renderTab();
      toast('Documento añadido al expediente');
    };
    r.readAsDataURL(f);
  };
  inp.click();
}

function saveNewDocModal(){
  const name=$('newDocName').value.trim();
  if(!name){ toast('Escribe el nombre del documento'); return; }
  const cat=$('newDocCat').value;
  const by=$('newDocBy').value;
  const fileInput=$('newDocFile');
  const f=fileInput.files[0];
  
  if(f){
    const r=new FileReader();
    r.onload=()=>{
      cur.docs.push({
        cat,name,by,st:'ok',
        file:f.name,
        size:(f.size/1048576).toFixed(2)+' MB',
        date:TODAY,who:'Esteban Mejía',
        dataUrl:r.result
      });
      log(cur,`Nuevo documento registrado: ${name}.`);
      save();closeM('mDocNew');renderTab();toast('Documento guardado');
    };
    r.readAsDataURL(f);
  } else {
    cur.docs.push({cat,name,by,st:'miss',file:'',size:'',date:'',who:'Esteban Mejía'});
    log(cur,`Requisito documental añadido: ${name}.`);
    save();closeM('mDocNew');renderTab();toast('Requisito documental añadido');
  }
}

function docSt(i,st){
  const d=cur.docs[i];
  d.st=st;
  if(st==='ok'){
    d.file=d.name.replace(/ /g,'_')+'.pdf';
    d.size='1.0 MB';
    d.date=TODAY;
    d.who='Esteban Mejía';
    log(cur,`Documento "${d.name}" validado.`);
  } else {
    log(cur,`Documento "${d.name}" solicitado al cliente.`);
  }
  save();renderTab();toast(st==='ok'?'Documento verificado':'Solicitud registrada');
}

// ===== FINANZAS, FACTURACIÓN & RECIBOS MANUALES =====
function finanzas(e,T,b){
  const pag=e.pagos.filter(p=>p.st==='Pagado'&&p.tipo!=='Gasto').reduce((a,p)=>a+p.m,0);
  const gas=e.pagos.filter(p=>p.st==='Pagado'&&p.tipo==='Gasto').reduce((a,p)=>a+p.m,0);
  const pend=Math.max(0,e.honorario-pag);
  const pct=Math.round(pag/e.honorario*100)||0;
  
  b.innerHTML=`
  <div class="kpis" style="grid-template-columns:repeat(4,1fr);margin-bottom:14px">
    <div class="kpi"><div class="l">Honorario contratado</div><div class="v">${e.mon}${fmt(e.honorario)}</div></div>
    <div class="kpi"><div class="l">Total cobrado</div><div class="v" style="color:var(--green)">${e.mon}${fmt(pag)}</div></div>
    <div class="kpi"><div class="l">Gastos / Suplidores</div><div class="v" style="color:var(--amber)">${e.mon}${fmt(gas)}</div></div>
    <div class="kpi ${pend>0?'warn':''}"><div class="l">Saldo pendiente</div><div class="v">${e.mon}${fmt(pend)}</div><div class="bar" style="margin-top:6px"><i style="width:${pct}%"></i></div></div>
  </div>

  <div class="card">
    <div class="ch">
      <h2>Control de Cobros, Facturas y Recibos</h2>
      <button class="btn p" onclick="toggleFinForm()"><i data-lucide="plus"></i>Registrar factura / cobro</button>
    </div>

    <div id="finForm" style="display:none;border-top:1px solid var(--line);padding-top:14px;margin-top:10px;background:var(--bg);padding:14px;border-radius:8px">
      <div class="g2">
        <div class="f"><label>Concepto / Detalle</label><input id="finC" placeholder="Ej: Separación inicial 30%, Honorarios etapa 1..."></div>
        <div class="f"><label>Monto</label><input id="finM" type="number" min="0" placeholder="0.00"></div>
      </div>
      <div class="g3">
        <div class="f"><label>Fecha</label><input id="finD" type="date" value="${TODAY}"></div>
        <div class="f"><label>Tipo de movimiento</label><select id="finT"><option value="Ingreso">Ingreso (Cobro a cliente)</option><option value="Gasto">Gasto (Agrimensor / Trámite / Tasa)</option></select></div>
        <div class="f"><label>Estado</label><select id="finSt"><option value="Pagado">Pagado (Emitir recibo)</option><option value="Pendiente">Pendiente de cobro</option></select></div>
      </div>
      <div class="f"><label>Nota / Comprobante de transferencia</label><input id="finN" placeholder="Ej: Transferencia Banco Popular #48929"></div>
      <div style="display:flex;gap:8px;margin-top:10px">
        <button class="btn p" onclick="saveMovimiento()"><i data-lucide="save"></i>Guardar movimiento</button>
        <button class="btn" onclick="toggleFinForm()">Cancelar</button>
      </div>
    </div>

    <div class="table-responsive" style="margin-top:14px">
      <table>
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Concepto / Referencia</th>
            <th>Tipo</th>
            <th>Monto</th>
            <th>Estado</th>
            <th style="text-align:right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          ${e.pagos.map((p,i)=>`
            <tr>
              <td>${fd(p.d||TODAY)}</td>
              <td>
                <b>${p.c}</b>
                ${p.nota?`<small style="display:block;color:var(--gray)">${p.nota}</small>`:''}
              </td>
              <td><span style="font-size:11px;font-weight:600;color:${p.tipo==='Gasto'?'var(--amber)':'var(--green)'}">${p.tipo||'Ingreso'}</span></td>
              <td style="font-weight:600;color:${p.tipo==='Gasto'?'var(--amber)':'var(--navy)'}">${e.mon}${fmt(p.m)}</td>
              <td><span class="tag ${p.st==='Pagado'?'proc':'wait'}">${p.st}</span></td>
              <td style="text-align:right">
                <div style="display:inline-flex;gap:6px">
                  ${p.st==='Pagado'&&p.tipo!=='Gasto'?`
                    <button class="btn sm" onclick="verRecibo(${i})"><i data-lucide="receipt"></i>Ver Recibo</button>
                  `:''}
                  ${p.st!=='Pagado'?`
                    <button class="btn sm p" onclick="cur.pagos[${i}].st='Pagado';cur.pagos[${i}].d='${TODAY}';log(cur,'Pago confirmado: ${p.c}.');save();renderTab();toast('Pago confirmado')">Confirmar Pago</button>
                  `:''}
                </div>
              </td>
            </tr>
          `).join('')||'<tr><td colspan="6" class="empty" style="text-align:center;padding:18px;color:var(--gray)">Sin movimientos financieros registrados.</td></tr>'}
        </tbody>
      </table>
    </div>
  </div>`;
}

function toggleFinForm(){
  const f=$('finForm');
  if(f) f.style.display=f.style.display==='none'?'block':'none';
  icons();
}

function saveMovimiento(){
  const c=($('finC')||{}).value?.trim();
  const m=parseFloat(($('finM')||{}).value)||0;
  const d=($('finD')||{}).value||TODAY;
  const t=($('finT')||{}).value||'Ingreso';
  const st=($('finSt')||{}).value||'Pagado';
  const n=($('finN')||{}).value?.trim()||'';
  if(!c){ toast('El concepto es obligatorio'); return; }
  if(!m){ toast('Ingrese un monto válido'); return; }
  cur.pagos.push({d,c,m,st,tipo:t,nota:n});
  log(cur,`Registro financiero: ${c} — ${cur.mon}${fmt(m)} (${st}).`);
  save();
  renderTab();
  toast('Movimiento registrado');
}

