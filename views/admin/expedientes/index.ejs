// ===== MODALS: nuevo expediente =====
function openNewExpModal(){
  $('nQuote').innerHTML=quotes.length ? quotes.map(q=>`<option value="${q.ref}">${q.ref} — ${q.cli}</option>`).join('') : '<option value="">(Sin cotizaciones aprobadas)</option>';
  $('nSvc').innerHTML=Object.entries(TPL).map(([k,t])=>`<option value="${k}">${t.nombre}</option>`).join('');
  $('nResp').innerHTML=TEAM.map(n=>`<option>${n}</option>`).join('');
  if (!quotes.length) {
    const rM = document.querySelector('input[name=orig][value="m"]');
    if (rM) { rM.checked = true; rM.dispatchEvent(new Event('change')); }
  } else {
    const rQ = document.querySelector('input[name=orig][value="q"]');
    if (rQ) { rQ.checked = true; rQ.dispatchEvent(new Event('change')); }
  }
  quoteInfo();
  updateNewExpTplInfo();
  openM('mNew');
}
if ($('btnNewExp')) $('btnNewExp').onclick = openNewExpModal;

function updateNewExpTplInfo() {
  const svc = $('nSvc')?.value || 'deslinde';
  const t = TPL[svc] || TPL.deslinde;
  const infoEl = $('nSvcTplInfo');
  if (!infoEl || !t) return;
  const divColor = DIV_COLOR[t.div] || 'var(--navy)';
  const divBg = DIV_BG[t.div] || '#EEF2F5';
  const totalTasks = (t.fases || []).reduce((acc, f) => acc + (f[1] || []).length, 0);
  const totalDocs = (t.docs || []).length;
  
  infoEl.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
      <span style="font-weight:700;color:var(--navy);font-size:12px;">Configuración de la Plantilla:</span>
      <span style="background:${divBg};color:${divColor};padding:2px 8px;border-radius:10px;font-size:10.5px;font-weight:700;">${t.div}</span>
    </div>
    <div style="color:#475569;line-height:1.4;">
      <div>• <b>Flujo inicial:</b> ${t.fases.length} etapas con ${totalTasks} tareas predeterminadas.</div>
      <div>• <b>Requisitos:</b> ${totalDocs} documentos cargados automáticamente al checklist.</div>
      <div>• <b>Plazo y honorario:</b> ${t.plazo} días hábiles · ${t.moneda === 'DOP' ? 'RD$' : 'US$'}${Number(t.honorario||0).toLocaleString('en-US', {minimumFractionDigits:2})}.</div>
    </div>
  `;
  
  if ($('nHon') && t.honorario && (!$('nHon').value || $('nHon').value === 'US$0' || $('nHon').value.startsWith('US$') || $('nHon').value.startsWith('RD$'))) {
    $('nHon').value = `${t.moneda === 'DOP' ? 'RD$' : 'US$'}${Number(t.honorario).toLocaleString('en-US', {minimumFractionDigits:2})}`;
  }
}

// Auto-abrir si la URL tiene ?action=new
if (new URLSearchParams(window.location.search).get('action') === 'new') {
