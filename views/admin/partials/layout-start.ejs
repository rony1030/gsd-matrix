<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — GSD CRM' : 'GSD CRM & Gestión' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.460.0/dist/umd/lucide.min.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body.admin-body {
      font-family: 'Poppins', system-ui, -apple-system, sans-serif !important;
      background: #F9FAFB !important;
      color: #1F2937 !important;
      font-size: 13px !important;
    }
    .admin-topbar-crm {
      background: #ffffff;
      border-bottom: 1px solid #E5E7EB;
      height: 56px;
      display: flex;
      align-items: center;
      padding: 0 1.5rem;
      gap: 16px;
      position: sticky;
      top: 0;
      z-index: 90;
    }
    .crm-switch-tabs {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .crm-switch-tab {
      font-weight: 600;
      font-size: 12px;
      letter-spacing: 0.8px;
      text-decoration: none;
      color: #6B7280;
      transition: color 0.15s ease;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .crm-switch-tab:hover {
      color: #1A3A52;
    }
    .crm-switch-tab.active {
      color: #1A3A52;
      font-weight: 700;
    }
    .crm-search-box {
      flex: 1;
      max-width: 380px;
      position: relative;
    }
    .crm-search-box input {
      width: 100%;
      padding: 7px 12px 7px 34px;
      font-size: 12.5px;
      border: 1px solid #E5E7EB;
      border-radius: 6px;
      background: #F9FAFB;
      color: #1F2937;
      font-family: inherit;
    }
    .crm-search-box input:focus {
      background: #ffffff;
      border-color: #4A9B6F;
      outline: none;
      box-shadow: 0 0 0 3px rgba(74, 155, 111, 0.12);
    }
    .crm-search-box svg {
      position: absolute;
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      color: #9CA3AF;
      width: 15px;
      height: 15px;
    }
    .crm-user-profile {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: #1A3A52;
      text-decoration: none;
    }
    .crm-user-avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #1A3A52;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 11px;
      position: relative;
    }
    .crm-user-avatar::after {
      content: '';
      position: absolute;
      right: -1px;
      bottom: -1px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #4A9B6F;
      border: 1.5px solid #ffffff;
    }
    .side-prod-badge {
      font-size: 10px;
      letter-spacing: 2px;
      color: #4A9B6F;
      font-weight: 700;
      margin-top: 6px;
      text-transform: uppercase;
    }
  </style>
</head>
<body class="admin-body">

<!-- Mobile backdrop overlay -->
<div class="admin-backdrop" id="adminBackdrop"></div>

<!-- Sidebar -->
<aside class="admin-sidebar" id="adminSidebar">
  <div class="sidebar-logo" style="padding:18px 20px 14px;border-bottom:1px solid #E5E7EB;">
    <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
      <a href="/admin" style="display:block;text-decoration:none;">
        <img src="<%= typeof logoUrl !== 'undefined' ? logoUrl : '/img/logo-gsd.png' %>" alt="GSD" style="max-height:34px;max-width:145px;object-fit:contain;display:block;">
        <div class="side-prod-badge">GSD CRM & MATRIZ</div>
      </a>
      <button type="button" class="sidebar-close-btn" id="sidebarCloseBtn" aria-label="Cerrar menú">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <nav class="sidebar-nav" style="padding:10px 0;flex:1;overflow-y:auto;">
    <div class="sidebar-section">PRINCIPAL</div>
    <a href="/admin" class="sidebar-link <%= page === 'dashboard' ? 'active' : '' %>">
      <i data-lucide="layout-grid"></i>
      Dashboard
    </a>
    <a href="/admin/expedientes" class="sidebar-link <%= page === 'expedientes' ? 'active' : '' %>">
      <i data-lucide="folder"></i>
      Expedientes
    </a>
    <a href="/admin/cotizaciones" class="sidebar-link <%= page === 'cotizaciones' ? 'active' : '' %>">
      <i data-lucide="file-text"></i>
      Cotizaciones & Quoter
    </a>
    <a href="/admin/leads" class="sidebar-link <%= page === 'leads' ? 'active' : '' %>">
      <i data-lucide="users"></i>
      Clientes & Leads
    </a>

    <div class="sidebar-section" style="margin-top:10px;">GESTIÓN & BIENES RAÍCES</div>
    <a href="/admin/propiedades" class="sidebar-link <%= page === 'propiedades' ? 'active' : '' %>">
      <i data-lucide="building-2"></i>
      Propiedades
    </a>
    <a href="/admin/blog" class="sidebar-link <%= page === 'blog' ? 'active' : '' %>">
      <i data-lucide="newspaper"></i>
      Blog & SEO
    </a>

    <div class="sidebar-section" style="margin-top:10px;">CONFIGURACIÓN</div>
    <a href="/admin/ajustes" class="sidebar-link <%= (typeof page !== 'undefined' && (page === 'ajustes' || page === 'branding' || page === 'instagram')) ? 'active' : '' %>">
      <i data-lucide="settings"></i>
      Ajustes del Sistema
    </a>

    <div class="sidebar-section" style="margin-top:10px;">PORTALES PÚBLICOS</div>
    <a href="/" target="_blank" class="sidebar-link">
      <i data-lucide="globe"></i>
      Sitio Matriz Web
      <i data-lucide="external-link" style="width:13px;height:13px;margin-left:auto;color:#9ca3af;"></i>
    </a>
    <a href="https://gsd-bienes-raices.vercel.app" target="_blank" class="sidebar-link">
      <i data-lucide="home"></i>
      Portal Real Estate
      <i data-lucide="external-link" style="width:13px;height:13px;margin-left:auto;color:#9ca3af;"></i>
    </a>
  </nav>

  <!-- User Profile at bottom matching Expedientes CRM -->
  <div class="sidebar-footer" style="padding:14px 20px;border-top:1px solid #E5E7EB;background:#ffffff;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:10px;overflow:hidden;">
      <div class="crm-user-avatar">EM</div>
      <div style="line-height:1.2;overflow:hidden;">
        <b style="display:block;font-weight:600;color:#1A3A52;font-size:12px;white-space:nowrap;text-overflow:ellipsis;overflow:hidden;">Esteban Mejía</b>
        <span style="font-size:10.5px;color:#6B7280;display:block;">Abogado / Admin</span>
      </div>
    </div>
    <a href="/admin/logout" title="Cerrar sesión" style="color:#9CA3AF;padding:4px;border-radius:4px;transition:color 0.15s;" onmouseover="this.style.color='#C0392B'" onmouseout="this.style.color='#9CA3AF'">
      <i data-lucide="log-out" style="width:16px;height:16px;"></i>
    </a>
  </div>
</aside>

<!-- Main Area -->
<main class="admin-main">
  <!-- Topbar matching Expedientes CRM style -->
  <div class="admin-topbar-crm">
    <button type="button" class="admin-menu-toggle" id="adminMenuToggle" aria-label="Abrir menú" style="display:none;background:none;border:none;color:#1A3A52;cursor:pointer;padding:4px;">
      <i data-lucide="menu" style="width:20px;height:20px;"></i>
    </button>
    
    <div class="crm-switch-tabs">
      <a href="/admin/cotizaciones" class="crm-switch-tab <%= page === 'cotizaciones' ? 'active' : '' %>">
        GSD QUOTER
      </a>
      <span style="color:#E5E7EB;font-weight:300;">|</span>
      <a href="/admin/expedientes" class="crm-switch-tab <%= page === 'expedientes' ? 'active' : '' %>">
        GSD EXPEDIENTES
      </a>
      <span style="color:#E5E7EB;font-weight:300;">|</span>
      <a href="/admin/propiedades" class="crm-switch-tab <%= page === 'propiedades' ? 'active' : '' %>">
        GSD REAL ESTATE
      </a>
    </div>

    <div style="flex:1;"></div>

    <div class="crm-search-box">
      <i data-lucide="search"></i>
      <input type="text" placeholder="Buscar expediente, cliente, propiedad..." onkeydown="if(event.key==='Enter'){window.location.href='/admin/expedientes?q='+encodeURIComponent(this.value);}">
    </div>

    <% if (page === 'propiedades') { %>
      <a href="/admin/propiedades/nueva" class="btn btn-p" style="background:#4A9B6F;color:#fff;border-color:#4A9B6F;padding:6px 12px;font-size:12px;font-weight:600;border-radius:6px;text-decoration:none;display:inline-flex;align-items:center;gap:6px;">
        <i data-lucide="plus" style="width:15px;height:15px;"></i> Nueva Propiedad
      </a>
    <% } else if (page === 'blog') { %>
      <a href="/admin/blog/nuevo" class="btn btn-p" style="background:#4A9B6F;color:#fff;border-color:#4A9B6F;padding:6px 12px;font-size:12px;font-weight:600;border-radius:6px;text-decoration:none;display:inline-flex;align-items:center;gap:6px;">
        <i data-lucide="plus" style="width:15px;height:15px;"></i> Nuevo Artículo
      </a>
    <% } else if (page === 'cotizaciones') { %>
      <a href="/admin/cotizaciones" class="btn btn-p" style="background:#4A9B6F;color:#fff;border-color:#4A9B6F;padding:6px 12px;font-size:12px;font-weight:600;border-radius:6px;text-decoration:none;display:inline-flex;align-items:center;gap:6px;">
        <i data-lucide="plus" style="width:15px;height:15px;"></i> Nueva Cotización
      </a>
    <% } else { %>
      <a href="/admin/expedientes" class="btn btn-p" style="background:#4A9B6F;color:#fff;border-color:#4A9B6F;padding:6px 12px;font-size:12px;font-weight:600;border-radius:6px;text-decoration:none;display:inline-flex;align-items:center;gap:6px;">
        <i data-lucide="plus" style="width:15px;height:15px;"></i> Nuevo Expediente
      </a>
    <% } %>

    <div class="crm-user-profile">
      <div class="crm-user-avatar">EM</div>
      <span style="font-weight:600;font-size:12px;color:#1A3A52;">Esteban Mejía</span>
    </div>
  </div>

  <div class="admin-content" style="padding:24px 28px;background:#F9FAFB;">
