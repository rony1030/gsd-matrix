<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — GSD Admin' : 'GSD Admin' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">

<!-- Sidebar -->
<aside class="admin-sidebar">
  <div class="sidebar-logo">
    <img src="/img/logo-gsd.png" alt="GSD">
  </div>

  <nav class="sidebar-nav">
    <div class="sidebar-section">Principal</div>
    <a href="/admin" class="sidebar-link <%= page === 'dashboard' ? 'active' : '' %>">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      Dashboard
    </a>

    <div class="sidebar-section">Contenido</div>
    <a href="/admin/propiedades" class="sidebar-link <%= page === 'propiedades' ? 'active' : '' %>">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      Propiedades
    </a>
    <a href="/admin/blog" class="sidebar-link <%= page === 'blog' ? 'active' : '' %>">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
      Blog & SEO
    </a>

    <div class="sidebar-section">CRM</div>
    <a href="/admin/leads" class="sidebar-link <%= page === 'leads' ? 'active' : '' %>">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Leads
    </a>

    <div class="sidebar-section">Sitio</div>
    <a href="/" target="_blank" class="sidebar-link">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      Ver Sitio
    </a>
  </nav>

  <div class="sidebar-footer">
    <a href="/admin/logout">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Cerrar sesión
    </a>
  </div>
</aside>

<!-- Main -->
<main class="admin-main">
  <div class="admin-topbar">
    <h1><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></h1>
    <div style="display:flex;align-items:center;gap:0.75rem;">
      <span style="font-size:0.8rem;color:var(--gris-500);">Admin GSD</span>
      <div style="width:34px;height:34px;border-radius:50%;background:var(--azul);display:flex;align-items:center;justify-content:center;color:white;font-size:0.75rem;font-weight:700;">A</div>
    </div>
  </div>

  <div class="admin-content">
