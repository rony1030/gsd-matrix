<%- include('../../admin/partials/layout-start', { pageTitle: 'Blog & SEO', page: 'blog' }) %>

<div class="table-card">
  <div class="table-card-header">
    <h3>Artículos (<%= posts.length %>)</h3>
    <a href="/admin/blog/nuevo" class="btn-add">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Nuevo Artículo
    </a>
  </div>
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Artículo</th>
          <th>Categoría</th>
          <th>Puntaje SEO</th>
          <th>Estado</th>
          <th>Fecha</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% posts.forEach(p => { %>
        <tr>
          <td>
            <div style="display:flex;align-items:center;gap:10px;">
              <% if (p.imagen_portada) { %>
                <img src="<%= p.imagen_portada %>" style="width:48px;height:36px;border-radius:6px;object-fit:cover;flex-shrink:0;" alt="">
              <% } %>
              <div>
                <strong><%= p.titulo %></strong>
                <div style="font-size:0.75rem;color:var(--gris-500);margin-top:2px;">
                  <code>/<%= p.slug %></code> · <span><%= p.autor || 'GSD' %></span>
                </div>
              </div>
            </div>
          </td>
          <td><span style="font-size:0.8rem;background:#f1f5f9;padding:3px 8px;border-radius:4px;color:#475569;font-weight:500;"><%= p.categoria || 'Inversión' %></span></td>
          <td>
            <% const sc = p.seo_score || 0; %>
            <span class="badge <%= sc >= 80 ? 'badge-green' : sc >= 50 ? 'badge-orange' : 'badge-gray' %>" style="font-weight:700;">
              <%= sc %>/100
            </span>
          </td>
          <td>
            <span class="badge <%= p.estado === 'publicado' ? 'badge-green' : 'badge-gray' %>">
              <%= p.estado %>
            </span>
          </td>
          <td style="color:var(--gris-500);font-size:0.8rem;"><%= p.fecha_publicacion?.substring(0,10) || p.created_at?.substring(0,10) %></td>
          <td>
            <div class="action-btns">
              <% if (p.estado === 'publicado') { %>
              <a href="/blog/<%= p.slug %>" target="_blank" class="btn-icon view" title="Ver publicado">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </a>
              <% } %>
              <a href="/admin/blog/<%= p.id %>/editar" class="btn-icon edit" title="Editar">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </a>
              <form method="POST" action="/admin/blog/<%= p.id %>/eliminar" style="display:inline" onsubmit="return confirm('¿Eliminar este artículo?')">
                <button class="btn-icon delete" type="submit" title="Eliminar">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                </button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
        <% if (posts.length === 0) { %>
        <tr><td colspan="6" style="text-align:center;padding:2.5rem;color:var(--gris-500);">No hay artículos. <a href="/admin/blog/nuevo" style="color:var(--verde)">Crea el primero →</a></td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../admin/partials/layout-end') %>
