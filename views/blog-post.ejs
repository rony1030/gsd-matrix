<%- include('partials/header', { title: post.meta_title || post.titulo + ' — GSD Blog', metaDesc: post.meta_description || '', page: 'blog' }) %>
<div style="padding-top: 76px;"></div>
<% if (post.imagen_portada) { %>
<div style="width:100%;height:380px;overflow:hidden;">
  <img src="<%= post.imagen_portada %>" alt="<%= post.titulo %>" style="width:100%;height:100%;object-fit:cover;">
</div>
<% } %>
<article style="max-width:800px;margin:0 auto;padding:4rem 2rem;">
  <div style="margin-bottom:2rem;">
    <a href="/blog" style="color:var(--verde);font-size:0.875rem;display:flex;align-items:center;gap:0.4rem;">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      Volver al Blog
    </a>
  </div>
  <span class="eyebrow"><%= post.fecha_publicacion?.substring(0,10) || '' %> · <%= post.autor || 'GSD' %></span>
  <h1 style="font-size:clamp(2rem,4vw,3rem);color:var(--azul);margin:1rem 0 2rem;line-height:1.2;"><%= post.titulo %></h1>
  <div style="color:var(--gris-700);line-height:1.85;font-size:1.05rem;" class="blog-content">
    <%- post.html %>
  </div>
</article>
<style>
.blog-content h1,.blog-content h2,.blog-content h3{color:var(--azul);margin:2rem 0 1rem;font-family:'Playfair Display',serif;}
.blog-content p{margin-bottom:1.25rem;}
.blog-content ul,.blog-content ol{padding-left:1.5rem;margin-bottom:1.25rem;}
.blog-content li{margin-bottom:0.4rem;}
.blog-content strong{color:var(--azul);}
.blog-content blockquote{border-left:3px solid var(--verde);padding:1rem 1.5rem;background:var(--gris-100);border-radius:0 8px 8px 0;margin:1.5rem 0;}
</style>
<%- include('partials/footer') %>
